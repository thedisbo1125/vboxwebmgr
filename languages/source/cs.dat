s:22:"Řadič USB 3.0 (xHCI)";}s:18:"USB Device Filters";a:1:{s:11:"translation";s:22:"Filtry USB zařízení";}}}s:33:"UIMachineSettingsUSBFilterDetails";a:1:{s:8:"messages";a:13:{s:3:"Any";a:1:{s:11:"translation";s:8:"Žádný";}s:13:"Manufacturer:";a:1:{s:11:"translation";s:9:"Výrobce:";}s:5:"Name:";a:1:{s:11:"translation";s:7:"Jméno:";}s:2:"No";a:1:{s:11:"translation";s:2:"Ne";}s:5:"Port:";a:1:{s:11:"translation";s:10:"Přístav:";}s:11:"Product ID:";a:1:{s:11:"translation";s:12:"ID produktu:";}s:8:"Product:";a:1:{s:11:"translation";s:8:"Produkt:";}s:7:"Remote:";a:1:{s:11:"translation";s:11:"Vzdálený:";}s:9:"Revision:";a:1:{s:11:"translation";s:7:"Revize:";}s:11:"Serial No.:";a:1:{s:11:"translation";s:18:"Sériové číslo:";}s:18:"USB Filter Details";a:1:{s:11:"translation";s:18:"Detaily USB filtru";}s:10:"Vendor ID:";a:1:{s:11:"translation";s:14:"ID dodavatele:";}s:3:"Yes";a:1:{s:11:"translation";s:3:"Ano";}}}s:15:"UIMessageCenter";a:1:{s:8:"messages";a:56:{s:111:"<b>Note:</b> this interface may be in use by one or more virtual network adapters belonging to one of your VMs.";a:1:{s:11:"translation";s:173:"<b>Poznámka:</b> Toto rozhraní může být používáno jedním nebo více virtuálními síťovými adaptéry patřícími k jednomu z vašich virtuálních počítačů.";}s:70:"<nobr>%1</nobr><br><nobr>%2 since %3</nobr><br><nobr>Session %4</nobr>";a:1:{s:11:"translation";s:66:"<nobr>%1</nobr><br><nobr>%2 od %3</nobr><br><nobr>Relace %4</nobr>";}s:75:"A file named <b>%1</b> already exists. Are you sure you want to replace it?";a:1:{s:11:"translation";s:69:"Soubor s názvem <b>%1</b> již existuje. Opravdu ho chcete nahradit?";}s:13:"ACPI Shutdown";a:1:{s:11:"translation";s:13:"Vypnutí ACPI";}s:179:"After it is removed, these adapters will no longer be usable until you correct their settings by either choosing a different interface name or a different adapter attachment type.";a:1:{s:11:"translation";s:173:"Po jeho odebrání nebudou tyto adaptéry použitelné, dokud neopravíte jejich nastavení buď výběrem jiného názvu rozhraní, nebo jiného typu připojení adaptéru.";}s:83:"Are you sure you want to discard the saved state of the following virtual machines?";a:1:{s:11:"translation";s:82:"Opravdu chcete zahodit uložený stav následujících virtuálních počítačů?";}s:4:"Back";a:1:{s:11:"translation";s:5:"Zpět";}s:6:"Cancel";a:1:{s:11:"translation";s:7:"Zrušit";}s:87:"Cannot create the machine folder <b>%1</b> in the parent folder <nobr><b>%2</b>.</nobr>";a:1:{s:11:"translation";s:92:"Nelze vytvořit složku počítače <b>%1</b> v nadřazené složce <nobr></b>%2</b>.</nobr>";}s:11:"Choose disk";a:1:{s:11:"translation";s:12:"Vyberte disk";}s:20:"Choose existing disk";a:1:{s:11:"translation";s:25:"Vyberte existující disk";}s:5:"Close";a:1:{s:11:"translation";s:8:"Zavřít";}s:8:"Continue";a:1:{s:11:"translation";s:11:"Pokračovat";}s:15:"Create new disk";a:1:{s:11:"translation";s:20:"Vytvořit nový disk";}s:6:"Delete";a:1:{s:11:"translation";s:6:"Smazat";}s:16:"Delete all files";a:1:{s:11:"translation";s:23:"Smazat všechny soubory";}s:93:"Deleting this host-only network will remove the host-only interface this network is based on.";a:1:{s:11:"translation";s:135:"Smazáním této sítě typu „pouze hostitel“ se odstraní rozhraní typu „pouze hostitel“, na kterém je tato síť založena.";}s:7:"Details";a:1:{s:11:"translation";s:7:"Detaily";}s:7:"Discard";a:1:{s:11:"translation";s:8:"Vyřadit";}s:63:"Do you really want to power off the following virtual machines?";a:1:{s:11:"translation";s:62:"Opravdu chcete vypnout následující virtuální počítače?";}s:59:"Do you really want to reset the following virtual machines?";a:1:{s:11:"translation";s:64:"Opravdu chcete resetovat následující virtuální počítače?";}s:85:"Do you really want to send an ACPI shutdown signal to the following virtual machines?";a:1:{s:11:"translation";s:88:"Opravdu chcete odeslat signál vypnutí ACPI následujícím virtuálním počítačům?";}s:79:"Do you want to remove the (host-only network) interface <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:81:"Chcete odstranit rozhraní (pouze pro hostitelskou síť) <nobr><b>%1</b>?</nobr>";}s:61:"Do you want to remove the NAT network <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:50:"Chcete odstranit síť NAT <nobr><b>%1</b>?</nobr>";}s:124:"Doing this will also remove the files containing the machine's virtual hard disks if they are not in use by another machine.";a:1:{s:11:"translation";s:124:"Tímto se také odstraní soubory obsahující virtuální pevné disky počítače, pokud je jiný počítač nepoužívá.";}s:82:"Failed to send the ACPI Power Button press event to the virtual machine <b>%1</b>.";a:1:{s:11:"translation";s:90:"Nepodařilo se poslat události stisku ACPI vypínacího tlačítka počítači <b>%1</b>.";}s:122:"Failed to update Guest Additions. The Guest Additions installation image will be mounted to provide a manual installation.";a:1:{s:11:"translation";s:123:"Aktualizace doplňků pro hosty se nezdařilo. Pro ruční instalaci bude připojen instalační obraz doplňků pro hosty.";}s:7:"Go Back";a:1:{s:11:"translation";s:5:"Zpět";}s:230:"If this network is in use by one or more virtual machine network adapters these adapters will no longer be usable until you correct their settings by either choosing a different network name or a different adapter attachment type.";a:1:{s:11:"translation";s:255:"Pokud tuto síť používá jeden nebo více síťových adaptérů virtuálních počítačů, nebudou tyto adaptéry nadále použitelné, dokud neopravíte jejich nastavení buď výběrem jiného názvu sítě, nebo jiného typu připojení adaptéru.";}s:4:"Keep";a:1:{s:11:"translation";s:8:"Ponechat";}s:12:"Keep changes";a:1:{s:11:"translation";s:15:"Zachovat změny";}s:11:"Leave empty";a:1:{s:11:"translation";s:16:"Nechte prázdné";}s:4:"Next";a:1:{s:11:"translation";s:7:"Další";}s:2:"No";a:1:{s:11:"translation";s:2:"Ne";}s:2:"OK";a:1:{s:11:"translation";s:2:"OK";}s:7:"Release";a:1:{s:11:"translation";s:7:"Uvolnit";}s:15:"Reload settings";a:1:{s:11:"translation";s:25:"Znovu načíst nastavení";}s:6:"Remove";a:1:{s:11:"translation";s:9:"Odstranit";}s:11:"Remove only";a:1:{s:11:"translation";s:15:"Pouze odstranit";}s:41:"Replacing it will overwrite its contents.";a:1:{s:11:"translation";s:42:"Jeho nahrazením se přepíše jeho obsah.";}s:7:"Restore";a:1:{s:11:"translation";s:7:"Obnovit";}s:185:"The VM failed to boot. This is possibly caused by not having an operating system installed or a misconfigured boot order. Maybe picking a guest OS install DVD will resolve the situation";a:1:{s:11:"translation";s:283:"Virtuální počítač se nepodařilo spustit. To je pravděpodobně způsobeno tím, že není nainstalován operační systém nebo je nesprávně nakonfigurováno pořadí spouštění. Možná by situaci vyřešilo výběr instalačního DVD s hostujícím operačním systémem.";}s:62:"The machine settings were changed while you were editing them.";a:1:{s:11:"translation";s:48:"Nastavení stroje bylo změněno během úpravy.";}s:67:"This folder already exists and possibly belongs to another machine.";a:1:{s:11:"translation";s:75:"Tato složka již existuje a pravděpodobně patří k jinému počítači.";}s:118:"This operation is equivalent to resetting or powering off the machine without doing a proper shutdown of the guest OS.";a:1:{s:11:"translation";s:140:"Tato operace je ekvivalentní resetování nebo vypnutí počítače bez provedení řádného vypnutí hostujícího operačního systému.";}s:78:"This will cause any unsaved data in applications running inside it to be lost.";a:1:{s:11:"translation";s:83:"Tím dojde ke ztrátě všech neuložených dat v aplikacích spuštěných v něm.";}s:96:"Would you like to choose a virtual CD/DVD disk to put in the drive or to leave it empty for now?";a:1:{s:11:"translation";s:113:"Chcete si vybrat virtuální CD/DVD disk, který chcete vložit do mechaniky, nebo ji prozatím nechat prázdnou?";}s:95:"Would you like to create a new, empty file to hold the disk contents or select an existing one?";a:1:{s:11:"translation";s:101:"Chcete vytvořit nový, prázdný soubor pro uložení obsahu disku, nebo vybrat existující soubor?";}s:94:"Would you like to delete the files containing the virtual machine from your hard disk as well?";a:1:{s:11:"translation";s:77:"Chcete z pevného disku smazat i soubory obsahující virtuální počítač?";}s:74:"Would you like to reload the changed settings or to keep your own changes?";a:1:{s:11:"translation";s:78:"Chcete znovu načíst změněná nastavení, nebo si zachovat vlastní změny?";}s:3:"Yes";a:1:{s:11:"translation";s:3:"Ano";}s:64:"You are about to add a new CD/DVD drive to controller <b>%1</b>.";a:1:{s:11:"translation";s:65:"Chystáte se přidat novou mechaniku CD/DVD k řadiči <b>%1</b>.";}s:65:"You are about to add a virtual hard disk to controller <b>%1</b>.";a:1:{s:11:"translation";s:66:"Chystáte se přidat virtuální pevný disk k řadiči <b>%1</b>.";}s:262:"You are about to create a new virtual machine without a hard disk. You will not be able to install an operating system on the machine until you add one. In the mean time you will only be able to start the machine using a virtual optical disk or from the network.";a:1:{s:11:"translation";s:262:"Vytváříte nový virtuální počítač bez pevného disku. Pokud do něj nějaký pevný disk nepřidáte, nebude možné nainstalovat operační systém. Bude možné spustit virtuální počítač pouze pomocí virtuálního optického disku nebo ze sítě.";}s:77:"You are about to remove the following virtual machines from the machine list:";a:1:{s:11:"translation";s:84:"Chystáte se odebrat následující virtuální počítače ze seznamu počítačů:";}s:43:"You currently have unsaved setting changes.";a:1:{s:11:"translation";s:49:"Momentálně máte neuložené změny nastavení.";}}}s:16:"UIProgressDialog";a:1:{s:8:"messages";a:1:{s:6:"Cancel";a:1:{s:11:"translation";s:7:"Zrušit";}}}s:17:"UISnapshotDetails";a:1:{s:8:"messages";a:39:{s:11:"%1 since %2";a:1:{s:11:"translation";s:8:"%1 od %2";}s:10:"%n day ago";a:1:{s:11:"translation";s:13:"Před %n dnem";}s:11:"%n days ago";a:1:{s:11:"translation";s:12:"Před %n dny";}s:11:"%n hour ago";a:1:{s:11:"translation";s:16:"Před %n hodinou";}s:12:"%n hours ago";a:1:{s:11:"translation";s:17:"Před %n hodinami";}s:13:"%n minute ago";a:1:{s:11:"translation";s:16:"Před %n minutou";}s:14:"%n minutes ago";a:1:{s:11:"translation";s:17:"Před %n minutami";}s:14:"%n seconds ago";a:1:{s:11:"translation";s:18:"Před %n sekundami";}s:64:"Are you sure you want to delete the selected snapshot <b>%1</b>?";a:1:{s:11:"translation";s:49:"Opravdu chcete smazat vybraný snímek <b>%1</b>?";}s:65:"Are you sure you want to restore snapshot <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:54:"Opravdu chcete obnovit snímek <nobr><b>%1</b></nobr>?";}s:45:"Automatically start the machine after restore";a:1:{s:11:"translation";s:49:"Automatické spuštění počítače po obnovení";}s:46:"Create a snapshot of the current machine state";a:1:{s:11:"translation";s:62:"Vytvoří snímek z aktuální stavu virtuálního počítače";}s:13:"Current State";a:1:{s:11:"translation";s:15:"Aktuální stav";}s:23:"Current State (changed)";a:1:{s:11:"translation";s:27:"Aktuální stav (změněno)";}s:15:"Delete Snapshot";a:1:{s:11:"translation";s:14:"Smazat snímek";}s:212:"Deleting the snapshot will cause the state information saved in it to be lost, and storage data spread over several image files that VirtualBox has created together with the snapshot will be merged into one file.";a:1:{s:11:"translation";s:230:"Smazáním snímku se ztratí informace o stavu, které jsou v něm uložené, a úložná data rozložená do několika obrazových souborů, které VirtualBox vytvořil společně se snímkem, budou sloučena do jednoho souboru.";}s:12:"Description:";a:1:{s:11:"translation";s:6:"Popis:";}s:18:"Details of %1 (%2)";a:1:{s:11:"translation";s:15:"Detaily %1 (%2)";}s:8:"Details:";a:1:{s:11:"translation";s:8:"Detaily:";}s:89:"If you do not do this the current state will be permanently lost. Do you wish to proceed?";a:1:{s:11:"translation";s:59:"Pokud tak neučiníte, aktuální stav bude trvale ztracen.";}s:5:"Name:";a:1:{s:11:"translation";s:7:"Jméno:";}s:24:"Power on virtual machine";a:1:{s:11:"translation";s:34:"Zapnutí virtuálního počítače";}s:16:"Restore Snapshot";a:1:{s:11:"translation";s:15:"Obnovit snímek";}s:12:"Show Details";a:1:{s:11:"translation";s:16:"Zobrazit detaily";}s:11:"Snapshot %1";a:1:{s:11:"translation";s:10:"Snímek %1";}s:20:"Snapshot Description";a:1:{s:11:"translation";s:13:"Popis snímku";}s:13:"Snapshot Name";a:1:{s:11:"translation";s:14:"Název snímku";}s:32:"Take Snapshot of Virtual Machine";a:1:{s:11:"translation";s:45:"Vytvoření snímku virtuálního počítače";}s:52:"Take a snapshot of the current virtual machine state";a:1:{s:11:"translation";s:60:"Sejmout snímek aktuálního stavu virtuálního počítače";}s:11:"Taken at %1";a:1:{s:11:"translation";s:15:"Pořízeno v %1";}s:11:"Taken on %1";a:1:{s:11:"translation";s:17:"Pořízeno dne %1";}s:6:"Taken:";a:1:{s:11:"translation";s:9:"Získán:";}s:71:"The current state differs from the state stored in the current snapshot";a:1:{s:11:"translation";s:68:"Aktuální stav se liší od stavu uloženého v aktuálním snímku";}s:74:"The current state is identical to the state stored in the current snapshot";a:1:{s:11:"translation";s:69:"Aktuální stav se shoduje se stavem uloženým v aktuálním snímku";}s:87:"This can be a lengthy process, and the information in the snapshot cannot be recovered.";a:1:{s:11:"translation";s:70:"To může být zdlouhavý proces a informace ve snímku nelze obnovit.";}s:57:"You are about to restore snapshot <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:52:"Chystáte se obnovit snímek <nobr><b>%1</b></nobr>.";}s:102:"You can create a snapshot of the current state of the virtual machine first by checking the box below.";a:1:{s:11:"translation";s:111:"Nejprve můžete vytvořit snímek aktuálního stavu virtuálního počítače zaškrtnutím políčka níže.";}s:7:"offline";a:1:{s:11:"translation";s:7:"offline";}s:6:"online";a:1:{s:11:"translation";s:6:"online";}}}s:7:"UIUsers";a:1:{s:8:"messages";a:16:{s:8:"Add User";a:1:{s:11:"translation";s:18:"Přidat uživatele";}s:10:"Admin User";a:1:{s:11:"translation";s:8:"Správce";}s:20:"Can administer users";a:1:{s:11:"translation";s:46:"Může spravovat účty ostatních uživatelů";}s:15:"Change Password";a:1:{s:11:"translation";s:13:"Změnit heslo";}s:9:"Edit User";a:1:{s:11:"translation";s:18:"Upravit uživatele";}s:29:"Invalid username or password.";a:1:{s:11:"translation";s:42:"Neplatné uživatelské jméno nebo heslo.";}s:6:"Log in";a:1:{s:11:"translation";s:11:"Přihlásit";}s:12:"New Password";a:1:{s:11:"translation";s:11:"Nové heslo";}s:12:"Old Password";a:1:{s:11:"translation";s:15:"Původní heslo";}s:8:"Password";a:1:{s:11:"translation";s:5:"Heslo";}s:11:"Remove User";a:1:{s:11:"translation";s:18:"Odebrat uživatele";}s:6:"Retype";a:1:{s:11:"translation";s:36:"Zopakování zadání (pro kontrolu)";}s:41:"The password you have entered is invalid.";a:1:{s:11:"translation";s:28:"Zadané heslo není platné.";}s:44:"The passwords you have entered do not match.";a:1:{s:11:"translation";s:49:"Zadání hesla se neshodují – zkuste to znovu.";}s:8:"Username";a:1:{s:11:"translation";s:20:"Uživatelské jméno";}s:5:"Users";a:1:{s:11:"translation";s:11:"Uživatelé";}}}s:11:"UIVMDesktop";a:1:{s:8:"messages";a:5:{s:7:"Console";a:1:{s:11:"translation";s:7:"Konzole";}s:7:"Details";a:1:{s:11:"translation";s:7:"Detaily";}s:13:"Host Reources";a:1:{s:11:"translation";s:19:"Hostitelské zdroje";}s:11:"Loading ...";a:1:{s:11:"translation";s:15:"Načítání…";}s:9:"Snapshots";a:1:{s:11:"translation";s:7:"Snímky";}}}s:13:"UIVMLogViewer";a:1:{s:8:"messages";a:2:{s:26:"%1 - VirtualBox Log Viewer";a:1:{s:11:"translation";s:38:"%1 - Prohlížeč záznamu VirtualBoxu";}s:100:"No log files found. Press the <b>Refresh</b> button to rescan the log folder <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:150:"Nebyly nalezeny žádné soubory protokolu. Stiskněte tlačítko <b>Obnovit</b> pro opětovné prohledání složky protokolu <nobr><b>%1</b></nobr>.";}}}s:17:"UIVMPreviewWindow";a:1:{s:8:"messages";a:1:{s:18:"Open in new window";a:1:{s:11:"translation";s:24:"Otevřít v novém okně";}}}s:21:"UIVirtualMediaManager";a:1:{s:8:"messages";a:61:{s:7:"Actions";a:1:{s:11:"translation";s:4:"Akce";}s:11:"Actual Size";a:1:{s:11:"translation";s:19:"Skutečná velikost";}s:3:"Add";a:1:{s:11:"translation";s:7:"Přidat";}s:9:"Add iSCSI";a:1:{s:11:"translation";s:13:"Přidat iSCSI";}s:53:"Are you sure you want to release the disk image file:";a:1:{s:11:"translation";s:46:"Opravdu chcete uvolnit soubor s obrazem disku:";}s:91:"Are you sure you want to remove the %1 <nobr><b>%2</b></nobr> from the list of known media?";a:1:{s:11:"translation";s:80:"Opravdu chcete odstranit %1 <nobr><b>%2</b></nobr> ze seznamu známých médií?";}s:12:"Attached to:";a:1:{s:11:"translation";s:12:"Připojen k:";}s:19:"Choose medium type:";a:1:{s:11:"translation";s:22:"Vyberte Střední typ:";}s:7:"Copy...";a:1:{s:11:"translation";s:8:"Kopie...";}s:12:"Description:";a:1:{s:11:"translation";s:6:"Popis:";}s:87:"Do you want to delete the storage unit of the virtual hard disk <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:85:"Chcete smazat úložnou jednotku virtuálního pevného disku <nobr><b>%1</b></nobr>?";}s:7:"Encoded";a:1:{s:11:"translation";s:10:"Kódované";}s:12:"Floppy disks";a:1:{s:11:"translation";s:7:"Diskety";}s:7:"Format:";a:1:{s:11:"translation";s:8:"Formát:";}s:10:"Hard disks";a:1:{s:11:"translation";s:12:"Pevné disky";}s:79:"Hard drive has children, <b>Writethrough</b> and <b>Shareable</b> not available";a:1:{s:11:"translation";s:104:"Pevný disk má podřízené disky, funkce <b>Propisování</b> a <b>Shařitelné</b> nejsou k dispozici";}s:86:"Hard drive is attached to a VM, <b>Immutable</b> and <b>Multi-attach</b> not available";a:1:{s:11:"translation";s:133:"Pevný disk je připojen k virtuálnímu počítači, funkce <b>Neměnný</b> a <b>Vícenásobné připojení</b> nejsou k dispozici.";}s:53:"Hard drive is dynamic, <b>Shareable</b> not available";a:1:{s:11:"translation";s:64:"Pevný disk je dynamický, <b>Sdílitelný</b> není k dispozici";}s:128:"If you select <b>Delete</b> then the specified storage unit will be permanently deleted. This operation <b>cannot be undone</b>.";a:1:{s:11:"translation";s:128:"Pokud vyberete možnost <b>Smazat</b>, bude zadaná úložná jednotka trvale smazána. Tuto operaci <b>nelze vrátit zpět</b>.";}s:215:"If you select <b>Keep</b> then the hard disk will be only removed from the list of known hard disks, but the storage unit will be left untouched which makes it possible to add this hard disk to the list later again.";a:1:{s:11:"translation";s:223:"Pokud vyberete možnost <b>Ponechat</b>, pevný disk bude pouze odstraněn ze seznamu známých pevných disků, ale úložná jednotka zůstane nedotčena, což umožní později tento pevný disk do seznamu znovu přidat.";}s:9:"Immutable";a:1:{s:11:"translation";s:9:"Neměnný";}s:19:"Internal Networking";a:1:{s:11:"translation";s:15:"Interní sítě";}s:3:"LUN";a:1:{s:11:"translation";s:3:"LUN";}s:9:"Location:";a:1:{s:11:"translation";s:12:"Umístění:";}s:18:"Medium attributes:";a:1:{s:11:"translation";s:16:"Atributy média:";}s:99:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to copy medium.";a:1:{s:11:"translation";s:152:"Médium je připojeno k virtuálnímu počítači, který je ve stavu „Spuštěno“, „Pozastaveno“ nebo „Uloženo“. Médium nelze kopírovat.";}s:102:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to release medium.";a:1:{s:11:"translation";s:149:"Médium je připojeno k virtuálnímu počítači, který je ve stavu „Spuštěno“, „Pozastaveno“ nebo „Uloženo“. Médium nelze uvolnit.";}s:24:"Modify medium attributes";a:1:{s:11:"translation";s:23:"Změna atributů média";}s:9:"Modify...";a:1:{s:11:"translation";s:11:"Modifikovat";}s:12:"Multi-Attach";a:1:{s:11:"translation";s:26:"Vícenásobné připojení";}s:11:"MultiAttach";a:1:{s:11:"translation";s:15:"Víceúčelový";}s:4:"Name";a:1:{s:11:"translation";s:6:"Jméno";}s:3:"New";a:1:{s:11:"translation";s:5:"Nový";}s:6:"Normal";a:1:{s:11:"translation";s:10:"Normální";}s:113:"Note that the storage unit of this medium will not be deleted and that it will be possible to use it later again.";a:1:{s:11:"translation";s:116:"Upozorňujeme, že paměťová jednotka tohoto média nebude smazána a že ji bude možné později znovu použít.";}s:13:"Optical disks";a:1:{s:11:"translation";s:14:"Optické disky";}s:8:"Password";a:1:{s:11:"translation";s:5:"Heslo";}s:95:"Please choose one of the following modes and press <b>%2</b> to proceed or <b>%3</b> otherwise.";a:1:{s:11:"translation";s:115:"Vyberte si jeden z následujících režimů a stiskněte <b>%2</b> pro pokračování, jinak stiskněte <b>%3</b>.";}s:4:"Port";a:1:{s:11:"translation";s:9:"Přístav";}s:8:"Readonly";a:1:{s:11:"translation";s:17:"Pouze pro čtení";}s:7:"Refresh";a:1:{s:11:"translation";s:12:"Aktualizovat";}s:7:"Release";a:1:{s:11:"translation";s:7:"Uvolnit";}s:6:"Remove";a:1:{s:11:"translation";s:9:"Odstranit";}s:12:"Rename File:";a:1:{s:11:"translation";s:20:"Přejmenovat soubor:";}s:6:"Select";a:1:{s:11:"translation";s:6:"Vybrat";}s:6:"Server";a:1:{s:11:"translation";s:6:"Server";}s:9:"Shareable";a:1:{s:11:"translation";s:12:"Sdílitelné";}s:4:"Size";a:1:{s:11:"translation";s:8:"Velikost";}s:16:"Storage details:";a:1:{s:11:"translation";s:22:"Detaily o umístění:";}s:6:"Target";a:1:{s:11:"translation";s:4:"Cíl";}s:69:"This will detach it from the following virtual machine(s): <b>%2</b>.";a:1:{s:11:"translation";s:74:"Tím se odpojí od následujících virtuálních počítačů: <b>%2</b>.";}s:5:"Type:";a:1:{s:11:"translation";s:4:"Typ:";}s:5:"UUID:";a:1:{s:11:"translation";s:5:"UUID:";}s:8:"Username";a:1:{s:11:"translation";s:20:"Uživatelské jméno";}s:64:"VM hard drive is attached to is running, cannot modify disk type";a:1:{s:11:"translation";s:90:"Pevný disk virtuálního počítače je připojen k serveru, ale nelze změnit typ disku.";}s:21:"Virtual Media Manager";a:1:{s:11:"translation";s:30:"Správce virtuálních médií";}s:12:"Virtual Size";a:1:{s:11:"translation";s:20:"Virtuální velikost";}s:7:"Warning";a:1:{s:11:"translation";s:10:"Varování";}s:8:"Warnings";a:1:{s:11:"translation";s:10:"Varování";}s:12:"Writethrough";a:1:{s:11:"translation";s:13:"Propisování";}s:70:"You are about to change the settings of the disk image file <b>%1</b>.";a:1:{s:11:"translation";s:66:"Chystáte se změnit nastavení souboru s obrazem disku <b>%1</b>.";}}}s:8:"UIWizard";a:1:{s:8:"messages";a:2:{s:11:"Expert Mode";a:1:{s:11:"translation";s:16:"Expertní režim";}s:11:"Guided Mode";a:1:{s:11:"translation";s:18:"Průvodce režimem";}}}s:15:"UIWizardCloneVM";a:1:{s:8:"messages";a:31:{s:8:"%1 Clone";a:1:{s:11:"translation";s:7:"Klon %1";}s:5:"Clone";a:1:{s:11:"translation";s:10:"Naklonovat";}s:13:"Clone Options";a:1:{s:11:"translation";s:21:"Možnosti klonování";}s:21:"Clone Virtual Machine";a:1:{s:11:"translation";s:37:"Klonování virtuálního počítače";}s:10:"Clone type";a:1:{s:11:"translation";s:9:"Typ klonu";}s:20:"Cloned Machine Name:";a:1:{s:11:"translation";s:32:"Název klonovaného počítače:";}s:21:"Current machine state";a:1:{s:11:"translation";s:27:"Aktuální stav počítače";}s:28:"Current snapshot tree branch";a:1:{s:11:"translation";s:33:"Aktuální větev stromu snímků";}s:10:"Everything";a:1:{s:11:"translation";s:8:"Všechno";}s:10:"Full Clone";a:1:{s:11:"translation";s:10:"Plný klon";}s:51:"Generate new MAC addresses for all network adapters";a:1:{s:11:"translation";s:63:"Generování nových MAC adres pro všechny síťové adaptéry";}s:142:"If you choose <b>Current machine state</b>, the new machine will reflect the current state of the original machine and will have no snapshots.";a:1:{s:11:"translation";s:154:"Pokud zvolíte <b>Aktuální stav počítače</b>, nový počítač bude odrážet aktuální stav původního počítače a nebude mít žádné snímky.";}s:246:"If you choose <b>Current snapshot tree branch</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the tree branch starting at the current state in the original machine.";a:1:{s:11:"translation";s:268:"Pokud zvolíte možnost <b>Aktuální větev stromu snímků</b>, nový počítač bude odrážet aktuální stav původního počítače a bude mít odpovídající snímky pro všechny snímky ve větvi stromu, počínaje aktuálním stavem v původním počítači.";}s:179:"If you choose <b>Everything</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the original machine.";a:1:{s:11:"translation";s:182:"Pokud zvolíte <b>Vše</b>, nový počítač bude odrážet aktuální stav původního počítače a bude mít odpovídající snímky pro všechny snímky v původním počítači.";}s:135:"If you choose <b>Full clone</b>, an exact copy (including all virtual hard disk files) of the original virtual machine will be created.";a:1:{s:11:"translation";s:170:"Pokud zvolíte možnost <b>Úplný klon</b>, bude vytvořena přesná kopie (včetně všech souborů virtuálního pevného disku) původního virtuálního počítače.";}s:279:"If you choose <b>Linked clone</b>, a new machine will be created, but the virtual hard disk files will be tied to the virtual hard disk files of original machine and you will not be able to move the new virtual machine to a different computer without moving the original as well.";a:1:{s:11:"translation";s:308:"Pokud zvolíte možnost <b>Propojený klon</b>, bude vytvořen nový počítač, ale soubory virtuálního pevného disku budou propojeny se soubory virtuálního pevného disku původního počítače a nebudete moci nový virtuální počítač přesunout na jiný počítač bez přesunutí i původního.";}s:136:"If you create a <b>Linked clone</b>, then a new snapshot will be created in the original virtual machine as part of the cloning process.";a:1:{s:11:"translation";s:138:"Pokud vytvoříte <b>propojený klon</b>, bude v rámci procesu klonování vytvořen nový snímek v původním virtuálním počítači.";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:51:"Zahrnout všechny MAC adresy síťových adaptérů";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:52:"Zahrnout pouze MAC adresy síťových adaptérů NAT";}s:15:"Keep Disk Names";a:1:{s:11:"translation";s:22:"Zachovat názvy disků";}s:19:"Keep Hardware UUIDs";a:1:{s:11:"translation";s:25:"Zachovat hardwarové UUID";}s:25:"Linked Base for %1 and %2";a:1:{s:11:"translation";s:28:"Propojená báze pro %1 a %2";}s:12:"Linked Clone";a:1:{s:11:"translation";s:15:"Propojený klon";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:23:"Zásady pro MAC adresy:";}s:16:"New machine name";a:1:{s:11:"translation";s:24:"Nový název počítače";}s:49:"Please choose a name for the new virtual machine.";a:1:{s:11:"translation";s:55:"Zvolte prosím název pro nový virtuální počítač.";}s:51:"Please choose the type of clone you wish to create.";a:1:{s:11:"translation";s:54:"Vyberte si prosím typ klonu, který chcete vytvořit.";}s:81:"Please choose which parts of the snapshot tree should be cloned with the machine.";a:1:{s:11:"translation";s:85:"Vyberte prosím, které části stromu snímků mají být klonovány s počítačem.";}s:9:"Snapshots";a:1:{s:11:"translation";s:7:"Snímky";}s:57:"The new machine will be a clone of the machine <b>%1</b>.";a:1:{s:11:"translation";s:51:"Nový počítač bude klonem počítače <b>%1</b>.";}s:9:"undefined";a:1:{s:11:"translation";s:13:"nedefinovaný";}}}s:14:"UIWizardCopyVD";a:1:{s:8:"messages";a:19:{s:7:"%1_copy";a:1:{s:11:"translation";s:8:"%1_kopie";}s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:235:"<b>Dynamicky alokovaný</b> soubor na pevném disku bude využívat místo na fyzickém pevném disku pouze tehdy, když se zaplní (do maximální <b>fixní velikosti</b>), ačkoli se po uvolnění místa automaticky znovu nezmenší.";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:159:"Vytvoření souboru pevného disku s pevnou velikostí <b>pevné velikosti</b> může na některých systémech trvat déle, ale často se používá rychleji.";}s:42:"Choose a virtual hard disk file to copy...";a:1:{s:11:"translation";s:47:"Vyberte soubor s virtuálním pevným diskem...";}s:43:"Choose a virtual hard drive file to copy...";a:1:{s:11:"translation";s:47:"Vyberte soubor s virtuálním pevným diskem...";}s:4:"Copy";a:1:{s:11:"translation";s:10:"Kopírovat";}s:22:"Copy Virtual Hard Disk";a:1:{s:11:"translation";s:42:"Kopírování virtuálního pevného disku";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:20:"Dynamicky alokované";}s:10:"Fixed size";a:1:{s:11:"translation";s:15:"Pevná velikost";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:28:"Typ souboru s pevným diskem";}s:17:"Hard disk to copy";a:1:{s:11:"translation";s:29:"Pevný disk pro kopírování";}s:23:"New hard disk to create";a:1:{s:11:"translation";s:48:"Vytvoření nového virtuálního pevného disku";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:197:"Zvolte prosím soubor, který budete chtít použít pro nový virtuální pevný disk. Pokud jej máte již vytvořen jiným virtualizačním software, můžete toto nastavení nechat beze změny.";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:161:"Vyberte prosím zda se virtuální pevný disk bude zvětšovat podle potřeby (dynamicky alokovaný) nebo zda jeho velikost bude pevně dána (pevná velikost).";}s:193:"Please select the virtual hard disk file that you would like to copy if it is not already selected. You can either choose one from the list or use the folder icon beside the list to select one.";a:1:{s:11:"translation";s:198:"Vyberte soubor virtuálního pevného disku, který chcete kopírovat, pokud již není vybrán. Můžete si buď vybrat soubor ze seznamu, nebo k jeho výběru použít ikonu složky vedle seznamu.";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:168:"Zadejte prosím název nového virtuálního pevného disku do políčka níže nebo klepněte na ikonku pro výběr jiné složky kde bude soubor následně vytvořen.";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:38:"Rozdělit na soubory menší než 2 GB";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:39:"Úložiště na fyzickém pevném disku";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:321:"Můžete také zvolit <b>rozdělení</b> souboru na pevném disku do několika souborů o velikosti až dvou gigabajtů. To je užitečné zejména v případě, že chcete virtuální počítač uložit na vyměnitelná zařízení USB nebo staré systémy, z nichž některé nedokážou zpracovat velmi velké soubory.";}}}s:17:"UIWizardExportApp";a:1:{s:8:"messages";a:28:{s:25:"Appliance Export Settings";a:1:{s:11:"translation";s:28:"Nastavení exportu appliance";}s:18:"Appliance settings";a:1:{s:11:"translation";s:24:"Nastavení pro applianci";}s:11:"Description";a:1:{s:11:"translation";s:5:"Popis";}s:6:"Export";a:1:{s:11:"translation";s:10:"Exportovat";}s:24:"Export Virtual Appliance";a:1:{s:11:"translation";s:28:"Export virtuální appliance";}s:5:"File:";a:1:{s:11:"translation";s:7:"Soubor:";}s:7:"Format:";a:1:{s:11:"translation";s:8:"Formát:";}s:116:"If you use an <b>ova</b> extension, then all the files will be combined into one Open Virtualization Format Archive.";a:1:{s:11:"translation";s:130:"Pokud použijete příponu <b>ova</b>, budou všechny soubory sloučeny do jednoho archivu ve formátu Open Virtualization Format.";}s:77:"If you use an <b>ovf</b> extension, several files will be written separately.";a:1:{s:11:"translation";s:78:"Pokud použijete příponu `ovf`, několik souborů bude zapsáno samostatně.";}s:7:"License";a:1:{s:11:"translation";s:7:"Licence";}s:4:"Name";a:1:{s:11:"translation";s:6:"Jméno";}s:7:"OVF 0.9";a:1:{s:11:"translation";s:7:"OVF 0.9";}s:7:"OVF 1.0";a:1:{s:11:"translation";s:7:"OVF 1.0";}s:7:"OVF 2.0";a:1:{s:11:"translation";s:7:"OVF 2.0";}s:33:"Other extensions are not allowed.";a:1:{s:11:"translation";s:36:"Jiná rozšíření nejsou povolena.";}s:50:"Please choose a filename to export the OVF/OVA to.";a:1:{s:11:"translation";s:62:"Vyberte název souboru, do kterého chcete exportovat OVF/OVA.";}s:186:"Please select the virtual machines that should be added to the appliance. You can select more than one. Please note that these machines have to be turned off before they can be exported.";a:1:{s:11:"translation";s:182:"Vyberte prosím virtuální počítače, které chcete přidat do zařízení. Můžete vybrat více než jeden. Upozorňujeme, že tyto počítače je nutné před exportem vypnout.";}s:7:"Product";a:1:{s:11:"translation";s:7:"Produkt";}s:11:"Product-URL";a:1:{s:11:"translation";s:12:"URL produktu";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:17:"Obnovit výchozí";}s:33:"Select a directory to export into";a:1:{s:11:"translation";s:48:"Vyberte adresář, do kterého chcete exportovat";}s:140:"This is the descriptive information which will be added to the virtual appliance.  You can change it by double clicking on individual lines.";a:1:{s:11:"translation";s:122:"Popisný text, který bude přidán k virtuální applianci. Můžete ho změnit poklepáním na jednotlivých řádcích.";}s:6:"Vendor";a:1:{s:11:"translation";s:8:"Výrobce";}s:10:"Vendor-URL";a:1:{s:11:"translation";s:15:"URL na výrobce";}s:7:"Version";a:1:{s:11:"translation";s:5:"Verze";}s:26:"Virtual machines to export";a:1:{s:11:"translation";s:33:"Virtuální počítač pro export";}s:19:"Write Manifest file";a:1:{s:11:"translation";s:23:"Zapsat soubor manifestu";}s:9:"undefined";a:1:{s:11:"translation";s:13:"nedefinovaný";}}}s:16:"UIWizardFirstRun";a:1:{s:8:"messages";a:6:{s:37:"Choose a virtual optical disk file...";a:1:{s:11:"translation";s:38:"Vybrat soubor s virtuálním diskem...";}s:127:"Please select a virtual optical disk file or a physical optical drive containing a disk to start your new virtual machine from.";a:1:{s:11:"translation";s:153:"Vyberte soubor virtuálního optického disku nebo fyzickou optickou jednotku obsahující disk, ze kterého chcete spustit nový virtuální počítač.";}s:20:"Select start-up disk";a:1:{s:11:"translation";s:26:"Výběr bootovacího disku";}s:5:"Start";a:1:{s:11:"translation";s:7:"Spustit";}s:343:"The disk should be suitable for starting a computer from and should contain the operating system you wish to install on the virtual machine if you want to do that now. The disk will be ejected from the virtual drive automatically next time you switch the virtual machine off, but you can also do this yourself if needed using the Devices menu.";a:1:{s:11:"translation";s:367:"Disk by měl být vhodný pro spuštění počítače a měl by obsahovat operační systém, který chcete na virtuální počítač nainstalovat, pokud to chcete provést nyní. Disk se z virtuální mechaniky automaticky vysune při příštím vypnutí virtuálního počítače, ale v případě potřeby to můžete provést i sami pomocí nabídky Zařízení.";}s:172:"The disk should be suitable for starting a computer from. As this virtual machine has no hard drive you will not be able to install an operating system on it at the moment.";a:1:{s:11:"translation";s:176:"Disk by měl být vhodný pro spuštění počítače. Protože tento virtuální stroj nemá pevný disk, nebudete na něj v tuto chvíli moci nainstalovat operační systém.";}}}s:17:"UIWizardImportApp";a:1:{s:8:"messages";a:28:{s:18:"Appliance settings";a:1:{s:11:"translation";s:24:"Nastavení pro applianci";}s:19:"Appliance to import";a:1:{s:11:"translation";s:20:"Appliance pro import";}s:3:"CPU";a:1:{s:11:"translation";s:8:"Procesor";}s:44:"Choose a virtual appliance file to import...";a:1:{s:11:"translation";s:49:"Zadejte název souboru s virtuální appliance...";}s:3:"DVD";a:1:{s:11:"translation";s:3:"DVD";}s:6:"Floppy";a:1:{s:11:"translation";s:7:"Disketa";}s:13:"Guest OS Type";a:1:{s:11:"translation";s:8:"OS hosta";}s:6:"Import";a:1:{s:11:"translation";s:6:"Import";}s:24:"Import Virtual Appliance";a:1:{s:11:"translation";s:28:"Import virtuální appliance";}s:4:"Name";a:1:{s:11:"translation";s:6:"Jméno";}s:15:"Network Adapter";a:1:{s:11:"translation";s:15:"Síťová karta";}s:3:"RAM";a:1:{s:11:"translation";s:5:"BERAN";}s:49:"Reinitialize the MAC address of all network cards";a:1:{s:11:"translation";s:55:"Znovu inicializujte MAC adresy všech síťových karet";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:17:"Obnovit výchozí";}s:29:"Select an appliance to import";a:1:{s:11:"translation";s:28:"Vyberte applianci pro import";}s:10:"Sound Card";a:1:{s:11:"translation";s:14:"Zvuková karta";}s:24:"Storage Controller (IDE)";a:1:{s:11:"translation";s:30:"Řadič pro úložiště (IDE)";}s:25:"Storage Controller (PCIe)";a:1:{s:11:"translation";s:27:"Řadič úložiště (PCIe)";}s:24:"Storage Controller (SAS)";a:1:{s:11:"translation";s:30:"Řadič pro úložiště (SAS)";}s:25:"Storage Controller (SATA)";a:1:{s:11:"translation";s:31:"Řadič pro úložiště (SATA)";}s:25:"Storage Controller (SCSI)";a:1:{s:11:"translation";s:31:"Řadič pro úložiště (SCSI)";}s:31:"Storage Controller (VirtioSCSI)";a:1:{s:11:"translation";s:34:"Řadič úložiště (Virtio SCSI)";}s:245:"These are the virtual machines contained in the appliance and the suggested settings of the imported VirtualBox machines. You can change many of the properties shown by double-clicking on the items and disable others using the check boxes below.";a:1:{s:11:"translation";s:221:"Zde jsou virtuální počítače s doporučeným mapováním pro import do VirtualBoxu. Většinu těchto vlastností můžete změnit poklepáním na položku a zakázat jiné pomocí zaškrtávácích tlačítek níže.";}s:14:"USB Controller";a:1:{s:11:"translation";s:11:"USB řadič";}s:18:"Virtual Disk Image";a:1:{s:11:"translation";s:23:"Virtuální obraz disku";}s:17:"Virtual System %1";a:1:{s:11:"translation";s:22:"Virtuální systém %1";}s:143:"VirtualBox currently supports importing appliances saved in the Open Virtualization Format (OVF). To continue, select the file to import below.";a:1:{s:11:"translation";s:164:"VirtualBox aktuálně podporuje import zařízení uložených ve formátu Open Virtualization Format (OVF). Chcete-li pokračovat, vyberte níže soubor k importu.";}s:9:"Warnings:";a:1:{s:11:"translation";s:11:"Varování:";}}}s:13:"UIWizardNewVD";a:1:{s:8:"messages";a:27:{s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:235:"<b>Dynamicky alokovaný</b> soubor na pevném disku bude využívat místo na fyzickém pevném disku pouze tehdy, když se zaplní (do maximální <b>fixní velikosti</b>), ačkoli se po uvolnění místa automaticky znovu nezmenší.";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:159:"Vytvoření souboru pevného disku s pevnou velikostí <b>pevné velikosti</b> může na některých systémech trvat déle, ale často se používá rychleji.";}s:51:"Choose a location for new virtual hard disk file...";a:1:{s:11:"translation";s:67:"Zvolte umístění nového souboru s virtuálním pevným diskem...";}s:52:"Choose a location for new virtual hard drive file...";a:1:{s:11:"translation";s:68:"Vyberte umístění pro nový soubor virtuálního pevného disku...";}s:6:"Create";a:1:{s:11:"translation";s:9:"Vytvořit";}s:24:"Create Virtual Hard Disk";a:1:{s:11:"translation";s:40:"Vytvoření virtuálního pevného disku";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:20:"Dynamicky alokované";}s:13:"File location";a:1:{s:11:"translation";s:19:"Umístění souboru";}s:22:"File location and size";a:1:{s:11:"translation";s:30:"Umístění a velikost souboru";}s:9:"File size";a:1:{s:11:"translation";s:16:"Velikost souboru";}s:10:"Fixed size";a:1:{s:11:"translation";s:15:"Pevná velikost";}s:25:"HDD (Parallels Hard Disk)";a:1:{s:11:"translation";s:25:"HDD (Parallels Hard Disk)";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:28:"Typ souboru s pevným diskem";}s:8:"Location";a:1:{s:11:"translation";s:11:"Umístění";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:197:"Zvolte prosím soubor, který budete chtít použít pro nový virtuální pevný disk. Pokud jej máte již vytvořen jiným virtualizačním software, můžete toto nastavení nechat beze změny.";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:161:"Vyberte prosím zda se virtuální pevný disk bude zvětšovat podle potřeby (dynamicky alokovaný) nebo zda jeho velikost bude pevně dána (pevná velikost).";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:168:"Zadejte prosím název nového virtuálního pevného disku do políčka níže nebo klepněte na ikonku pro výběr jiné složky kde bude soubor následně vytvořen.";}s:25:"QCOW (QEMU Copy-On-Write)";a:1:{s:11:"translation";s:25:"QCOW (QEMU Copy-On-Write)";}s:24:"QED (QEMU enhanced disk)";a:1:{s:11:"translation";s:24:"QED (QEMU enhanced disk)";}s:167:"Select the size of the virtual hard disk in megabytes. This size is the limit on the amount of file data that a virtual machine will be able to store on the hard disk.";a:1:{s:11:"translation";s:169:"Zvolte velikost virtuálního pevného disku v megabytech. Velikost je limitována velikostí souboru, který je virtuální počítač schopen uložit na pevném disku.";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:38:"Rozdělit na soubory menší než 2 GB";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:39:"Úložiště na fyzickém pevném disku";}s:27:"VDI (VirtualBox Disk Image)";a:1:{s:11:"translation";s:27:"VDI (VirtualBox Disk Image)";}s:23:"VHD (Virtual Hard Disk)";a:1:{s:11:"translation";s:23:"VHD (Virtual Hard Disk)";}s:27:"VMDK (Virtual Machine Disk)";a:1:{s:11:"translation";s:27:"VMDK (Virtual Machine Disk)";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:321:"Můžete také zvolit <b>rozdělení</b> souboru na pevném disku do několika souborů o velikosti až dvou gigabajtů. To je užitečné zejména v případě, že chcete virtuální počítač uložit na vyměnitelná zařízení USB nebo staré systémy, z nichž některé nedokážou zpracovat velmi velké soubory.";}s:9:"undefined";a:1:{s:11:"translation";s:13:"nedefinovaný";}}}s:13:"UIWizardNewVM";a:1:{s:8:"messages";a:18:{s:6:"Create";a:1:{s:11:"translation";s:9:"Vytvořit";}s:22:"Create Virtual Machine";a:1:{s:11:"translation";s:37:"Vytvoření virtuálního počítače";}s:30:"Create a virtual hard disk now";a:1:{s:11:"translation";s:39:"Vytvořte virtuální pevný disk nyní";}s:30:"Do not add a virtual hard disk";a:1:{s:11:"translation";s:36:"Nepřidávat virtuální pevný disk";}s:9:"Hard disk";a:1:{s:11:"translation";s:11:"Pevný disk";}s:138:"If you need a more complex storage set-up you can skip this step and make the changes to the machine settings once the machine is created.";a:1:{s:11:"translation";s:156:"Pokud potřebujete složitější nastavení úložiště, můžete tento krok přeskočit a provést změny nastavení počítače až po jeho vytvoření.";}s:63:"If you wish you can add a virtual hard disk to the new machine.";a:1:{s:11:"translation";s:78:"Pokud chcete, můžete do nového počítače přidat virtuální pevný disk.";}s:11:"Memory size";a:1:{s:11:"translation";s:16:"Velikost paměti";}s:25:"Name and operating system";a:1:{s:11:"translation";s:27:"Název a operační systém";}s:5:"Name:";a:1:{s:11:"translation";s:7:"Jméno:";}s:210:"Please choose a descriptive name for the new virtual machine and select the type of operating system you intend to install on it. The name you choose will be used throughout VirtualBox to identify this machine.";a:1:{s:11:"translation";s:239:"Zvolte prosím výstižný název pro nový virtuální počítač a vyberte typ operačního systému, který do něj budete instalovat. Zvolený název bude následně aplikací VirtualBox používán pro identifikaci tohoto počítače.";}s:86:"Select the amount of memory (RAM) in megabytes to be allocated to the virtual machine.";a:1:{s:11:"translation";s:98:"Vyberte množství paměti (RAM) v megabajtech, které bude přiděleno virtuálnímu počítači.";}s:44:"The recommended memory size is <b>%1 MB</b>.";a:1:{s:11:"translation";s:46:"Doporučená velikost paměti je <b>%1 MB</b>.";}s:51:"The recommended size of the hard disk is <b>%1</b>.";a:1:{s:11:"translation";s:50:"Doporučená velikost pevného disku je <b>%1</b>.";}s:5:"Type:";a:1:{s:11:"translation";s:4:"Typ:";}s:38:"Use an existing virtual hard disk file";a:1:{s:11:"translation";s:57:"Použít existující soubor virtuálního pevného disku";}s:8:"Version:";a:1:{s:11:"translation";s:6:"Verze:";}s:118:"You can either create a new hard disk file or select one from the list or from another location using the folder icon.";a:1:{s:11:"translation";s:130:"Můžete buď vytvořit nový soubor na pevném disku, nebo jej vybrat ze seznamu či z jiného umístění pomocí ikony složky.";}}}}}