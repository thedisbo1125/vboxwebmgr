eration";a:1:{s:11:"translation";s:18:"Ускорение";}s:22:"BIOS Logo Display Time";a:1:{s:11:"translation";s:55:"Время отображения логотипа BIOS";}s:12:"Base Memory:";a:1:{s:11:"translation";s:28:"Базовая память:";}s:11:"Boot Order:";a:1:{s:11:"translation";s:32:"Порядок загрузки:";}s:8:"Chipset:";a:1:{s:11:"translation";s:13:"Чипсет:";}s:7:"Default";a:1:{s:11:"translation";s:23:"По умолчанию";}s:22:"Disable host time sync";a:1:{s:11:"translation";s:77:"Отключить синхронизацию времени с хостом.";}s:30:"Enable EFI (special OSes only)";a:1:{s:11:"translation";s:105:"Включить EFI (только для определенных операционных систем)";}s:15:"Enable I/O APIC";a:1:{s:11:"translation";s:25:"Включить I/O APIC";}s:18:"Enable Large Pages";a:1:{s:11:"translation";s:48:"Включить большие страницы";}s:20:"Enable Nested Paging";a:1:{s:11:"translation";s:68:"Включить вложенную подкачку страниц.";}s:24:"Enable Nested VT-x/AMD-V";a:1:{s:11:"translation";s:74:"Включить вложенную виртуализацию VT-x/AMD-V.";}s:13:"Enable PAE/NX";a:1:{s:11:"translation";s:23:"Включить PAE/NX";}s:18:"Enable Page Fusion";a:1:{s:11:"translation";s:46:"Включить слияние страниц";}s:29:"Enable VT-x VPID (Intel only)";a:1:{s:11:"translation";s:77:"Включить VT-x VPID (только для процессоров Intel)";}s:34:"Enable VT-x unrestricted execution";a:1:{s:11:"translation";s:72:"Включить неограниченное выполнение VT-x.";}s:17:"Enable VT-x/AMD-V";a:1:{s:11:"translation";s:27:"Включить VT-x/AMD-V";}s:14:"Execution Cap:";a:1:{s:11:"translation";s:62:"Ограничение на количество казней:";}s:18:"Extended Features:";a:1:{s:11:"translation";s:52:"Дополнительные возможности:";}s:6:"Floppy";a:1:{s:11:"translation";s:16:"Дисковод";}s:33:"HPET (high precision event timer)";a:1:{s:11:"translation";s:59:"HPET (высокоточный таймер событий)";}s:9:"Hard Disk";a:1:{s:11:"translation";s:23:"Жёсткий диск";}s:26:"Hardware Clock in UTC Time";a:1:{s:11:"translation";s:84:"Аппаратные часы работают в формате времени UTC.";}s:24:"Hardware Virtualization:";a:1:{s:11:"translation";s:48:"Аппаратная виртуализация:";}s:6:"HyperV";a:1:{s:11:"translation";s:11:"ГиперV";}s:4:"ICH9";a:1:{s:11:"translation";s:5:"ИЧ9";}s:3:"KVM";a:1:{s:11:"translation";s:6:"КВМ";}s:6:"Legacy";a:1:{s:11:"translation";s:16:"Наследие";}s:2:"MB";a:1:{s:11:"translation";s:4:"МБ";}s:7:"Minimal";a:1:{s:11:"translation";s:22:"Минимальный";}s:11:"Motherboard";a:1:{s:11:"translation";s:33:"Материнская плата";}s:7:"Network";a:1:{s:11:"translation";s:8:"Сеть";}s:4:"None";a:1:{s:11:"translation";s:22:"Отсутствует";}s:7:"Optical";a:1:{s:11:"translation";s:20:"Оптический";}s:5:"PIIX3";a:1:{s:11:"translation";s:11:"ПИИКС3";}s:55:"Page Fusion currently not supported by VirtualBox 7.2.x";a:1:{s:11:"translation";s:114:"Функция Page Fusion в настоящее время не поддерживается в VirtualBox 7.2.x.";}s:29:"Paravirtualization Interface:";a:1:{s:11:"translation";s:54:"Интерфейс паравиртуализации:";}s:9:"Processor";a:1:{s:11:"translation";s:18:"Процессор";}s:13:"Processor(s):";a:1:{s:11:"translation";s:23:"Процессор(ы):";}s:3:"TPM";a:1:{s:11:"translation";s:6:"ТПМ";}}}s:20:"UIMachineSettingsUSB";a:1:{s:8:"messages";a:12:{s:16:"Add Empty Filter";a:1:{s:11:"translation";s:42:"Добавить пустой фильтр";}s:22:"Add Filter From Device";a:1:{s:11:"translation";s:55:"Добавить фильтр из устройства";}s:11:"Edit Filter";a:1:{s:11:"translation";s:29:"Изменить фильтр";}s:21:"Enable USB Controller";a:1:{s:11:"translation";s:41:"Включить контроллер USB";}s:16:"Move Filter Down";a:1:{s:11:"translation";s:31:"Переместить вниз";}s:14:"Move Filter Up";a:1:{s:11:"translation";s:33:"Переместить вверх";}s:13:"New Filter %1";a:1:{s:11:"translation";s:26:"Новый фильтр %1";}s:13:"Remove Filter";a:1:{s:11:"translation";s:27:"Удалить фильтр";}s:25:"USB 1.1 (OHCI) Controller";a:1:{s:11:"translation";s:35:"Контроллер USB 1.1 (OHCI)";}s:25:"USB 2.0 (EHCI) Controller";a:1:{s:11:"translation";s:35:"Контроллер USB 2.0 (EHCI)";}s:25:"USB 3.0 (xHCI) Controller";a:1:{s:11:"translation";s:35:"Контроллер USB 3.0 (xHCI)";}s:18:"USB Device Filters";a:1:{s:11:"translation";s:37:"Фильтры USB-устройств";}}}s:33:"UIMachineSettingsUSBFilterDetails";a:1:{s:8:"messages";a:13:{s:3:"Any";a:1:{s:11:"translation";s:10:"Любой";}s:13:"Manufacturer:";a:1:{s:11:"translation";s:27:"Производитель:";}s:5:"Name:";a:1:{s:11:"translation";s:7:"Имя:";}s:2:"No";a:1:{s:11:"translation";s:6:"Нет";}s:5:"Port:";a:1:{s:11:"translation";s:9:"Порт:";}s:11:"Product ID:";a:1:{s:11:"translation";s:44:"Идентификатор продукта:";}s:8:"Product:";a:1:{s:11:"translation";s:15:"Продукт:";}s:7:"Remote:";a:1:{s:11:"translation";s:19:"Удаленный:";}s:9:"Revision:";a:1:{s:11:"translation";s:17:"Редакция:";}s:11:"Serial No.:";a:1:{s:11:"translation";s:28:"Серийный номер:";}s:18:"USB Filter Details";a:1:{s:11:"translation";s:35:"Свойства USB-фильтра";}s:10:"Vendor ID:";a:1:{s:11:"translation";s:48:"Идентификатор поставщика:";}s:3:"Yes";a:1:{s:11:"translation";s:4:"Да";}}}s:15:"UIMessageCenter";a:1:{s:8:"messages";a:58:{s:111:"<b>Note:</b> this interface may be in use by one or more virtual network adapters belonging to one of your VMs.";a:1:{s:11:"translation";s:292:"<b>Примечание:</b> этот интерфейс может использоваться одним или несколькими виртуальными сетевыми адаптерами, принадлежащими одной из ваших виртуальных машин.";}s:70:"<nobr>%1</nobr><br><nobr>%2 since %3</nobr><br><nobr>Session %4</nobr>";a:1:{s:11:"translation";s:72:"<nobr>%1</nobr><br><nobr>%2 с %3</nobr><br><nobr>Сессия %4</nobr>";}s:75:"A file named <b>%1</b> already exists. Are you sure you want to replace it?";a:1:{s:11:"translation";s:129:"Файл с именем <b>%1</b> уже существует. Вы уверены, что хотите его заменить?";}s:13:"ACPI Shutdown";a:1:{s:11:"translation";s:25:"Выключение ACPI";}s:179:"After it is removed, these adapters will no longer be usable until you correct their settings by either choosing a different interface name or a different adapter attachment type.";a:1:{s:11:"translation";s:352:"После удаления этих адаптеров они перестанут быть пригодными для использования до тех пор, пока вы не исправите их настройки, выбрав другое имя интерфейса или другой тип подключения адаптера.";}s:83:"Are you sure you want to discard the saved state of the following virtual machines?";a:1:{s:11:"translation";s:153:"Вы уверены, что хотите отменить сохраненное состояние следующих виртуальных машин?";}s:4:"Back";a:1:{s:11:"translation";s:10:"Назад";}s:6:"Cancel";a:1:{s:11:"translation";s:12:"Отмена";}s:87:"Cannot create the machine folder <b>%1</b> in the parent folder <nobr><b>%2</b>.</nobr>";a:1:{s:11:"translation";s:154:"Не удалось создать папку виртуальной машины <b>%1</b> в родительской папке <nobr><b>%2</b>.</nobr>";}s:11:"Choose disk";a:1:{s:11:"translation";s:25:"Выберите диск";}s:20:"Choose existing disk";a:1:{s:11:"translation";s:50:"Выберите существующий диск";}s:5:"Close";a:1:{s:11:"translation";s:14:"Закрыть";}s:8:"Continue";a:1:{s:11:"translation";s:20:"Продолжить";}s:15:"Create new disk";a:1:{s:11:"translation";s:34:"Создать новый диск";}s:6:"Delete";a:1:{s:11:"translation";s:14:"Удалить";}s:16:"Delete all files";a:1:{s:11:"translation";s:32:"Удалить все файлы";}s:93:"Deleting this host-only network will remove the host-only interface this network is based on.";a:1:{s:11:"translation";s:211:"Удаление этой сети, предназначенной только для хоста, приведет к удалению интерфейса, на котором основана эта сеть.";}s:7:"Details";a:1:{s:11:"translation";s:12:"Детали";}s:7:"Discard";a:1:{s:11:"translation";s:16:"Сбросить";}s:63:"Do you really want to power off the following virtual machines?";a:1:{s:11:"translation";s:119:"Вы действительно хотите выключить следующие виртуальные машины?";}s:59:"Do you really want to reset the following virtual machines?";a:1:{s:11:"translation";s:127:"Вы действительно хотите перезагрузить следующие виртуальные машины?";}s:85:"Do you really want to send an ACPI shutdown signal to the following virtual machines?";a:1:{s:11:"translation";s:171:"Вы действительно хотите отправить сигнал выключения через ACPI следующим виртуальным машинам?";}s:79:"Do you want to remove the (host-only network) interface <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:152:"Вы действительно хотите удалить интерфейс (только для локальной сети) <nobr><b>%1</b>?</nobr>";}s:61:"Do you want to remove the NAT network <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:96:"Вы действительно хотите удалить сеть NAT <nobr><b>%1</b>?</nobr>";}s:124:"Doing this will also remove the files containing the machine's virtual hard disks if they are not in use by another machine.";a:1:{s:11:"translation";s:273:"Это также приведет к удалению файлов, содержащих виртуальные жесткие диски виртуальной машины, если они не используются другой виртуальной машиной.";}s:82:"Failed to send the ACPI Power Button press event to the virtual machine <b>%1</b>.";a:1:{s:11:"translation";s:128:"Не удалось послать сигнал завершения работы виртуальной машине <b>%1</b>.";}s:122:"Failed to update Guest Additions. The Guest Additions installation image will be mounted to provide a manual installation.";a:1:{s:11:"translation";s:303:"Не удалось обновить дополнения для гостевой системы. Образ установочного диска дополнений для гостевой системы будет смонтирован для выполнения установки вручную.";}s:7:"Go Back";a:1:{s:11:"translation";s:24:"Возвращаться";}s:230:"If this network is in use by one or more virtual machine network adapters these adapters will no longer be usable until you correct their settings by either choosing a different network name or a different adapter attachment type.";a:1:{s:11:"translation";s:418:"Если эта сеть используется одним или несколькими сетевыми адаптерами виртуальных машин, эти адаптеры перестанут работать до тех пор, пока вы не исправите их настройки, выбрав другое имя сети или другой тип подключения адаптера.";}s:4:"Keep";a:1:{s:11:"translation";s:14:"Держать";}s:12:"Keep changes";a:1:{s:11:"translation";s:25:"Оставить свои";}s:11:"Leave empty";a:1:{s:11:"translation";s:29:"Оставьте пустым";}s:4:"Next";a:1:{s:11:"translation";s:18:"Следующий";}s:2:"No";a:1:{s:11:"translation";s:6:"Нет";}s:2:"OK";a:1:{s:11:"translation";s:4:"ОК";}s:7:"Release";a:1:{s:11:"translation";s:18:"Выпускать";}s:15:"Reload settings";a:1:{s:11:"translation";s:29:"Загрузить новые";}s:6:"Remove";a:1:{s:11:"translation";s:12:"Убрать";}s:11:"Remove only";a:1:{s:11:"translation";s:30:"Убрать из списка";}s:41:"Replacing it will overwrite its contents.";a:1:{s:11:"translation";s:95:"Замена файла приведет к перезаписи его содержимого.";}s:7:"Restore";a:1:{s:11:"translation";s:24:"Восстановить";}s:185:"The VM failed to boot. This is possibly caused by not having an operating system installed or a misconfigured boot order. Maybe picking a guest OS install DVD will resolve the situation";a:1:{s:11:"translation";s:452:"Виртуальная машина не смогла загрузиться. Это может быть вызвано отсутствием установленной операционной системы или неправильной настройкой порядка загрузки. Возможно, выбор установочного DVD-диска гостевой операционной системы решит проблему.";}s:62:"The machine settings were changed while you were editing them.";a:1:{s:11:"translation";s:136:"Настройки устройства были изменены во время того, как вы их редактировали.";}s:67:"This folder already exists and possibly belongs to another machine.";a:1:{s:11:"translation";s:127:"Эта папка уже существует и, возможно, принадлежит другому компьютеру.";}s:118:"This operation is equivalent to resetting or powering off the machine without doing a proper shutdown of the guest OS.";a:1:{s:11:"translation";s:236:"Эта операция эквивалентна перезагрузке или выключению машины без корректного завершения работы гостевой операционной системы.";}s:78:"This will cause any unsaved data in applications running inside it to be lost.";a:1:{s:11:"translation";s:170:"Это приведет к потере всех несохраненных данных в приложениях, работающих внутри этой среды.";}s:96:"Would you like to choose a virtual CD/DVD disk to put in the drive or to leave it empty for now?";a:1:{s:11:"translation";s:189:"Вы хотите выбрать виртуальный CD/DVD-диск для установки в привод или оставить его пустым на данный момент?";}s:96:"Would you like to choose a virtual floppy disk to put in the drive or to leave it empty for now?";a:1:{s:11:"translation";s:166:"Вы хотите выбрать виртуальную дискету для вставки в дисковод или пока оставить его пустым?";}s:95:"Would you like to create a new, empty file to hold the disk contents or select an existing one?";a:1:{s:11:"translation";s:171:"Вы хотите создать новый пустой файл для хранения содержимого диска или выбрать существующий?";}s:94:"Would you like to delete the files containing the virtual machine from your hard disk as well?";a:1:{s:11:"translation";s:144:"Вы также хотите удалить с жесткого диска файлы, содержащие виртуальную машину?";}s:74:"Would you like to reload the changed settings or to keep your own changes?";a:1:{s:11:"translation";s:162:"Вы хотите перезагрузить измененные настройки или сохранить свои собственные изменения?";}s:3:"Yes";a:1:{s:11:"translation";s:4:"Да";}s:64:"You are about to add a new CD/DVD drive to controller <b>%1</b>.";a:1:{s:11:"translation";s:112:"Вы собираетесь добавить новый привод CD/DVD к контроллеру <b>%1</b>.";}s:64:"You are about to add a new floppy drive to controller <b>%1</b>.";a:1:{s:11:"translation";s:135:"Вы собираетесь добавить новый дисковод гибких дисков к контроллеру <b>%1</b>.";}s:65:"You are about to add a virtual hard disk to controller <b>%1</b>.";a:1:{s:11:"translation";s:128:"Вы собираетесь добавить виртуальный жесткий диск к контроллеру <b>%1</b>.";}s:262:"You are about to create a new virtual machine without a hard disk. You will not be able to install an operating system on the machine until you add one. In the mean time you will only be able to start the machine using a virtual optical disk or from the network.";a:1:{s:11:"translation";s:513:"Вы собираетесь создать новую виртуальную машину без жёсткого диска. У Вас не будет возможности установить операционную систему до тех пор, пока Вы не добавите как минимум один жёсткий диск. Однако, Вы сможете запустить машину и загрузить операционную систему с оптического диска.";}s:77:"You are about to remove the following virtual machines from the machine list:";a:1:{s:11:"translation";s:116:"Вы собираетесь удалить следующие виртуальные машины из списка:";}s:43:"You currently have unsaved setting changes.";a:1:{s:11:"translation";s:115:"В настоящее время у вас есть несохраненные изменения настроек.";}}}s:16:"UIProgressDialog";a:1:{s:8:"messages";a:1:{s:6:"Cancel";a:1:{s:11:"translation";s:12:"Отмена";}}}s:17:"UISnapshotDetails";a:1:{s:8:"messages";a:41:{s:11:"%1 since %2";a:1:{s:11:"translation";s:8:"%1 с %2";}s:10:"%n day ago";a:1:{s:11:"translation";s:22:"%n дней назад";}s:11:"%n days ago";a:1:{s:11:"translation";s:22:"%n дней назад";}s:11:"%n hour ago";a:1:{s:11:"translation";s:20:"%n час назад";}s:12:"%n hours ago";a:1:{s:11:"translation";s:24:"%n часов назад";}s:13:"%n minute ago";a:1:{s:11:"translation";s:24:"%n минут назад";}s:14:"%n minutes ago";a:1:{s:11:"translation";s:24:"%n минут назад";}s:13:"%n second ago";a:1:{s:11:"translation";s:26:"%n секунд назад";}s:14:"%n seconds ago";a:1:{s:11:"translation";s:26:"%n секунд назад";}s:64:"Are you sure you want to delete the selected snapshot <b>%1</b>?";a:1:{s:11:"translation";s:98:"Вы уверены, что хотите удалить выбранный снимок <b>%1</b>?";}s:65:"Are you sure you want to restore snapshot <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:102:"Вы уверены, что хотите восстановить снимок <nobr><b>%1</b></nobr>?";}s:45:"Automatically start the machine after restore";a:1:{s:11:"translation";s:99:"Автоматически запустить машину после восстановления.";}s:46:"Create a snapshot of the current machine state";a:1:{s:11:"translation";s:76:"Создать снимок текущего состояния машины";}s:13:"Current State";a:1:{s:11:"translation";s:33:"Текущее состояние";}s:23:"Current State (changed)";a:1:{s:11:"translation";s:52:"Текущее состояние (изменено)";}s:15:"Delete Snapshot";a:1:{s:11:"translation";s:27:"Удалить снимок";}s:212:"Deleting the snapshot will cause the state information saved in it to be lost, and storage data spread over several image files that VirtualBox has created together with the snapshot will be merged into one file.";a:1:{s:11:"translation";s:442:"Удаление моментального снимка приведет к потере сохраненной в нем информации о состоянии системы, а данные хранилища, распределенные по нескольким файлам образов, созданным VirtualBox вместе с моментальным снимком, будут объединены в один файл.";}s:12:"Description:";a:1:{s:11:"translation";s:17:"Описание:";}s:18:"Details of %1 (%2)";a:1:{s:11:"translation";s:50:"Подробная информация о %1 (%2)";}s:8:"Details:";a:1:{s:11:"translation";s:13:"Детали:";}s:89:"If you do not do this the current state will be permanently lost. Do you wish to proceed?";a:1:{s:11:"translation";s:173:"Если вы этого не сделаете, текущее состояние будет безвозвратно утеряно. Вы хотите продолжить?";}s:5:"Name:";a:1:{s:11:"translation";s:7:"Имя:";}s:25:"Power off virtual machine";a:1:{s:11:"translation";s:54:"Выключить виртуальную машину";}s:24:"Power on virtual machine";a:1:{s:11:"translation";s:53:"Включить виртуальную машину.";}s:16:"Restore Snapshot";a:1:{s:11:"translation";s:37:"Восстановить снимок";}s:12:"Show Details";a:1:{s:11:"translation";s:39:"Показать подробности";}s:11:"Snapshot %1";a:1:{s:11:"translation";s:15:"Снимок %1";}s:20:"Snapshot Description";a:1:{s:11:"translation";s:29:"Описание снимка";}s:13:"Snapshot Name";a:1:{s:11:"translation";s:19:"Имя снимка";}s:32:"Take Snapshot of Virtual Machine";a:1:{s:11:"translation";s:63:"Сделать снимок виртуальной машины";}s:52:"Take a snapshot of the current virtual machine state";a:1:{s:11:"translation";s:99:"Сделать снимок текущего состояния виртуальной машины";}s:11:"Taken at %1";a:1:{s:11:"translation";s:20:"Сделано в %1";}s:11:"Taken on %1";a:1:{s:11:"translation";s:17:"Сделано %1";}s:6:"Taken:";a:1:{s:11:"translation";s:13:"Взятый:";}s:71:"The current state differs from the state stored in the current snapshot";a:1:{s:11:"translation";s:135:"Текущее состояние отличается от состояния, сохранённого в текущем снимке";}s:74:"The current state is identical to the state stored in the current snapshot";a:1:{s:11:"translation";s:128:"Текущее состояние идентично состоянию, сохранённому в текущем снимке";}s:87:"This can be a lengthy process, and the information in the snapshot cannot be recovered.";a:1:{s:11:"translation";s:182:"Это может быть длительный процесс, и информация, содержащаяся в снимке, не подлежит восстановлению.";}s:57:"You are about to restore snapshot <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:89:"Вы собираетесь восстановить снимок <nobr><b>%1</b></nobr>.";}s:102:"You can create a snapshot of the current state of the virtual machine first by checking the box below.";a:1:{s:11:"translation";s:160:"Вы можете создать снимок текущего состояния виртуальной машины, установив флажок ниже.";}s:7:"offline";a:1:{s:11:"translation";s:12:"офлайн";}s:6:"online";a:1:{s:11:"translation";s:12:"онлайн";}}}s:7:"UIUsers";a:1:{s:8:"messages";a:16:{s:8:"Add User";a:1:{s:11:"translation";s:41:"Добавить пользователя";}s:10:"Admin User";a:1:{s:11:"translation";s:51:"Пользователь-администратор";}s:20:"Can administer users";a:1:{s:11:"translation";s:59:"Может управлять пользователями.";}s:15:"Change Password";a:1:{s:11:"translation";s:29:"Изменить пароль";}s:9:"Edit User";a:1:{s:11:"translation";s:51:"Редактировать пользователя";}s:29:"Invalid username or password.";a:1:{s:11:"translation";s:69:"Неверное имя пользователя или пароль.";}s:6:"Log in";a:1:{s:11:"translation";s:28:"Авторизоваться";}s:12:"New Password";a:1:{s:11:"translation";s:23:"Новый пароль";}s:12:"Old Password";a:1:{s:11:"translation";s:25:"Старый пароль";}s:8:"Password";a:1:{s:11:"translation";s:12:"Пароль";}s:11:"Remove User";a:1:{s:11:"translation";s:39:"Удалить пользователя";}s:6:"Retype";a:1:{s:11:"translation";s:27:"Повторный ввод";}s:41:"The password you have entered is invalid.";a:1:{s:11:"translation";s:70:"Введенный вами пароль недействителен.";}s:44:"The passwords you have entered do not match.";a:1:{s:11:"translation";s:65:"Введенные вами пароли не совпадают.";}s:8:"Username";a:1:{s:11:"translation";s:31:"Имя пользователя";}s:5:"Users";a:1:{s:11:"translation";s:24:"Пользователи";}}}s:11:"UIVMDesktop";a:1:{s:8:"messages";a:5:{s:7:"Console";a:1:{s:11:"translation";s:14:"Консоль";}s:7:"Details";a:1:{s:11:"translation";s:12:"Детали";}s:13:"Host Reources";a:1:{s:11:"translation";s:25:"Ресурсы хоста";}s:10:"Loading...";a:1:{s:11:"translation";s:19:"Загрузка...";}s:9:"Snapshots";a:1:{s:11:"translation";s:48:"Укажите цель клонирования";}}}s:13:"UIVMLogViewer";a:1:{s:8:"messages";a:2:{s:26:"%1 - VirtualBox Log Viewer";a:1:{s:11:"translation";s:57:"%1 — Просмотрщик журналов VirtualBox";}s:100:"No log files found. Press the <b>Refresh</b> button to rescan the log folder <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:215:"Файлы журналов не найдены. Нажмите кнопку <b>Обновить</b>, чтобы повторно просканировать папку с журналами <nobr><b>%1</b></nobr>.";}}}s:17:"UIVMPreviewWindow";a:1:{s:8:"messages";a:1:{s:18:"Open in new window";a:1:{s:11:"translation";s:37:"Открыть в новом окне";}}}s:21:"UIVirtualMediaManager";a:1:{s:8:"messages";a:61:{s:7:"Actions";a:1:{s:11:"translation";s:16:"Действия";}s:11:"Actual Size";a:1:{s:11:"translation";s:22:"Факт. размер";}s:3:"Add";a:1:{s:11:"translation";s:16:"Добавить";}s:9:"Add iSCSI";a:1:{s:11:"translation";s:22:"Добавить iSCSI";}s:53:"Are you sure you want to release the disk image file:";a:1:{s:11:"translation";s:89:"Вы уверены, что хотите удалить файл образа диска?";}s:91:"Are you sure you want to remove the %1 <nobr><b>%2</b></nobr> from the list of known media?";a:1:{s:11:"translation";s:157:"Вы уверены, что хотите удалить элемент %1 <nobr><b>%2</b></nobr> из списка известных медиафайлов?";}s:12:"Attached to:";a:1:{s:11:"translation";s:26:"Подсоединён к:";}s:19:"Choose medium type:";a:1:{s:11:"translation";s:41:"Выберите тип носителя:";}s:7:"Copy...";a:1:{s:11:"translation";s:23:"Копировать...";}s:12:"Description:";a:1:{s:11:"translation";s:17:"Описание:";}s:87:"Do you want to delete the storage unit of the virtual hard disk <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:155:"Вы действительно хотите удалить хранилище виртуального жесткого диска <nobr><b>%1</b></nobr>?";}s:7:"Encoded";a:1:{s:11:"translation";s:24:"Закодировано";}s:12:"Floppy disks";a:1:{s:11:"translation";s:23:"Гибкие диски";}s:7:"Format:";a:1:{s:11:"translation";s:13:"Формат:";}s:10:"Hard disks";a:1:{s:11:"translation";s:25:"Жесткие диски";}s:79:"Hard drive has children, <b>Writethrough</b> and <b>Shareable</b> not available";a:1:{s:11:"translation";s:186:"Жесткий диск имеет дочерние элементы, функции <b>Прописывание</b> и <b>совместного доступа</b> недоступны.";}s:86:"Hard drive is attached to a VM, <b>Immutable</b> and <b>Multi-attach</b> not available";a:1:{s:11:"translation";s:211:"Жесткий диск подключен к виртуальной машине, функции <b>Неизменяемый</b> и <b>Множественное подключение</b> недоступны.";}s:53:"Hard drive is dynamic, <b>Shareable</b> not available";a:1:{s:11:"translation";s:148:"Жесткий диск является динамическим, функция <b>совместного доступа</b> недоступна.";}s:128:"If you select <b>Delete</b> then the specified storage unit will be permanently deleted. This operation <b>cannot be undone</b>.";a:1:{s:11:"translation";s:213:"Если вы выберете <b>Удалить</b>, указанное хранилище будет удалено безвозвратно. Эту операцию <b>невозможно отменить</b>.";}s:215:"If you select <b>Keep</b> then the hard disk will be only removed from the list of known hard disks, but the storage unit will be left untouched which makes it possible to add this hard disk to the list later again.";a:1:{s:11:"translation";s:360:"Если вы выберете <b>Сохранить</b>, жесткий диск будет удален только из списка известных жестких дисков, но сам накопитель останется нетронутым, что позволит добавить этот жесткий диск в список позже.";}s:9:"Immutable";a:1:{s:11:"translation";s:24:"Неизменяемый";}s:19:"Internal Networking";a:1:{s:11:"translation";s:29:"Внутренняя сеть";}s:3:"LUN";a:1:{s:11:"translation";s:6:"ЛУН";}s:9:"Location:";a:1:{s:11:"translation";s:25:"Расположение:";}s:18:"Medium attributes:";a:1:{s:11:"translation";s:46:"Характеристики носителя:";}s:99:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to copy medium.";a:1:{s:11:"translation";s:268:"Носитель подключен к виртуальной машине, находящейся в состоянии «Работает», «Приостановлена» или «Сохранена». Невозможно скопировать носитель.";}s:102:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to release medium.";a:1:{s:11:"translation";s:268:"Носитель подключен к виртуальной машине, находящейся в состоянии «Работает», «Приостановлена» или «Сохранена». Невозможно отсоединить носитель.";}s:24:"Modify medium attributes";a:1:{s:11:"translation";s:72:"Изменить атрибуты носителя информации.";}s:9:"Modify...";a:1:{s:11:"translation";s:19:"Изменить...";}s:12:"Multi-Attach";a:1:{s:11:"translation";s:49:"Многократное прикрепление";}s:11:"MultiAttach";a:1:{s:11:"translation";s:36:"Мультиприкрепление";}s:4:"Name";a:1:{s:11:"translation";s:6:"Имя";}s:3:"New";a:1:{s:11:"translation";s:10:"Новый";}s:6:"Normal";a:1:{s:11:"translation";s:20:"Нормальный";}s:113:"Note that the storage unit of this medium will not be deleted and that it will be possible to use it later again.";a:1:{s:11:"translation";s:219:"Обратите внимание, что хранилище данных этого носителя не будет удалено, и его можно будет использовать повторно позже.";}s:13:"Optical disks";a:1:{s:11:"translation";s:31:"Оптические диски";}s:8:"Password";a:1:{s:11:"translation";s:12:"Пароль";}s:95:"Please choose one of the following modes and press <b>%2</b> to proceed or <b>%3</b> otherwise.";a:1:{s:11:"translation";s:197:"Пожалуйста, выберите один из следующих режимов и нажмите <b>%2</b> для продолжения или <b>%3</b> в противном случае.";}s:4:"Port";a:1:{s:11:"translation";s:8:"Порт";}s:8:"Readonly";a:1:{s:11:"translation";s:32:"Только для чтения";}s:7:"Refresh";a:1:{s:11:"translation";s:16:"Обновить";}s:7:"Release";a:1:{s:11:"translation";s:18:"Выпускать";}s:6:"Remove";a:1:{s:11:"translation";s:12:"Убрать";}s:12:"Rename File:";a:1:{s:11:"translation";s:36:"Переименовать файл:";}s:6:"Select";a:1:{s:11:"translation";s:16:"Выбирать";}s:6:"Server";a:1:{s:11:"translation";s:12:"Сервер";}s:9:"Shareable";a:1:{s:11:"translation";s:31:"Можно поделиться";}s:4:"Size";a:1:{s:11:"translation";s:12:"Размер";}s:16:"Storage details:";a:1:{s:11:"translation";s:17:"Атрибуты:";}s:6:"Target";a:1:{s:11:"translation";s:8:"Цель";}s:69:"This will detach it from the following virtual machine(s): <b>%2</b>.";a:1:{s:11:"translation";s:104:"Это отсоединит его от следующих виртуальных машин: <b>%2</b>.";}s:5:"Type:";a:1:{s:11:"translation";s:7:"Тип:";}s:5:"UUID:";a:1:{s:11:"translation";s:5:"UUID:";}s:8:"Username";a:1:{s:11:"translation";s:31:"Имя пользователя";}s:64:"VM hard drive is attached to is running, cannot modify disk type";a:1:{s:11:"translation";s:188:"Виртуальная машина, к которой подключен жесткий диск, запущена, поэтому изменить тип диска невозможно.";}s:21:"Virtual Media Manager";a:1:{s:11:"translation";s:58:"Менеджер виртуальных носителей";}s:12:"Virtual Size";a:1:{s:11:"translation";s:22:"Вирт. размер";}s:7:"Warning";a:1:{s:11:"translation";s:28:"Предупреждение";}s:8:"Warnings";a:1:{s:11:"translation";s:28:"Предупреждения";}s:12:"Writethrough";a:1:{s:11:"translation";s:24:"Прописывание";}s:70:"You are about to change the settings of the disk image file <b>%1</b>.";a:1:{s:11:"translation";s:109:"Вы собираетесь изменить настройки файла образа диска <b>%1</b>.";}}}s:8:"UIWizard";a:1:{s:8:"messages";a:2:{s:11:"Expert Mode";a:1:{s:11:"translation";s:31:"Экспертный режим";}s:11:"Guided Mode";a:1:{s:11:"translation";s:36:"Режим с подсказками";}}}s:15:"UIWizardCloneVM";a:1:{s:8:"messages";a:31:{s:8:"%1 Clone";a:1:{s:11:"translation";s:11:"Клон %1";}s:5:"Clone";a:1:{s:11:"translation";s:22:"Клонировать";}s:13:"Clone Options";a:1:{s:11:"translation";s:43:"Параметры клонирования";}s:21:"Clone Virtual Machine";a:1:{s:11:"translation";s:58:"Клонировать виртуальную машину";}s:10:"Clone type";a:1:{s:11:"translation";s:46:"Укажите тип клонирования";}s:20:"Cloned Machine Name:";a:1:{s:11:"translation";s:47:"Имя клонированной машины:";}s:21:"Current machine state";a:1:{s:11:"translation";s:46:"Текущее состояние машины";}s:28:"Current snapshot tree branch";a:1:{s:11:"translation";s:53:"Текущая ветвь дерева снимков";}s:10:"Everything";a:1:{s:11:"translation";s:6:"Все";}s:10:"Full Clone";a:1:{s:11:"translation";s:37:"Полное клонирование";}s:51:"Generate new MAC addresses for all network adapters";a:1:{s:11:"translation";s:97:"Сгенерировать новые MAC-адреса всех сетевых адаптеров";}s:142:"If you choose <b>Current machine state</b>, the new machine will reflect the current state of the original machine and will have no snapshots.";a:1:{s:11:"translation";s:295:"Если вы выберете <b>Текущее состояние машины</b>, новая виртуальная машина будет отражать текущее состояние исходной машины и не будет иметь моментальных снимков.";}s:246:"If you choose <b>Current snapshot tree branch</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the tree branch starting at the current state in the original machine.";a:1:{s:11:"translation";s:519:"Если вы выберете <b>Текущая ветвь дерева моментальных снимков</b>, новая виртуальная машина будет отражать текущее состояние исходной машины и будет иметь соответствующие моментальные снимки для всех моментальных снимков в ветви дерева, начиная с текущего состояния исходной машины.";}s:179:"If you choose <b>Everything</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the original machine.";a:1:{s:11:"translation";s:315:"Если вы выберете <b>Все</b>, новая виртуальная машина будет отражать текущее состояние исходной машины и будет иметь соответствующие снимки для всех снимков исходной машины.";}s:135:"If you choose <b>Full clone</b>, an exact copy (including all virtual hard disk files) of the original virtual machine will be created.";a:1:{s:11:"translation";s:266:"Если вы выберете <b>Полное клонирование</b>, будет создана точная копия исходной виртуальной машины (включая все файлы виртуальных жестких дисков).";}s:279:"If you choose <b>Linked clone</b>, a new machine will be created, but the virtual hard disk files will be tied to the virtual hard disk files of original machine and you will not be able to move the new virtual machine to a different computer without moving the original as well.";a:1:{s:11:"translation";s:536:"Если вы выберете <b>Связанный клон</b>, будет создана новая виртуальная машина, но файлы виртуального жесткого диска будут связаны с файлами виртуального жесткого диска исходной машины, и вы не сможете переместить новую виртуальную машину на другой компьютер, не переместив при этом и исходную.";}s:136:"If you create a <b>Linked clone</b>, then a new snapshot will be created in the original virtual machine as part of the cloning process.";a:1:{s:11:"translation";s:240:"Если вы создаете <b>связанный клон</b>, то в процессе клонирования в исходной виртуальной машине будет создан новый снимок состояния.";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:76:"Включать MAC-адреса всех сетевых адаптеров";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:84:"Включать только MAC-адреса сетевого адаптера NAT";}s:15:"Keep Disk Names";a:1:{s:11:"translation";s:42:"Сохранить имена дисков";}s:19:"Keep Hardware UUIDs";a:1:{s:11:"translation";s:73:"Сохранить аппаратные UUID-идентификаторы";}s:25:"Linked Base for %1 and %2";a:1:{s:11:"translation";s:39:"Связная база для %1 и %2";}s:12:"Linked Clone";a:1:{s:11:"translation";s:27:"Связанный клон";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:63:"Политика использования MAC-адресов:";}s:16:"New machine name";a:1:{s:11:"translation";s:30:"Новое имя машины";}s:49:"Please choose a name for the new virtual machine.";a:1:{s:11:"translation";s:100:"Пожалуйста, выберите имя для новой виртуальной машины.";}s:51:"Please choose the type of clone you wish to create.";a:1:{s:11:"translation";s:106:"Пожалуйста, выберите тип клона, который вы хотите создать.";}s:81:"Please choose which parts of the snapshot tree should be cloned with the machine.";a:1:{s:11:"translation";s:207:"Пожалуйста, выберите, какие части дерева моментальных снимков следует клонировать вместе с виртуальной машиной.";}s:9:"Snapshots";a:1:{s:11:"translation";s:48:"Укажите цель клонирования";}s:57:"The new machine will be a clone of the machine <b>%1</b>.";a:1:{s:11:"translation";s:71:"Новая машина будет клоном машины <b>%1</b>.";}s:9:"undefined";a:1:{s:11:"translation";s:28:"неопределенный";}}}s:14:"UIWizardCopyVD";a:1:{s:8:"messages";a:19:{s:7:"%1_copy";a:1:{s:11:"translation";s:13:"%1_копия";}s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:534:"Файл жесткого диска с <b>динамическим распределением</b> пространства будет использовать место на вашем физическом жестком диске только по мере его заполнения (до максимального <b>фиксированного размера</b>), однако он не будет автоматически уменьшаться в размере при освобождении места на нем.";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:313:"Создание файла жесткого диска <b>фиксированного размера</b> может занять больше времени на некоторых системах, но в дальнейшем его использование часто оказывается быстрее.";}s:42:"Choose a virtual hard disk file to copy...";a:1:{s:11:"translation";s:111:"Выберите файл виртуального жесткого диска для копирования...";}s:43:"Choose a virtual hard drive file to copy...";a:1:{s:11:"translation";s:111:"Выберите файл виртуального жесткого диска для копирования...";}s:4:"Copy";a:1:{s:11:"translation";s:20:"Копировать";}s:22:"Copy Virtual Hard Disk";a:1:{s:11:"translation";s:67:"Копировать виртуальный жёсткий диск";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:39:"Динамически выделено";}s:10:"Fixed size";a:1:{s:11:"translation";s:39:"Фиксированный размер";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:21:"Укажите тип";}s:17:"Hard disk to copy";a:1:{s:11:"translation";s:53:"Жесткий диск для копирования";}s:23:"New hard disk to create";a:1:{s:11:"translation";s:49:"Создать новый жесткий диск";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:487:"Пожалуйста, укажите тип файла, определяющий формат, который Вы хотите использовать при создании нового жёсткого диска. Если у Вас нет необходимости использовать диск с другими продуктами программной виртуализации, Вы можете оставить данный параметр без изменений.";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:279:"Пожалуйста уточните, должен ли новый виртуальный жёсткий диск подстраивать свой размер под размер своего содержимого или быть точно заданного размера.";}s:193:"Please select the virtual hard disk file that you would like to copy if it is not already selected. You can either choose one from the list or use the folder icon beside the list to select one.";a:1:{s:11:"translation";s:393:"Пожалуйста, выберите файл виртуального жесткого диска, который вы хотите скопировать, если он еще не выбран. Вы можете выбрать его из списка или использовать значок папки рядом со списком, чтобы выбрать нужный файл.";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:231:"Пожалуйста укажите имя нового виртуального жёсткого диска в поле снизу или используйте кнопку с иконкой папки справа от него.";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:70:"Разделите на файлы размером менее 2 ГБ.";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:44:"Укажите формат хранения";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:539:"Вы также можете <b>разделиться</b> файл образа жесткого диска на несколько файлов размером до двух гигабайт каждый. Это особенно полезно, если вы хотите хранить виртуальную машину на съемных USB-накопителях или старых системах, некоторые из которых не поддерживают работу с очень большими файлами.";}}}s:17:"UIWizardExportApp";a:1:{s:8:"messages";a:34:{s:20:"Additional Settings:";a:1:{s:11:"translation";s:48:"Дополнительные настройки:";}s:25:"Appliance Export Settings";a:1:{s:11:"translation";s:56:"Настройки экспорта устройства";}s:18:"Appliance settings";a:1:{s:11:"translation";s:48:"Укажите параметры импорта";}s:11:"Description";a:1:{s:11:"translation";s:16:"Описание";}s:6:"Export";a:1:{s:11:"translation";s:14:"Экспорт";}s:24:"Export Virtual Appliance";a:1:{s:11:"translation";s:39:"Экспорт конфигураций";}s:5:"File:";a:1:{s:11:"translation";s:9:"Файл:";}s:7:"Format:";a:1:{s:11:"translation";s:13:"Формат:";}s:116:"If you use an <b>ova</b> extension, then all the files will be combined into one Open Virtualization Format Archive.";a:1:{s:11:"translation";s:185:"Если вы используете расширение <b>ova</b>, все файлы будут объединены в один архив формата Open Virtualization Format.";}s:77:"If you use an <b>ovf</b> extension, several files will be written separately.";a:1:{s:11:"translation";s:147:"Если вы используете расширение <b>ovf</b>, несколько файлов будут записаны отдельно.";}s:23:"Include ISO image files";a:1:{s:11:"translation";s:46:"Включить файлы образов ISO";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:76:"Включать MAC-адреса всех сетевых адаптеров";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:84:"Включать только MAC-адреса сетевого адаптера NAT";}s:7:"License";a:1:{s:11:"translation";s:16:"Лицензия";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:63:"Политика использования MAC-адресов:";}s:4:"Name";a:1:{s:11:"translation";s:6:"Имя";}s:7:"OVF 0.9";a:1:{s:11:"translation";s:7:"OVF 0.9";}s:7:"OVF 1.0";a:1:{s:11:"translation";s:7:"OVF 1.0";}s:7:"OVF 2.0";a:1:{s:11:"translation";s:7:"OVF 2.0";}s:33:"Other extensions are not allowed.";a:1:{s:11:"translation";s:89:"Использование других расширений не допускается.";}s:50:"Please choose a filename to export the OVF/OVA to.";a:1:{s:11:"translation";s:105:"Пожалуйста, выберите имя файла для экспорта в формат OVF/OVA.";}s:186:"Please select the virtual machines that should be added to the appliance. You can select more than one. Please note that these machines have to be turned off before they can be exported.";a:1:{s:11:"translation";s:374:"Пожалуйста, выберите виртуальные машины, которые необходимо добавить в виртуальное устройство. Вы можете выбрать несколько машин. Обратите внимание, что эти машины должны быть выключены перед экспортом.";}s:7:"Product";a:1:{s:11:"translation";s:14:"Продукт";}s:11:"Product-URL";a:1:{s:11:"translation";s:32:"Ссылка на продукт";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:23:"По умолчанию";}s:33:"Select a directory to export into";a:1:{s:11:"translation";s:56:"Выберите каталог для экспорта.";}s:39:"Strip all network adapter MAC addresses";a:1:{s:11:"translation";s:81:"Удалить все MAC-адреса всех сетевых адаптеров";}s:140:"This is the descriptive information which will be added to the virtual appliance.  You can change it by double clicking on individual lines.";a:1:{s:11:"translation";s:206:"Это описание будет добавлено к экспортируемой конфигурации. Вы можете изменить его строки двойным щелчком мыши.";}s:6:"Vendor";a:1:{s:11:"translation";s:18:"Поставщик";}s:10:"Vendor-URL";a:1:{s:11:"translation";s:38:"Ссылка на поставщика";}s:7:"Version";a:1:{s:11:"translation";s:12:"Версия";}s:26:"Virtual machines to export";a:1:{s:11:"translation";s:49:"Выберите машины на экспорт";}s:19:"Write Manifest file";a:1:{s:11:"translation";s:42:"Создать файл манифеста";}s:9:"undefined";a:1:{s:11:"translation";s:28:"неопределенный";}}}s:16:"UIWizardFirstRun";a:1:{s:8:"messages";a:6:{s:37:"Choose a virtual optical disk file...";a:1:{s:11:"translation";s:62:"Выбрать образ оптического диска...";}s:127:"Please select a virtual optical disk file or a physical optical drive containing a disk to start your new virtual machine from.";a:1:{s:11:"translation";s:296:"Пожалуйста, выберите файл виртуального оптического диска или физический оптический привод с диском, с которого будет загружаться ваша новая виртуальная машина.";}s:20:"Select start-up disk";a:1:{s:11:"translation";s:48:"Выберите загрузочный диск";}s:5:"Start";a:1:{s:11:"translation";s:20:"Продолжить";}s:343:"The disk should be suitable for starting a computer from and should contain the operating system you wish to install on the virtual machine if you want to do that now. The disk will be ejected from the virtual drive automatically next time you switch the virtual machine off, but you can also do this yourself if needed using the Devices menu.";a:1:{s:11:"translation";s:652:"Диск должен подходить для загрузки компьютера и содержать операционную систему, которую вы хотите установить на виртуальную машину, если вы планируете сделать это сейчас. Диск будет автоматически извлечен из виртуального дисковода при следующем выключении виртуальной машины, но вы также можете сделать это самостоятельно, используя меню «Устройства».";}s:172:"The disk should be suitable for starting a computer from. As this virtual machine has no hard drive you will not be able to install an operating system on it at the moment.";a:1:{s:11:"translation";s:326:"Этот диск должен подходить для загрузки компьютера. Поскольку у этой виртуальной машины нет жесткого диска, вы не сможете установить на нее операционную систему в данный момент.";}}}s:17:"UIWizardImportApp";a:1:{s:8:"messages";a:35:{s:19:"Additional Options:";a:1:{s:11:"translation";s:40:"Дополнительные опции:";}s:18:"Appliance settings";a:1:{s:11:"translation";s:48:"Укажите параметры импорта";}s:19:"Appliance to import";a:1:{s:11:"translation";s:41:"Выберите конфигурацию";}s:3:"CPU";a:1:{s:11:"translation";s:18:"Процессор";}s:44:"Choose a virtual appliance file to import...";a:1:{s:11:"translation";s:73:"Укажите файл для импорта конфигураций...";}s:3:"DVD";a:1:{s:11:"translation";s:16:"DVD-привод";}s:11:"Description";a:1:{s:11:"translation";s:16:"Описание";}s:6:"Floppy";a:1:{s:11:"translation";s:16:"Дисковод";}s:51:"Generate new MAC addresses for all network adapters";a:1:{s:11:"translation";s:97:"Сгенерировать новые MAC-адреса всех сетевых адаптеров";}s:13:"Guest OS Type";a:1:{s:11:"translation";s:28:"Тип гостевой ОС";}s:6:"Import";a:1:{s:11:"translation";s:12:"Импорт";}s:25:"Import Hard Drives as VDI";a:1:{s:11:"translation";s:62:"Импорт жестких дисков в формате VDI";}s:24:"Import Virtual Appliance";a:1:{s:11:"translation";s:37:"Импорт конфигураций";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:76:"Включать MAC-адреса всех сетевых адаптеров";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:84:"Включать только MAC-адреса сетевого адаптера NAT";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:63:"Политика использования MAC-адресов:";}s:4:"Name";a:1:{s:11:"translation";s:6:"Имя";}s:15:"Network Adapter";a:1:{s:11:"translation";s:29:"Сетевой адаптер";}s:3:"RAM";a:1:{s:11:"translation";s:6:"ОЗУ";}s:49:"Reinitialize the MAC address of all network cards";a:1:{s:11:"translation";s:117:"Выполните повторную инициализацию MAC-адресов всех сетевых карт.";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:23:"По умолчанию";}s:29:"Select an appliance to import";a:1:{s:11:"translation";s:60:"Выберите устройство для импорта.";}s:10:"Sound Card";a:1:{s:11:"translation";s:27:"Звуковая карта";}s:24:"Storage Controller (IDE)";a:1:{s:11:"translation";s:26:"Контроллер (IDE)";}s:25:"Storage Controller (PCIe)";a:1:{s:11:"translation";s:57:"Контроллер хранения данных (PCIe)";}s:24:"Storage Controller (SAS)";a:1:{s:11:"translation";s:26:"Контроллер (SAS)";}s:25:"Storage Controller (SATA)";a:1:{s:11:"translation";s:27:"Контроллер (SATA)";}s:25:"Storage Controller (SCSI)";a:1:{s:11:"translation";s:27:"Контроллер (SCSI)";}s:31:"Storage Controller (VirtioSCSI)";a:1:{s:11:"translation";s:33:"Контроллер (VirtioSCSI)";}s:245:"These are the virtual machines contained in the appliance and the suggested settings of the imported VirtualBox machines. You can change many of the properties shown by double-clicking on the items and disable others using the check boxes below.";a:1:{s:11:"translation";s:445:"Далее перечислены виртуальные машины и их устройства, описанные в импортируемой конфигурации. Большинство из указанных параметров можно изменить двойным щелчком мыши на выбранном элементе, либо отключить используя соответствующие галочки.";}s:14:"USB Controller";a:1:{s:11:"translation";s:24:"USB-контроллер";}s:18:"Virtual Disk Image";a:1:{s:11:"translation";s:44:"Виртуальный образ диска";}s:17:"Virtual System %1";a:1:{s:11:"translation";s:40:"Виртуальная система %1";}s:143:"VirtualBox currently supports importing appliances saved in the Open Virtualization Format (OVF). To continue, select the file to import below.";a:1:{s:11:"translation";s:309:"В настоящее время VirtualBox поддерживает импорт виртуальных машин, сохраненных в формате Формат открытой виртуализации (OVF). Для продолжения выберите файл для импорта ниже.";}s:9:"Warnings:";a:1:{s:11:"translation";s:29:"Предупреждения:";}}}s:13:"UIWizardNewVD";a:1:{s:8:"messages";a:27:{s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:534:"Файл жесткого диска с <b>динамическим распределением</b> пространства будет использовать место на вашем физическом жестком диске только по мере его заполнения (до максимального <b>фиксированного размера</b>), однако он не будет автоматически уменьшаться в размере при освобождении места на нем.";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:313:"Создание файла жесткого диска <b>фиксированного размера</b> может занять больше времени на некоторых системах, но в дальнейшем его использование часто оказывается быстрее.";}s:51:"Choose a location for new virtual hard disk file...";a:1:{s:11:"translation";s:112:"Выбрать местоположение нового виртуального жёсткого диска...";}s:52:"Choose a location for new virtual hard drive file...";a:1:{s:11:"translation";s:132:"Выберите местоположение для нового файла виртуального жесткого диска...";}s:6:"Create";a:1:{s:11:"translation";s:14:"Создать";}s:24:"Create Virtual Hard Disk";a:1:{s:11:"translation";s:61:"Создать виртуальный жёсткий диск";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:39:"Динамически выделено";}s:13:"File location";a:1:{s:11:"translation";s:35:"Расположение файла";}s:22:"File location and size";a:1:{s:11:"translation";s:48:"Укажите имя и размер файла";}s:9:"File size";a:1:{s:11:"translation";s:23:"Размер файла";}s:10:"Fixed size";a:1:{s:11:"translation";s:39:"Фиксированный размер";}s:25:"HDD (Parallels Hard Disk)";a:1:{s:11:"translation";s:59:"Жесткий диск (жесткий диск Parallels)";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:21:"Укажите тип";}s:8:"Location";a:1:{s:11:"translation";s:24:"Расположение";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:487:"Пожалуйста, укажите тип файла, определяющий формат, который Вы хотите использовать при создании нового жёсткого диска. Если у Вас нет необходимости использовать диск с другими продуктами программной виртуализации, Вы можете оставить данный параметр без изменений.";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:279:"Пожалуйста уточните, должен ли новый виртуальный жёсткий диск подстраивать свой размер под размер своего содержимого или быть точно заданного размера.";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:231:"Пожалуйста укажите имя нового виртуального жёсткого диска в поле снизу или используйте кнопку с иконкой папки справа от него.";}s:25:"QCOW (QEMU Copy-On-Write)";a:1:{s:11:"translation";s:54:"QCOW (копирование при записи QEMU)";}s:24:"QED (QEMU enhanced disk)";a:1:{s:11:"translation";s:77:"QED (усовершенствованный дисковый образ QEMU)";}s:167:"Select the size of the virtual hard disk in megabytes. This size is the limit on the amount of file data that a virtual machine will be able to store on the hard disk.";a:1:{s:11:"translation";s:303:"Укажите размер виртуального жёсткого диска в мегабайтах. Эта величина ограничивает размер файловых данных, которые виртуальная машина сможет хранить на этом диске.";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:70:"Разделите на файлы размером менее 2 ГБ.";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:44:"Укажите формат хранения";}s:27:"VDI (VirtualBox Disk Image)";a:1:{s:11:"translation";s:38:"VDI (образ диска VirtualBox)";}s:23:"VHD (Virtual Hard Disk)";a:1:{s:11:"translation";s:52:"VHD (виртуальный жесткий диск)";}s:27:"VMDK (Virtual Machine Disk)";a:1:{s:11:"translation";s:74:"VMDK (виртуальный диск виртуальной машины)";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:539:"Вы также можете <b>разделиться</b> файл образа жесткого диска на несколько файлов размером до двух гигабайт каждый. Это особенно полезно, если вы хотите хранить виртуальную машину на съемных USB-накопителях или старых системах, некоторые из которых не поддерживают работу с очень большими файлами.";}s:9:"undefined";a:1:{s:11:"translation";s:28:"неопределенный";}}}s:13:"UIWizardNewVM";a:1:{s:8:"messages";a:18:{s:6:"Create";a:1:{s:11:"translation";s:14:"Создать";}s:22:"Create Virtual Machine";a:1:{s:11:"translation";s:50:"Создать виртуальную машину";}s:30:"Create a virtual hard disk now";a:1:{s:11:"translation";s:88:"Создайте виртуальный жесткий диск прямо сейчас.";}s:30:"Do not add a virtual hard disk";a:1:{s:11:"translation";s:73:"Не добавляйте виртуальный жесткий диск.";}s:9:"Hard disk";a:1:{s:11:"translation";s:23:"Жесткий диск";}s:138:"If you need a more complex storage set-up you can skip this step and make the changes to the machine settings once the machine is created.";a:1:{s:11:"translation";s:287:"Если вам требуется более сложная конфигурация хранилища, вы можете пропустить этот шаг и внести изменения в настройки виртуальной машины после ее создания.";}s:63:"If you wish you can add a virtual hard disk to the new machine.";a:1:{s:11:"translation";s:154:"При желании вы можете добавить виртуальный жесткий диск к новой виртуальной машине.";}s:11:"Memory size";a:1:{s:11:"translation";s:38:"Укажите объём памяти";}s:25:"Name and operating system";a:1:{s:11:"translation";s:36:"Укажите имя и тип ОС";}s:5:"Name:";a:1:{s:11:"translation";s:7:"Имя:";}s:210:"Please choose a descriptive name for the new virtual machine and select the type of operating system you intend to install on it. The name you choose will be used throughout VirtualBox to identify this machine.";a:1:{s:11:"translation";s:413:"Пожалуйста, выберите описательное имя для новой виртуальной машины и укажите тип операционной системы, которую вы собираетесь на ней установить. Выбранное вами имя будет использоваться в VirtualBox для идентификации этой машины.";}s:86:"Select the amount of memory (RAM) in megabytes to be allocated to the virtual machine.";a:1:{s:11:"translation";s:175:"Выберите объем оперативной памяти (ОЗУ) в мегабайтах, который будет выделен виртуальной машине.";}s:44:"The recommended memory size is <b>%1 MB</b>.";a:1:{s:11:"translation";s:87:"Рекомендуемый объем памяти составляет <b>%1 МБ</b>.";}s:51:"The recommended size of the hard disk is <b>%1</b>.";a:1:{s:11:"translation";s:99:"Рекомендуемый размер жесткого диска составляет <b>%1</b>.";}s:5:"Type:";a:1:{s:11:"translation";s:7:"Тип:";}s:38:"Use an existing virtual hard disk file";a:1:{s:11:"translation";s:112:"Использовать существующий файл виртуального жесткого диска.";}s:8:"Version:";a:1:{s:11:"translation";s:13:"Версия:";}s:118:"You can either create a new hard disk file or select one from the list or from another location using the folder icon.";a:1:{s:11:"translation";s:254:"Вы можете либо создать новый файл жесткого диска, либо выбрать существующий из списка или из другого расположения, используя значок папки.";}}}}}