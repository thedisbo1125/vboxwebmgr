:"Solid-state Drive";a:1:{s:11:"translation";s:36:"ソリッドステートドライブ";}s:12:"Storage Tree";a:1:{s:11:"translation";s:24:"ストレージツリー";}s:22:"Support Discard (TRIM)";a:1:{s:11:"translation";s:31:"破棄（TRIM）をサポート";}s:86:"This base hard disk is indirectly attached using the following differencing hard disk:";a:1:{s:11:"translation";s:127:"このベースハードディスクは以下の差分ハードディスクを使用して間接的に割り当てられます:";}s:14:"Type (Format):";a:1:{s:11:"translation";s:18:"タイプ(形式):";}s:5:"Type:";a:1:{s:11:"translation";s:10:"タイプ:";}s:3:"USB";a:1:{s:11:"translation";s:3:"USB";}s:11:"USB Port %1";a:1:{s:11:"translation";s:15:"USBポート %1";}s:18:"Use Host I/O Cache";a:1:{s:11:"translation";s:41:"ホストの I/O キャッシュを使う";}s:19:"Virtio-SCSI Port %1";a:1:{s:11:"translation";s:24:"Virtio-SCSI ポート %1";}s:10:"VirtioSCSI";a:1:{s:11:"translation";s:22:"ヴィルティオSCSI";}s:13:"Virtual Size:";a:1:{s:11:"translation";s:22:"仮想的なサイズ:";}s:12:"Writethrough";a:1:{s:11:"translation";s:12:"書き込み";}}}s:23:"UIMachineSettingsSystem";a:1:{s:8:"messages";a:47:{s:6:"%1 CPU";a:1:{s:11:"translation";s:6:"%1 CPU";}s:7:"%1 CPUs";a:1:{s:11:"translation";s:11:"%1個のCPU";}s:5:"%1 MB";a:1:{s:11:"translation";s:5:"%1 MB";}s:3:"%1%";a:1:{s:11:"translation";s:3:"%1%";}s:12:"Acceleration";a:1:{s:11:"translation";s:27:"アクセラレーション";}s:22:"BIOS Logo Display Time";a:1:{s:11:"translation";s:22:"BIOSロゴ表示時間";}s:12:"Base Memory:";a:1:{s:11:"translation";s:18:"基本メモリ：";}s:11:"Boot Order:";a:1:{s:11:"translation";s:15:"起動順序：";}s:8:"Chipset:";a:1:{s:11:"translation";s:21:"チップセット：";}s:7:"Default";a:1:{s:11:"translation";s:15:"デフォルト";}s:22:"Disable host time sync";a:1:{s:11:"translation";s:39:"ホスト時刻同期を無効にする";}s:30:"Enable EFI (special OSes only)";a:1:{s:11:"translation";s:44:"EFIを有効にする（特定のOSのみ）";}s:15:"Enable I/O APIC";a:1:{s:11:"translation";s:26:"I/O APICを有効にする";}s:18:"Enable Large Pages";a:1:{s:11:"translation";s:36:"ラージページを有効にする";}s:20:"Enable Nested Paging";a:1:{s:11:"translation";s:51:"ネストされたページングを有効にする";}s:24:"Enable Nested VT-x/AMD-V";a:1:{s:11:"translation";s:48:"ネストされた VT-x/AMD-V を有効にする";}s:13:"Enable PAE/NX";a:1:{s:11:"translation";s:24:"PAE/NXを有効にする";}s:18:"Enable Page Fusion";a:1:{s:11:"translation";s:45:"ページフュージョンを有効にする";}s:29:"Enable VT-x VPID (Intel only)";a:1:{s:11:"translation";s:63:"VT-x VPID を有効にする（Intel製プロセッサのみ）";}s:34:"Enable VT-x unrestricted execution";a:1:{s:11:"translation";s:38:"VT-x 無制限実行を有効にする";}s:17:"Enable VT-x/AMD-V";a:1:{s:11:"translation";s:28:"VT-x/AMD-Vを有効にする";}s:14:"Execution Cap:";a:1:{s:11:"translation";s:15:"実行上限：";}s:18:"Extended Features:";a:1:{s:11:"translation";s:13:"拡張機能:";}s:6:"Floppy";a:1:{s:11:"translation";s:15:"フロッピー";}s:33:"HPET (high precision event timer)";a:1:{s:11:"translation";s:43:"HPET（高精度イベントタイマー）";}s:9:"Hard Disk";a:1:{s:11:"translation";s:21:"ハードディスク";}s:26:"Hardware Clock in UTC Time";a:1:{s:11:"translation";s:60:"ハードウェアクロックはUTC時間で動作します";}s:24:"Hardware Virtualization:";a:1:{s:11:"translation";s:22:"仮想化支援機能:";}s:6:"HyperV";a:1:{s:11:"translation";s:13:"ハイパーV";}s:4:"ICH9";a:1:{s:11:"translation";s:4:"ICH9";}s:3:"KVM";a:1:{s:11:"translation";s:3:"KVM";}s:6:"Legacy";a:1:{s:11:"translation";s:6:"遺産";}s:2:"MB";a:1:{s:11:"translation";s:2:"MB";}s:7:"Minimal";a:1:{s:11:"translation";s:9:"最小限";}s:11:"Motherboard";a:1:{s:11:"translation";s:18:"マザーボード";}s:7:"Network";a:1:{s:11:"translation";s:18:"ネットワーク";}s:4:"None";a:1:{s:11:"translation";s:6:"なし";}s:7:"Optical";a:1:{s:11:"translation";s:6:"光学";}s:5:"PIIX3";a:1:{s:11:"translation";s:5:"PIIX3";}s:55:"Page Fusion currently not supported by VirtualBox 7.2.x";a:1:{s:11:"translation";s:98:"ページフュージョンは現在、VirtualBox 7.2.x ではサポートされていません。";}s:29:"Paravirtualization Interface:";a:1:{s:11:"translation";s:39:"準仮想化インターフェース：";}s:9:"Processor";a:1:{s:11:"translation";s:18:"プロセッサー";}s:13:"Processor(s):";a:1:{s:11:"translation";s:18:"プロセッサ：";}s:22:"Reset Secure Boot Keys";a:1:{s:11:"translation";s:42:"セキュアブートキーのリセット";}s:11:"Secure Boot";a:1:{s:11:"translation";s:21:"セキュアブート";}s:3:"TPM";a:1:{s:11:"translation";s:3:"TPM";}s:14:"Use Native API";a:1:{s:11:"translation";s:33:"ネイティブAPIを使用する";}}}s:20:"UIMachineSettingsUSB";a:1:{s:8:"messages";a:12:{s:16:"Add Empty Filter";a:1:{s:11:"translation";s:30:"空のフィルターを追加";}s:22:"Add Filter From Device";a:1:{s:11:"translation";s:42:"デバイスからフィルターを追加";}s:11:"Edit Filter";a:1:{s:11:"translation";s:30:"フィルターを編集する";}s:21:"Enable USB Controller";a:1:{s:11:"translation";s:42:"USBコントローラーを有効にする";}s:16:"Move Filter Down";a:1:{s:11:"translation";s:30:"フィルターを下に移動";}s:14:"Move Filter Up";a:1:{s:11:"translation";s:30:"フィルターを上に移動";}s:13:"New Filter %1";a:1:{s:11:"translation";s:27:"新しいフィルター %1";}s:13:"Remove Filter";a:1:{s:11:"translation";s:24:"フィルターを除去";}s:25:"USB 1.1 (OHCI) Controller";a:1:{s:11:"translation";s:36:"USB 1.1 (OHCI) コントローラー";}s:25:"USB 2.0 (EHCI) Controller";a:1:{s:11:"translation";s:36:"USB 2.0 (EHCI) コントローラー";}s:25:"USB 3.0 (xHCI) Controller";a:1:{s:11:"translation";s:36:"USB 3.0 (xHCI) コントローラー";}s:18:"USB Device Filters";a:1:{s:11:"translation";s:30:"USBデバイスフィルター";}}}s:33:"UIMachineSettingsUSBFilterDetails";a:1:{s:8:"messages";a:13:{s:3:"Any";a:1:{s:11:"translation";s:12:"どれでも";}s:13:"Manufacturer:";a:1:{s:11:"translation";s:12:"製造元：";}s:5:"Name:";a:1:{s:11:"translation";s:7:"名前:";}s:2:"No";a:1:{s:11:"translation";s:9:"いいえ";}s:5:"Port:";a:1:{s:11:"translation";s:12:"ポート：";}s:11:"Product ID:";a:1:{s:11:"translation";s:11:"製品ID：";}s:8:"Product:";a:1:{s:11:"translation";s:9:"製品：";}s:7:"Remote:";a:1:{s:11:"translation";s:15:"リモート：";}s:9:"Revision:";a:1:{s:11:"translation";s:18:"リビジョン：";}s:11:"Serial No.:";a:1:{s:11:"translation";s:21:"シリアル番号：";}s:18:"USB Filter Details";a:1:{s:11:"translation";s:25:"USB フィルター詳細";}s:10:"Vendor ID:";a:1:{s:11:"translation";s:17:"ベンダーID：";}s:3:"Yes";a:1:{s:11:"translation";s:6:"はい";}}}s:15:"UIMessageCenter";a:1:{s:8:"messages";a:63:{s:111:"<b>Note:</b> this interface may be in use by one or more virtual network adapters belonging to one of your VMs.";a:1:{s:11:"translation";s:200:"<b>注：</b>このインターフェースは、お客様の仮想マシンに属する1つ以上の仮想ネットワークアダプターによって使用されている可能性があります。";}s:70:"<nobr>%1</nobr><br><nobr>%2 since %3</nobr><br><nobr>Session %4</nobr>";a:1:{s:11:"translation";s:83:"<nobr>%1</nobr><br><nobr>%2（%3以降）</nobr><br><nobr>セッション %4</nobr>";}s:75:"A file named <b>%1</b> already exists. Are you sure you want to replace it?";a:1:{s:11:"translation";s:109:"<b>%1</b> という名前のファイルが既に存在します。上書きしてもよろしいですか？";}s:13:"ACPI Shutdown";a:1:{s:11:"translation";s:25:"ACPIシャットダウン";}s:179:"After it is removed, these adapters will no longer be usable until you correct their settings by either choosing a different interface name or a different adapter attachment type.";a:1:{s:11:"translation";s:216:"これらのアダプターは、削除後、インターフェース名を変更するか、アダプターの接続タイプを変更するなどして設定を修正するまで、使用できなくなります。";}s:83:"Are you sure you want to discard the saved state of the following virtual machines?";a:1:{s:11:"translation";s:81:"以下の仮想マシンの保存状態を破棄してもよろしいですか？";}s:4:"Back";a:1:{s:11:"translation";s:6:"戻る";}s:6:"Cancel";a:1:{s:11:"translation";s:15:"キャンセル";}s:87:"Cannot create the machine folder <b>%1</b> in the parent folder <nobr><b>%2</b>.</nobr>";a:1:{s:11:"translation";s:110:"親フォルダー <nobr><b>%2</b></nobr> 内にマシンフォルダー <b>%1</b> を作成できません。";}s:11:"Choose disk";a:1:{s:11:"translation";s:39:"ディスクを選択してください";}s:20:"Choose existing disk";a:1:{s:11:"translation";s:48:"既存のディスクを選択してください";}s:5:"Close";a:1:{s:11:"translation";s:9:"閉じる";}s:8:"Continue";a:1:{s:11:"translation";s:9:"続ける";}s:6:"Create";a:1:{s:11:"translation";s:6:"作成";}s:15:"Create new disk";a:1:{s:11:"translation";s:36:"新しいディスクを作成する";}s:6:"Delete";a:1:{s:11:"translation";s:6:"削除";}s:16:"Delete all files";a:1:{s:11:"translation";s:33:"すべてのファイルを削除";}s:93:"Deleting this host-only network will remove the host-only interface this network is based on.";a:1:{s:11:"translation";s:186:"このホストオンリーネットワークを削除すると、このネットワークの基盤となっているホストオンリーインターフェースも削除されます。";}s:7:"Details";a:1:{s:11:"translation";s:6:"詳細";}s:7:"Discard";a:1:{s:11:"translation";s:6:"破棄";}s:63:"Do you really want to power off the following virtual machines?";a:1:{s:11:"translation";s:72:"以下の仮想マシンを本当にシャットダウンしますか？";}s:59:"Do you really want to reset the following virtual machines?";a:1:{s:11:"translation";s:63:"以下の仮想マシンを本当にリセットしますか？";}s:85:"Do you really want to send an ACPI shutdown signal to the following virtual machines?";a:1:{s:11:"translation";s:100:"以下の仮想マシンにACPIシャットダウン信号を送信してもよろしいですか？";}s:79:"Do you want to remove the (host-only network) interface <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:109:"ホストオンリーネットワークインターフェース<nobr><b>%1</b></nobr>を削除しますか？";}s:61:"Do you want to remove the NAT network <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:67:"NATネットワーク<nobr><b>%1</b></nobr>を削除しますか？";}s:124:"Doing this will also remove the files containing the machine's virtual hard disks if they are not in use by another machine.";a:1:{s:11:"translation";s:162:"この操作を行うと、別のマシンで使用されていない限り、マシンの仮想ハードディスクを含むファイルも削除されます。";}s:82:"Failed to send the ACPI Power Button press event to the virtual machine <b>%1</b>.";a:1:{s:11:"translation";s:103:"仮想マシン<b>"%1"</b>への電源ボタン オフのACPIイベント送信に失敗しました。";}s:122:"Failed to update Guest Additions. The Guest Additions installation image will be mounted to provide a manual installation.";a:1:{s:11:"translation";s:192:"ゲストアドオンのアップデートに失敗しました。手動インストールを行うため、ゲストアドオンのインストールイメージがマウントされます。";}s:7:"Go Back";a:1:{s:11:"translation";s:6:"戻る";}s:230:"If this network is in use by one or more virtual machine network adapters these adapters will no longer be usable until you correct their settings by either choosing a different network name or a different adapter attachment type.";a:1:{s:11:"translation";s:304:"このネットワークが1つ以上の仮想マシンネットワークアダプターで使用されている場合、ネットワーク名を変更するか、アダプターの接続タイプを変更して設定を修正するまで、これらのアダプターは使用できなくなります。";}s:96:"If you proceed your current keys will be rewritten. You may not be able to boot this VM anymore.";a:1:{s:11:"translation";s:122:"続行すると、現在のキーが上書きされます。このVMを起動できなくなる可能性があります。";}s:4:"Keep";a:1:{s:11:"translation";s:6:"保つ";}s:12:"Keep changes";a:1:{s:11:"translation";s:21:"変更を保存する";}s:11:"Leave empty";a:1:{s:11:"translation";s:24:"空欄のままにする";}s:4:"Next";a:1:{s:11:"translation";s:3:"次";}s:2:"No";a:1:{s:11:"translation";s:9:"いいえ";}s:2:"OK";a:1:{s:11:"translation";s:2:"OK";}s:2:"Ok";a:1:{s:11:"translation";s:18:"わかりました";}s:7:"Release";a:1:{s:11:"translation";s:12:"リリース";}s:15:"Reload settings";a:1:{s:11:"translation";s:30:"設定を再読み込みする";}s:6:"Remove";a:1:{s:11:"translation";s:6:"除去";}s:11:"Remove only";a:1:{s:11:"translation";s:12:"除去のみ";}s:41:"Replacing it will overwrite its contents.";a:1:{s:11:"translation";s:69:"これを置き換えると、その内容が上書きされます。";}s:7:"Restore";a:1:{s:11:"translation";s:6:"復元";}s:20:"Restore Default Keys";a:1:{s:11:"translation";s:33:"デフォルトのキーを復元";}s:185:"The VM failed to boot. This is possibly caused by not having an operating system installed or a misconfigured boot order. Maybe picking a guest OS install DVD will resolve the situation";a:1:{s:11:"translation";s:332:"仮想マシンの起動に失敗しました。これは、オペレーティングシステムがインストールされていないか、起動順序の設定が間違っていることが原因である可能性があります。ゲストOSのインストール用DVDを選択することで解決するかもしれません。";}s:62:"The machine settings were changed while you were editing them.";a:1:{s:11:"translation";s:90:"あなたが設定を編集している間に、機械の設定が変更されました。";}s:67:"This folder already exists and possibly belongs to another machine.";a:1:{s:11:"translation";s:111:"このフォルダは既に存在しており、おそらく別のコンピューターに属しています。";}s:118:"This operation is equivalent to resetting or powering off the machine without doing a proper shutdown of the guest OS.";a:1:{s:11:"translation";s:152:"この操作は、ゲストOSを適切にシャットダウンせずに、マシンをリセットまたは電源オフすることに相当します。";}s:78:"This will cause any unsaved data in applications running inside it to be lost.";a:1:{s:11:"translation";s:144:"これにより、その中で実行されているアプリケーション内の保存されていないデータはすべて失われます。";}s:96:"Would you like to choose a virtual CD/DVD disk to put in the drive or to leave it empty for now?";a:1:{s:11:"translation";s:153:"仮想CD/DVDディスクをドライブに挿入するか、今は空のままにしておくかを選択できます。どちらになさいますか？";}s:96:"Would you like to choose a virtual floppy disk to put in the drive or to leave it empty for now?";a:1:{s:11:"translation";s:150:"ドライブに挿入する仮想フロッピーディスクを選択しますか、それとも現時点では空のままにしておきますか？";}s:95:"Would you like to create a new, empty file to hold the disk contents or select an existing one?";a:1:{s:11:"translation";s:153:"ディスクの内容を保存するための新しい空のファイルを作成しますか、それとも既存のファイルを選択しますか？";}s:94:"Would you like to delete the files containing the virtual machine from your hard disk as well?";a:1:{s:11:"translation";s:87:"仮想マシンを含むファイルをハードディスクから削除しますか？";}s:74:"Would you like to reload the changed settings or to keep your own changes?";a:1:{s:11:"translation";s:117:"変更された設定を再読み込みしますか、それともご自身で行った変更を維持しますか？";}s:3:"Yes";a:1:{s:11:"translation";s:6:"はい";}s:64:"You are about to add a new CD/DVD drive to controller <b>%1</b>.";a:1:{s:11:"translation";s:93:"これからコントローラー<b>%1</b>に新しいCD/DVDドライブを追加します。";}s:64:"You are about to add a new floppy drive to controller <b>%1</b>.";a:1:{s:11:"translation";s:122:"コントローラー <b>%1</b> に新しいフロッピーディスクドライブを追加しようとしています。";}s:65:"You are about to add a virtual hard disk to controller <b>%1</b>.";a:1:{s:11:"translation";s:93:"これからコントローラー<b>%1</b>に仮想ハードディスクを追加します。";}s:262:"You are about to create a new virtual machine without a hard disk. You will not be able to install an operating system on the machine until you add one. In the mean time you will only be able to start the machine using a virtual optical disk or from the network.";a:1:{s:11:"translation";s:330:"ハードディスクなしで新しい仮想マシンを作成しようとしています。それを追加するまではオペレーティングシステムをインストールすることはできません。仮想光学ディスクか、ネットワークから起動することしかできないことを意味します。";}s:77:"You are about to remove the following virtual machines from the machine list:";a:1:{s:11:"translation";s:81:"これから以下の仮想マシンをマシンリストから削除します。";}s:50:"You are going to restore default secure boot keys.";a:1:{s:11:"translation";s:66:"デフォルトのセキュアブートキーを復元します。";}s:43:"You currently have unsaved setting changes.";a:1:{s:11:"translation";s:63:"現在、保存されていない設定変更があります。";}}}s:16:"UIProgressDialog";a:1:{s:8:"messages";a:1:{s:6:"Cancel";a:1:{s:11:"translation";s:15:"キャンセル";}}}s:17:"UISnapshotDetails";a:1:{s:8:"messages";a:41:{s:11:"%1 since %2";a:1:{s:11:"translation";s:16:"%1（%2以降）";}s:10:"%n day ago";a:1:{s:11:"translation";s:8:"%n日前";}s:11:"%n days ago";a:1:{s:11:"translation";s:8:"%n日前";}s:11:"%n hour ago";a:1:{s:11:"translation";s:11:"%n時間前";}s:12:"%n hours ago";a:1:{s:11:"translation";s:11:"%n時間前";}s:13:"%n minute ago";a:1:{s:11:"translation";s:8:"%n分前";}s:14:"%n minutes ago";a:1:{s:11:"translation";s:8:"%n分前";}s:13:"%n second ago";a:1:{s:11:"translation";s:8:"%n秒前";}s:14:"%n seconds ago";a:1:{s:11:"translation";s:8:"%n秒前";}s:64:"Are you sure you want to delete the selected snapshot <b>%1</b>?";a:1:{s:11:"translation";s:87:"選択したスナップショット<b>%1</b>を削除してもよろしいですか？";}s:65:"Are you sure you want to restore snapshot <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:90:"スナップショット <nobr><b>%1</b></nobr> を復元してもよろしいですか？";}s:45:"Automatically start the machine after restore";a:1:{s:11:"translation";s:48:"復元後、自動的にマシンを起動する";}s:46:"Create a snapshot of the current machine state";a:1:{s:11:"translation";s:63:"現在のマシンの状態のスナップショットを作成";}s:13:"Current State";a:1:{s:11:"translation";s:15:"現在の状況";}s:23:"Current State (changed)";a:1:{s:11:"translation";s:33:"現在の状態（変更済み）";}s:15:"Delete Snapshot";a:1:{s:11:"translation";s:33:"スナップショットを削除";}s:212:"Deleting the snapshot will cause the state information saved in it to be lost, and storage data spread over several image files that VirtualBox has created together with the snapshot will be merged into one file.";a:1:{s:11:"translation";s:290:"スナップショットを削除すると、そこに保存されている状態情報が失われ、VirtualBoxがスナップショットとともに作成した複数のイメージファイルに分散されていたストレージデータが1つのファイルに統合されます。";}s:12:"Description:";a:1:{s:11:"translation";s:9:"説明：";}s:18:"Details of %1 (%2)";a:1:{s:11:"translation";s:19:"%1（%2）の詳細";}s:8:"Details:";a:1:{s:11:"translation";s:7:"詳細:";}s:89:"If you do not do this the current state will be permanently lost. Do you wish to proceed?";a:1:{s:11:"translation";s:102:"この操作を行わない場合、現在の状態は完全に失われます。続行しますか？";}s:5:"Name:";a:1:{s:11:"translation";s:7:"名前:";}s:25:"Power off virtual machine";a:1:{s:11:"translation";s:33:"仮想マシンの電源を切る";}s:24:"Power on virtual machine";a:1:{s:11:"translation";s:30:"仮想マシンを起動する";}s:16:"Restore Snapshot";a:1:{s:11:"translation";s:33:"スナップショットを復元";}s:12:"Show Details";a:1:{s:11:"translation";s:15:"詳細を表示";}s:11:"Snapshot %1";a:1:{s:11:"translation";s:27:"スナップショット %1";}s:20:"Snapshot Description";a:1:{s:11:"translation";s:33:"スナップショットの説明";}s:13:"Snapshot Name";a:1:{s:11:"translation";s:27:"スナップショット名";}s:32:"Take Snapshot of Virtual Machine";a:1:{s:11:"translation";s:48:"仮想マシンのスナップショット作成";}s:52:"Take a snapshot of the current virtual machine state";a:1:{s:11:"translation";s:69:"現在の仮想マシンの状態のスナップショットを作成";}s:11:"Taken at %1";a:1:{s:11:"translation";s:11:"%1で撮影";}s:11:"Taken on %1";a:1:{s:11:"translation";s:14:"撮影日：%1";}s:6:"Taken:";a:1:{s:11:"translation";s:12:"撮影日：";}s:71:"The current state differs from the state stored in the current snapshot";a:1:{s:11:"translation";s:99:"最新の状態は最新のスナップショットに保存されている状態と異なります";}s:74:"The current state is identical to the state stored in the current snapshot";a:1:{s:11:"translation";s:96:"最新の状態は最新のスナップショットに保存されている状態と同じです";}s:87:"This can be a lengthy process, and the information in the snapshot cannot be recovered.";a:1:{s:11:"translation";s:114:"これは時間がかかるプロセスであり、スナップショット内の情報は復元できません。";}s:57:"You are about to restore snapshot <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:87:"スナップショット <nobr><b>%1</b></nobr> を復元しようとしています。";}s:102:"You can create a snapshot of the current state of the virtual machine first by checking the box below.";a:1:{s:11:"translation";s:153:"まず、下のチェックボックスをオンにすることで、仮想マシンの現在の状態のスナップショットを作成できます。";}s:7:"offline";a:1:{s:11:"translation";s:15:"オフライン";}s:6:"online";a:1:{s:11:"translation";s:15:"オンライン";}}}s:9:"UIUSBMenu";a:1:{s:8:"messages";a:1:{s:22:"<no devices available>";a:1:{s:11:"translation";s:47:"<利用できるデバイスがありません>";}}}s:7:"UIUsers";a:1:{s:8:"messages";a:16:{s:8:"Add User";a:1:{s:11:"translation";s:21:"ユーザーを追加";}s:10:"Admin User";a:1:{s:11:"translation";s:21:"管理者ユーザー";}s:20:"Can administer users";a:1:{s:11:"translation";s:33:"ユーザーを管理できます";}s:15:"Change Password";a:1:{s:11:"translation";s:30:"パスワードを変更する";}s:9:"Edit User";a:1:{s:11:"translation";s:21:"ユーザーを編集";}s:29:"Invalid username or password.";a:1:{s:11:"translation";s:54:"ユーザー名またはパスワードが無効です";}s:6:"Log in";a:1:{s:11:"translation";s:12:"ログイン";}s:12:"New Password";a:1:{s:11:"translation";s:24:"新しいパスワード";}s:12:"Old Password";a:1:{s:11:"translation";s:24:"以前のパスワード";}s:8:"Password";a:1:{s:11:"translation";s:15:"パスワード";}s:11:"Remove User";a:1:{s:11:"translation";s:21:"ユーザーを削除";}s:6:"Retype";a:1:{s:11:"translation";s:9:"再入力";}s:41:"The password you have entered is invalid.";a:1:{s:11:"translation";s:48:"入力されたパスワードは無効です。";}s:44:"The passwords you have entered do not match.";a:1:{s:11:"translation";s:54:"入力されたパスワードが一致しません。";}s:8:"Username";a:1:{s:11:"translation";s:15:"ユーザー名";}s:5:"Users";a:1:{s:11:"translation";s:12:"ユーザー";}}}s:11:"UIVMDesktop";a:1:{s:8:"messages";a:6:{s:7:"Console";a:1:{s:11:"translation";s:15:"コンソール";}s:7:"Details";a:1:{s:11:"translation";s:6:"詳細";}s:13:"Host Reources";a:1:{s:11:"translation";s:21:"ホストリソース";}s:10:"Loading...";a:1:{s:11:"translation";s:18:"読み込み中...";}s:9:"Saving...";a:1:{s:11:"translation";s:12:"保存中...";}s:9:"Snapshots";a:1:{s:11:"translation";s:24:"スナップショット";}}}s:13:"UIVMLogViewer";a:1:{s:8:"messages";a:2:{s:26:"%1 - VirtualBox Log Viewer";a:1:{s:11:"translation";s:33:"%1 - VirtualBoxログビューア";}s:100:"No log files found. Press the <b>Refresh</b> button to rescan the log folder <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:171:"ログファイルが見つかりませんでした。「更新」ボタンを押して、ログフォルダ <nobr><b>%1</b></nobr> を再スキャンしてください。";}}}s:17:"UIVMPreviewWindow";a:1:{s:8:"messages";a:1:{s:18:"Open in new window";a:1:{s:11:"translation";s:33:"新しいウィンドウで開く";}}}s:21:"UIVirtualMediaManager";a:1:{s:8:"messages";a:71:{s:7:"Actions";a:1:{s:11:"translation";s:15:"アクション";}s:11:"Actual Size";a:1:{s:11:"translation";s:18:"実際のサイズ";}s:3:"Add";a:1:{s:11:"translation";s:6:"追加";}s:9:"Add iSCSI";a:1:{s:11:"translation";s:14:"iSCSIを追加";}s:53:"Are you sure you want to release the disk image file:";a:1:{s:11:"translation";s:84:"ディスクイメージファイルをリリースしてもよろしいですか？";}s:91:"Are you sure you want to remove the %1 <nobr><b>%2</b></nobr> from the list of known media?";a:1:{s:11:"translation";s:102:"既知のメディア一覧から %1 <nobr><b>%2</b></nobr> を削除してもよろしいですか？";}s:12:"Attached to:";a:1:{s:11:"translation";s:13:"割り当て:";}s:32:"Choose Autostart Database folder";a:1:{s:11:"translation";s:64:"自動起動データベース フォルダーを選択します";}s:35:"Choose a default folder for new VMs";a:1:{s:11:"translation";s:62:"新しい VM のデフォルト フォルダーを選択する";}s:53:"Choose a location for new virtual floppy disk file...";a:1:{s:11:"translation";s:99:"新しい仮想フロッピーディスクファイルの保存場所を選択してください...";}s:19:"Choose medium type:";a:1:{s:11:"translation";s:51:"メディアの種類を選択してください：";}s:7:"Copy...";a:1:{s:11:"translation";s:12:"コピー...";}s:18:"Create Floppy Disk";a:1:{s:11:"translation";s:36:"フロッピーディスクの作成";}s:12:"Description:";a:1:{s:11:"translation";s:9:"説明：";}s:87:"Do you want to delete the storage unit of the virtual hard disk <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:109:"仮想ハードディスク「<nobr><b>%1</b></nobr>」のストレージユニットを削除しますか？";}s:4:"Edit";a:1:{s:11:"translation";s:6:"編集";}s:7:"Encoded";a:1:{s:11:"translation";s:21:"エンコード済み";}s:18:"Filename and Path:";a:1:{s:11:"translation";s:25:"ファイル名とパス:";}s:12:"Floppy disks";a:1:{s:11:"translation";s:27:"フロッピーディスク";}s:20:"Format disk as FAT12";a:1:{s:11:"translation";s:55:"ディスクを FAT12 としてフォーマットする";}s:7:"Format:";a:1:{s:11:"translation";s:19:"フォーマット:";}s:10:"Hard disks";a:1:{s:11:"translation";s:21:"ハードディスク";}s:79:"Hard drive has children, <b>Writethrough</b> and <b>Shareable</b> not available";a:1:{s:11:"translation";s:143:"ハードディスクには子要素があり、<b>ライトスルー</b>および<b>共有可能</b>オプションは利用できません。";}s:86:"Hard drive is attached to a VM, <b>Immutable</b> and <b>Multi-attach</b> not available";a:1:{s:11:"translation";s:149:"ハードディスクは仮想マシンに接続されていますが、<b>不変性</b>および<b>複数接続</b>機能は利用できません。";}s:53:"Hard drive is dynamic, <b>Shareable</b> not available";a:1:{s:11:"translation";s:112:"ハードディスクはダイナミックディスクであり、<b>共有機能</b>は利用できません。";}s:128:"If you select <b>Delete</b> then the specified storage unit will be permanently deleted. This operation <b>cannot be undone</b>.";a:1:{s:11:"translation";s:170:"<b>削除</b>を選択すると、指定されたストレージユニットは完全に削除されます。この操作は<b>元に戻すことはできません</b>。";}s:215:"If you select <b>Keep</b> then the hard disk will be only removed from the list of known hard disks, but the storage unit will be left untouched which makes it possible to add this hard disk to the list later again.";a:1:{s:11:"translation";s:301:"<b>保持</b>を選択すると、ハードディスクは既知のハードディスクのリストから削除されるだけで、ストレージユニット自体はそのまま残されるため、後でこのハードディスクをリストに再度追加することが可能になります。";}s:9:"Immutable";a:1:{s:11:"translation";s:6:"不変";}s:19:"Internal Networking";a:1:{s:11:"translation";s:30:"社内ネットワーキング";}s:3:"LUN";a:1:{s:11:"translation";s:6:"ルン";}s:9:"Location:";a:1:{s:11:"translation";s:7:"場所:";}s:18:"Medium attributes:";a:1:{s:11:"translation";s:21:"メディア属性：";}s:99:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to copy medium.";a:1:{s:11:"translation";s:192:"メディアは、「実行中」、「一時停止中」、または「保存済み」の状態にある仮想マシンに接続されています。メディアをコピーできません。";}s:102:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to release medium.";a:1:{s:11:"translation";s:189:"メディアは、「実行中」、「一時停止中」、または「保存済み」の状態にある仮想マシンに接続されています。メディアを解放できません。";}s:24:"Modify medium attributes";a:1:{s:11:"translation";s:33:"メディア属性を変更する";}s:9:"Modify...";a:1:{s:11:"translation";s:15:"修正する...";}s:12:"Multi-Attach";a:1:{s:11:"translation";s:21:"マルチアタッチ";}s:11:"MultiAttach";a:1:{s:11:"translation";s:21:"マルチアタッチ";}s:4:"Name";a:1:{s:11:"translation";s:6:"名前";}s:3:"New";a:1:{s:11:"translation";s:9:"新しい";}s:6:"Normal";a:1:{s:11:"translation";s:6:"普通";}s:113:"Note that the storage unit of this medium will not be deleted and that it will be possible to use it later again.";a:1:{s:11:"translation";s:114:"このメディアの記憶装置は削除されず、後で再び使用できることにご注意ください。";}s:13:"Optical disks";a:1:{s:11:"translation";s:15:"光ディスク";}s:8:"Password";a:1:{s:11:"translation";s:15:"パスワード";}s:95:"Please choose one of the following modes and press <b>%2</b> to proceed or <b>%3</b> otherwise.";a:1:{s:11:"translation";s:147:"以下のモードからいずれかを選択し、続行する場合は<b>%2</b>を、それ以外の場合は<b>%3</b>を押してください。";}s:4:"Port";a:1:{s:11:"translation";s:9:"ポート";}s:8:"Readonly";a:1:{s:11:"translation";s:18:"読み取り専用";}s:7:"Refresh";a:1:{s:11:"translation";s:24:"最新の情報に更新";}s:7:"Release";a:1:{s:11:"translation";s:12:"リリース";}s:6:"Remove";a:1:{s:11:"translation";s:6:"除去";}s:12:"Rename File:";a:1:{s:11:"translation";s:27:"ファイル名の変更：";}s:6:"Search";a:1:{s:11:"translation";s:6:"検索";}s:6:"Select";a:1:{s:11:"translation";s:6:"選択";}s:42:"Select directory to create floppy image in";a:1:{s:11:"translation";s:87:"フロッピーイメージを作成するディレクトリを選択してください";}s:6:"Server";a:1:{s:11:"translation";s:9:"サーバ";}s:9:"Shareable";a:1:{s:11:"translation";s:12:"共有可能";}s:4:"Size";a:1:{s:11:"translation";s:9:"サイズ";}s:5:"Size:";a:1:{s:11:"translation";s:10:"サイズ:";}s:16:"Storage details:";a:1:{s:11:"translation";s:25:"ストレージの詳細:";}s:6:"Target";a:1:{s:11:"translation";s:15:"ターゲット";}s:69:"This will detach it from the following virtual machine(s): <b>%2</b>.";a:1:{s:11:"translation";s:84:"これにより、以下の仮想マシンから切り離されます：<b>%2</b>。";}s:5:"Type:";a:1:{s:11:"translation";s:10:"タイプ:";}s:5:"UUID:";a:1:{s:11:"translation";s:5:"UUID:";}s:8:"Username";a:1:{s:11:"translation";s:15:"ユーザー名";}s:70:"VM hard drive is attached to is running, cannot modify disk properties";a:1:{s:11:"translation";s:130:"VMのハードドライブが接続されているVMが実行中のため、ディスクプロパティを変更できません。";}s:21:"Virtual Media Manager";a:1:{s:11:"translation";s:36:"仮想メディアマネージャー";}s:12:"Virtual Size";a:1:{s:11:"translation";s:21:"仮想的なサイズ";}s:7:"Warning";a:1:{s:11:"translation";s:6:"警告";}s:8:"Warnings";a:1:{s:11:"translation";s:6:"警告";}s:12:"Writethrough";a:1:{s:11:"translation";s:12:"書き込み";}s:70:"You are about to change the settings of the disk image file <b>%1</b>.";a:1:{s:11:"translation";s:87:"これからディスクイメージファイル<b>%1</b>の設定を変更します。";}}}s:8:"UIWizard";a:1:{s:8:"messages";a:2:{s:11:"Expert Mode";a:1:{s:11:"translation";s:27:"エキスパートモード";}s:11:"Guided Mode";a:1:{s:11:"translation";s:24:"ガイド付きモード";}}}s:15:"UIWizardCloneVM";a:1:{s:8:"messages";a:31:{s:8:"%1 Clone";a:1:{s:11:"translation";s:18:"%1 のクローン";}s:5:"Clone";a:1:{s:11:"translation";s:12:"クローン";}s:13:"Clone Options";a:1:{s:11:"translation";s:27:"クローンオプション";}s:21:"Clone Virtual Machine";a:1:{s:11:"translation";s:30:"仮想マシンのクローン";}s:10:"Clone type";a:1:{s:11:"translation";s:24:"クローンのタイプ";}s:20:"Cloned Machine Name:";a:1:{s:11:"translation";s:42:"クローンされたマシンの名前：";}s:21:"Current machine state";a:1:{s:11:"translation";s:24:"現在の機械の状態";}s:28:"Current snapshot tree branch";a:1:{s:11:"translation";s:54:"現在のスナップショットツリーブランチ";}s:10:"Everything";a:1:{s:11:"translation";s:9:"すべて";}s:10:"Full Clone";a:1:{s:11:"translation";s:18:"フルクローン";}s:51:"Generate new MAC addresses for all network adapters";a:1:{s:11:"translation";s:72:"すべてのネットワークアダプターでMACアドレスを生成";}s:142:"If you choose <b>Current machine state</b>, the new machine will reflect the current state of the original machine and will have no snapshots.";a:1:{s:11:"translation";s:196:"<b>現在のマシンの状態</b>を選択した場合、新しいマシンは元のマシンの現在の状態を反映したものとなり、スナップショットは作成されません。";}s:246:"If you choose <b>Current snapshot tree branch</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the tree branch starting at the current state in the original machine.";a:1:{s:11:"translation";s:337:"<b>現在のスナップショットツリーブランチ</b>を選択した場合、新しいマシンは元のマシンの現在の状態を反映し、元のマシンの現在の状態から始まるツリーブランチ内のすべてのスナップショットに対応するスナップショットを持つことになります。";}s:179:"If you choose <b>Everything</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the original machine.";a:1:{s:11:"translation";s:232:"<b>すべて</b>を選択した場合、新しいマシンは元のマシンの現在の状態を反映し、元のマシンにあるすべてのスナップショットに対応するスナップショットが作成されます。";}s:135:"If you choose <b>Full clone</b>, an exact copy (including all virtual hard disk files) of the original virtual machine will be created.";a:1:{s:11:"translation";s:178:"<b>フルクローン</b>を選択すると、元の仮想マシンの完全なコピー（すべての仮想ハードディスクファイルを含む）が作成されます。";}s:279:"If you choose <b>Linked clone</b>, a new machine will be created, but the virtual hard disk files will be tied to the virtual hard disk files of original machine and you will not be able to move the new virtual machine to a different computer without moving the original as well.";a:1:{s:11:"translation";s:397:"<b>リンククローン</b>を選択した場合、新しい仮想マシンが作成されますが、その仮想ハードディスクファイルは元の仮想マシンの仮想ハードディスクファイルにリンクされるため、元の仮想マシンも一緒に移動しない限り、新しい仮想マシンを別のコンピューターに移動することはできません。";}s:136:"If you create a <b>Linked clone</b>, then a new snapshot will be created in the original virtual machine as part of the cloning process.";a:1:{s:11:"translation";s:181:"<b>リンククローン</b>を作成すると、クローン作成プロセスの一環として、元の仮想マシンに新しいスナップショットが作成されます。";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:72:"すべてのネットワークアダプターのMACアドレスを含む";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:69:"NATネットワークアダプターのMACアドレスのみを含む";}s:15:"Keep Disk Names";a:1:{s:11:"translation";s:30:"ディスク名を保持する";}s:19:"Keep Hardware UUIDs";a:1:{s:11:"translation";s:37:"ハードウェアUUIDを保持する";}s:25:"Linked Base for %1 and %2";a:1:{s:11:"translation";s:37:"%1 と %2 を基準にリンクする";}s:12:"Linked Clone";a:1:{s:11:"translation";s:30:"リンクされたクローン";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:30:"MACアドレスポリシー：";}s:16:"New machine name";a:1:{s:11:"translation";s:21:"新しいマシン名";}s:49:"Please choose a name for the new virtual machine.";a:1:{s:11:"translation";s:63:"新しい仮想マシンの名前を選択してください。";}s:51:"Please choose the type of clone you wish to create.";a:1:{s:11:"translation";s:66:"作成したいクローンの種類を選択してください。";}s:81:"Please choose which parts of the snapshot tree should be cloned with the machine.";a:1:{s:11:"translation";s:123:"スナップショットツリーのどの部分をマシンと一緒にクローンするかを選択してください。";}s:9:"Snapshots";a:1:{s:11:"translation";s:24:"スナップショット";}s:57:"The new machine will be a clone of the machine <b>%1</b>.";a:1:{s:11:"translation";s:75:"新しいマシンは、マシン<b>%1</b>のクローンになります。";}s:9:"undefined";a:1:{s:11:"translation";s:9:"未定義";}}}s:14:"UIWizardCopyVD";a:1:{s:8:"messages";a:19:{s:7:"%1_copy";a:1:{s:11:"translation";s:12:"%1_コピー";}s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:374:"<b>動的に割り当てられ</b>るハードディスクファイルは、物理ハードディスク上の容量を、ファイルがデータで満たされていくにつれて使用していきます（最大<b>固定サイズ</b>まで）。ただし、ファイル内の容量が解放されても、自動的にサイズが縮小されることはありません。";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:202:"<b>固定サイズ</b>のハードディスクファイルは、システムによっては作成に時間がかかる場合がありますが、使用する際の速度は速いことが多いです。";}s:42:"Choose a virtual hard disk file to copy...";a:1:{s:11:"translation";s:84:"コピーする仮想ハードディスクファイルを選択してください...";}s:43:"Choose a virtual hard drive file to copy...";a:1:{s:11:"translation";s:84:"コピーする仮想ハードディスクファイルを選択してください...";}s:4:"Copy";a:1:{s:11:"translation";s:9:"コピー";}s:22:"Copy Virtual Hard Disk";a:1:{s:11:"translation";s:39:"仮想ハードディスクをコピー";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:30:"動的に割り当てられた";}s:10:"Fixed size";a:1:{s:11:"translation";s:15:"固定サイズ";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:45:"ハードディスクのファイルタイプ";}s:17:"Hard disk to copy";a:1:{s:11:"translation";s:36:"コピーするハードディスク";}s:23:"New hard disk to create";a:1:{s:11:"translation";s:45:"新しいハードディスクを作成する";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:240:"新しい仮想ハードディスクで使用したいファイルのタイプを選択してください。もしほかの仮想ソフトウェアで使用する必要がなければ、設定はそのままにしておいてください。";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:210:"新しい仮想ハードディスクファイルは使用したぶんだけ大きくなるか（可変サイズ）、または最大サイズで作成するか（固定サイズ）を選択してください。";}s:193:"Please select the virtual hard disk file that you would like to copy if it is not already selected. You can either choose one from the list or use the folder icon beside the list to select one.";a:1:{s:11:"translation";s:276:"コピーしたい仮想ハードディスクファイルがまだ選択されていない場合は、選択してください。リストからファイルを選択するか、リストの横にあるフォルダアイコンを使用してファイルを選択できます。";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:225:"新しい仮想ハードディスクファイルの名前を下のボックスに入力するか、フォルダーアイコンをクリックしてファイルを作成する別のフォルダーを選択してください。";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:39:"2GB未満のファイルに分割する";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:51:"物理ハードディスクにあるストレージ";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:413:"また、ハードディスクのファイルをそれぞれ最大2ギガバイトの複数のファイルに<b>分割</b>することもできます。これは、仮想マシンをリムーバブルUSBデバイスや古いシステムに保存したい場合に特に便利です。これらのデバイスやシステムの中には、非常に大きなファイルを扱えないものがあるからです。";}}}s:17:"UIWizardExportApp";a:1:{s:8:"messages";a:34:{s:20:"Additional Settings:";a:1:{s:11:"translation";s:15:"追加設定：";}s:25:"Appliance Export Settings";a:1:{s:11:"translation";s:48:"アプライアンスのエクスポート設定";}s:18:"Appliance settings";a:1:{s:11:"translation";s:36:"仮想アプライアンスの設定";}s:11:"Description";a:1:{s:11:"translation";s:6:"説明";}s:6:"Export";a:1:{s:11:"translation";s:18:"エクスポート";}s:24:"Export Virtual Appliance";a:1:{s:11:"translation";s:48:"仮想アプライアンスのエクスポート";}s:5:"File:";a:1:{s:11:"translation";s:15:"ファイル：";}s:7:"Format:";a:1:{s:11:"translation";s:19:"フォーマット:";}s:116:"If you use an <b>ova</b> extension, then all the files will be combined into one Open Virtualization Format Archive.";a:1:{s:11:"translation";s:145:"拡張子に<b>ova</b>を使用すると、すべてのファイルが1つのOpen Virtualization Formatアーカイブにまとめられます。";}s:77:"If you use an <b>ovf</b> extension, several files will be written separately.";a:1:{s:11:"translation";s:100:"<b>ovf</b>拡張子を使用する場合、複数のファイルが個別に書き込まれます。";}s:23:"Include ISO image files";a:1:{s:11:"translation";s:39:"ISOイメージファイルを含める";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:72:"すべてのネットワークアダプターのMACアドレスを含む";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:69:"NATネットワークアダプターのMACアドレスのみを含む";}s:7:"License";a:1:{s:11:"translation";s:15:"ライセンス";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:30:"MACアドレスポリシー：";}s:4:"Name";a:1:{s:11:"translation";s:6:"名前";}s:7:"OVF 0.9";a:1:{s:11:"translation";s:7:"OVF 0.9";}s:7:"OVF 1.0";a:1:{s:11:"translation";s:7:"OVF 1.0";}s:7:"OVF 2.0";a:1:{s:11:"translation";s:7:"OVF 2.0";}s:33:"Other extensions are not allowed.";a:1:{s:11:"translation";s:57:"その他の拡張機能は許可されていません。";}s:50:"Please choose a filename to export the OVF/OVA to.";a:1:{s:11:"translation";s:100:"OVF/OVAファイルをエクスポートするためのファイル名を選択してください。";}s:186:"Please select the virtual machines that should be added to the appliance. You can select more than one. Please note that these machines have to be turned off before they can be exported.";a:1:{s:11:"translation";s:249:"アプライアンスに追加する仮想マシンを選択してください。複数選択することも可能です。これらのマシンはエクスポートする前に電源をオフにする必要があることにご注意ください。";}s:7:"Product";a:1:{s:11:"translation";s:6:"製品";}s:11:"Product-URL";a:1:{s:11:"translation";s:9:"製品URL";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:27:"デフォルト値に戻す";}s:33:"Select a directory to export into";a:1:{s:11:"translation";s:69:"エクスポート先のディレクトリを選択してください";}s:39:"Strip all network adapter MAC addresses";a:1:{s:11:"translation";s:78:"すべてのネットワークアダプターのMACアドレスを削除する";}s:140:"This is the descriptive information which will be added to the virtual appliance.  You can change it by double clicking on individual lines.";a:1:{s:11:"translation";s:150:"これは仮想アプライアンスに追加する詳細な情報です。各行をダブルクリックすることによって変更できます。";}s:6:"Vendor";a:1:{s:11:"translation";s:12:"ベンダー";}s:10:"Vendor-URL";a:1:{s:11:"translation";s:15:"ベンダーURL";}s:7:"Version";a:1:{s:11:"translation";s:15:"バージョン";}s:26:"Virtual machines to export";a:1:{s:11:"translation";s:39:"エクスポートする仮想マシン";}s:19:"Write Manifest file";a:1:{s:11:"translation";s:45:"マニフェストファイルを作成する";}s:9:"undefined";a:1:{s:11:"translation";s:9:"未定義";}}}s:16:"UIWizardFirstRun";a:1:{s:8:"messages";a:6:{s:37:"Choose a virtual optical disk file...";a:1:{s:11:"translation";s:48:"仮想光学ディスクファイルの選択...";}s:127:"Please select a virtual optical disk file or a physical optical drive containing a disk to start your new virtual machine from.";a:1:{s:11:"translation";s:198:"新しい仮想マシンを起動するために使用する仮想光ディスクファイル、またはディスクが挿入された物理光ディスクドライブを選択してください。";}s:20:"Select start-up disk";a:1:{s:11:"translation";s:36:"起動ハードディスクを選択";}s:5:"Start";a:1:{s:11:"translation";s:6:"起動";}s:343:"The disk should be suitable for starting a computer from and should contain the operating system you wish to install on the virtual machine if you want to do that now. The disk will be ejected from the virtual drive automatically next time you switch the virtual machine off, but you can also do this yourself if needed using the Devices menu.";a:1:{s:11:"translation";s:474:"このディスクはコンピューターの起動に適したものであり、必要であれば、仮想マシンにインストールしたいオペレーティングシステムが含まれている必要があります。ディスクは仮想マシンを次回シャットダウンするときに仮想ドライブから自動的に取り出されますが、必要に応じて「デバイス」メニューを使用して手動で取り出すこともできます。";}s:172:"The disk should be suitable for starting a computer from. As this virtual machine has no hard drive you will not be able to install an operating system on it at the moment.";a:1:{s:11:"translation";s:267:"このディスクはコンピューターの起動に適しているはずです。ただし、この仮想マシンにはハードドライブがないため、現時点ではオペレーティングシステムをインストールすることはできません。";}}}s:17:"UIWizardImportApp";a:1:{s:8:"messages";a:35:{s:19:"Additional Options:";a:1:{s:11:"translation";s:27:"その他のオプション";}s:18:"Appliance settings";a:1:{s:11:"translation";s:36:"仮想アプライアンスの設定";}s:19:"Appliance to import";a:1:{s:11:"translation";s:51:"インポートしたい仮想アプライアンス";}s:3:"CPU";a:1:{s:11:"translation";s:3:"CPU";}s:44:"Choose a virtual appliance file to import...";a:1:{s:11:"translation";s:75:"インポートする仮想アプライアンスのファイルを選択...";}s:3:"DVD";a:1:{s:11:"translation";s:3:"DVD";}s:11:"Description";a:1:{s:11:"translation";s:6:"説明";}s:6:"Floppy";a:1:{s:11:"translation";s:15:"フロッピー";}s:51:"Generate new MAC addresses for all network adapters";a:1:{s:11:"translation";s:72:"すべてのネットワークアダプターでMACアドレスを生成";}s:13:"Guest OS Type";a:1:{s:11:"translation";s:23:"ゲストOSのタイプ";}s:6:"Import";a:1:{s:11:"translation";s:15:"インポート";}s:25:"Import Hard Drives as VDI";a:1:{s:11:"translation";s:51:"ハードドライブをVDIとしてインポート";}s:24:"Import Virtual Appliance";a:1:{s:11:"translation";s:45:"仮想アプライアンスのインポート";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:72:"すべてのネットワークアダプターのMACアドレスを含む";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:69:"NATネットワークアダプターのMACアドレスのみを含む";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:30:"MACアドレスポリシー：";}s:4:"Name";a:1:{s:11:"translation";s:6:"名前";}s:15:"Network Adapter";a:1:{s:11:"translation";s:33:"ネットワークアダプター";}s:3:"RAM";a:1:{s:11:"translation";s:3:"RAM";}s:49:"Reinitialize the MAC address of all network cards";a:1:{s:11:"translation";s:84:"すべてのネットワークカードのMACアドレスを再初期化します。";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:27:"デフォルト値に戻す";}s:29:"Select an appliance to import";a:1:{s:11:"translation";s:69:"インポートするアプライアンスを選択してください";}s:10:"Sound Card";a:1:{s:11:"translation";s:21:"サウンドカード";}s:24:"Storage Controller (IDE)";a:1:{s:11:"translation";s:42:"ストレージコントローラー (IDE)";}s:25:"Storage Controller (PCIe)";a:1:{s:11:"translation";s:46:"ストレージコントローラー（PCIe）";}s:24:"Storage Controller (SAS)";a:1:{s:11:"translation";s:42:"ストレージコントローラー (SAS)";}s:25:"Storage Controller (SATA)";a:1:{s:11:"translation";s:43:"ストレージコントローラー (SATA)";}s:25:"Storage Controller (SCSI)";a:1:{s:11:"translation";s:43:"ストレージコントローラー (SCSI)";}s:31:"Storage Controller (VirtioSCSI)";a:1:{s:11:"translation";s:49:"ストレージコントローラー (VirtioSCSI)";}s:245:"These are the virtual machines contained in the appliance and the suggested settings of the imported VirtualBox machines. You can change many of the properties shown by double-clicking on the items and disable others using the check boxes below.";a:1:{s:11:"translation";s:349:"VirtualBoxにインポートする仮想アプライアンス情報で記載された仮想マシン構成です。項目をダブルクリックすると、表示されているプロパティの大部分を変更できます。また、以下のチェックボックスを使用して他のプロパティを無効にすることができます。";}s:14:"USB Controller";a:1:{s:11:"translation";s:25:"USB コントローラー";}s:18:"Virtual Disk Image";a:1:{s:11:"translation";s:30:"仮想ディスクイメージ";}s:17:"Virtual System %1";a:1:{s:11:"translation";s:21:"仮想システム %1";}s:143:"VirtualBox currently supports importing appliances saved in the Open Virtualization Format (OVF). To continue, select the file to import below.";a:1:{s:11:"translation";s:279:"VirtualBoxは現在、Open Virtualization Format（OVF）形式で保存された仮想アプライアンスのインポートをサポートしています。続行するには、以下のファイル選択画面でインポートするファイルを選択してください。";}s:9:"Warnings:";a:1:{s:11:"translation";s:7:"警告:";}}}s:13:"UIWizardNewVD";a:1:{s:8:"messages";a:27:{s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:374:"<b>動的に割り当てられ</b>るハードディスクファイルは、物理ハードディスク上の容量を、ファイルがデータで満たされていくにつれて使用していきます（最大<b>固定サイズ</b>まで）。ただし、ファイル内の容量が解放されても、自動的にサイズが縮小されることはありません。";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:202:"<b>固定サイズ</b>のハードディスクファイルは、システムによっては作成に時間がかかる場合がありますが、使用する際の速度は速いことが多いです。";}s:51:"Choose a location for new virtual hard disk file...";a:1:{s:11:"translation";s:69:"新しい仮想ハードディスクファイルの場所を選択...";}s:52:"Choose a location for new virtual hard drive file...";a:1:{s:11:"translation";s:93:"新しい仮想ハードディスクファイルの保存場所を選択してください...";}s:6:"Create";a:1:{s:11:"translation";s:6:"作成";}s:24:"Create Virtual Hard Disk";a:1:{s:11:"translation";s:36:"仮想ハードディスクの作成";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:30:"動的に割り当てられた";}s:13:"File location";a:1:{s:11:"translation";s:21:"ファイルの場所";}s:22:"File location and size";a:1:{s:11:"translation";s:33:"ファイルの場所とサイズ";}s:9:"File size";a:1:{s:11:"translation";s:21:"ファイルサイズ";}s:10:"Fixed size";a:1:{s:11:"translation";s:15:"固定サイズ";}s:25:"HDD (Parallels Hard Disk)";a:1:{s:11:"translation";s:46:"HDD（パラレルズ ハードディスク）";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:45:"ハードディスクのファイルタイプ";}s:8:"Location";a:1:{s:11:"translation";s:6:"位置";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:240:"新しい仮想ハードディスクで使用したいファイルのタイプを選択してください。もしほかの仮想ソフトウェアで使用する必要がなければ、設定はそのままにしておいてください。";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:210:"新しい仮想ハードディスクファイルは使用したぶんだけ大きくなるか（可変サイズ）、または最大サイズで作成するか（固定サイズ）を選択してください。";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:225:"新しい仮想ハードディスクファイルの名前を下のボックスに入力するか、フォルダーアイコンをクリックしてファイルを作成する別のフォルダーを選択してください。";}s:25:"QCOW (QEMU Copy-On-Write)";a:1:{s:11:"translation";s:38:"QCOW（QEMUコピーオンライト）";}s:24:"QED (QEMU enhanced disk)";a:1:{s:11:"translation";s:31:"QED（QEMU拡張ディスク）";}s:167:"Select the size of the virtual hard disk in megabytes. This size is the limit on the amount of file data that a virtual machine will be able to store on the hard disk.";a:1:{s:11:"translation";s:216:"仮想ハードディスクのサイズをメガバイト単位で指定してください。このサイズは仮想マシンがハードディスクに置くことができるファイルデータの上限です。";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:39:"2GB未満のファイルに分割する";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:51:"物理ハードディスクにあるストレージ";}s:27:"VDI (VirtualBox Disk Image)";a:1:{s:11:"translation";s:43:"VDI（VirtualBoxディスクイメージ）";}s:23:"VHD (Virtual Hard Disk)";a:1:{s:11:"translation";s:36:"VHD（仮想ハードディスク）";}s:27:"VMDK (Virtual Machine Disk)";a:1:{s:11:"translation";s:37:"VMDK（仮想マシンディスク）";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:413:"また、ハードディスクのファイルをそれぞれ最大2ギガバイトの複数のファイルに<b>分割</b>することもできます。これは、仮想マシンをリムーバブルUSBデバイスや古いシステムに保存したい場合に特に便利です。これらのデバイスやシステムの中には、非常に大きなファイルを扱えないものがあるからです。";}s:9:"undefined";a:1:{s:11:"translation";s:9:"未定義";}}}s:13:"UIWizardNewVM";a:1:{s:8:"messages";a:18:{s:6:"Create";a:1:{s:11:"translation";s:6:"作成";}s:22:"Create Virtual Machine";a:1:{s:11:"translation";s:24:"仮想マシンの作成";}s:30:"Create a virtual hard disk now";a:1:{s:11:"translation";s:63:"今すぐ仮想ハードディスクを作成してください";}s:30:"Do not add a virtual hard disk";a:1:{s:11:"translation";s:60:"仮想ハードディスクを追加しないでください";}s:9:"Hard disk";a:1:{s:11:"translation";s:21:"ハードディスク";}s:138:"If you need a more complex storage set-up you can skip this step and make the changes to the machine settings once the machine is created.";a:1:{s:11:"translation";s:165:"より複雑なストレージ設定が必要な場合は、この手順をスキップして、マシン作成後にマシンの設定を変更してください。";}s:63:"If you wish you can add a virtual hard disk to the new machine.";a:1:{s:11:"translation";s:108:"必要に応じて、新しいマシンに仮想ハードディスクを追加することもできます。";}s:11:"Memory size";a:1:{s:11:"translation";s:21:"メモリーサイズ";}s:25:"Name and operating system";a:1:{s:11:"translation";s:45:"名前とオペレーティングシステム";}s:5:"Name:";a:1:{s:11:"translation";s:7:"名前:";}s:210:"Please choose a descriptive name for the new virtual machine and select the type of operating system you intend to install on it. The name you choose will be used throughout VirtualBox to identify this machine.";a:1:{s:11:"translation";s:289:"新しい仮想マシンには分かりやすい名前を付けて、インストールするオペレーティングシステムのタイプを選択してください。ここで選択した名前は、VirtualBox全体でこの仮想マシンを識別するために使用されます。";}s:86:"Select the amount of memory (RAM) in megabytes to be allocated to the virtual machine.";a:1:{s:11:"translation";s:114:"仮想マシンに割り当てるメモリ（RAM）の容量をメガバイト単位で選択してください。";}s:44:"The recommended memory size is <b>%1 MB</b>.";a:1:{s:11:"translation";s:57:"推奨されるメモリサイズは<b>%1 MB</b>です。";}s:51:"The recommended size of the hard disk is <b>%1</b>.";a:1:{s:11:"translation";s:69:"推奨されるハードディスクのサイズは<b>%1</b>です。";}s:5:"Type:";a:1:{s:11:"translation";s:10:"タイプ:";}s:38:"Use an existing virtual hard disk file";a:1:{s:11:"translation";s:63:"既存の仮想ハードディスクファイルを使用する";}s:8:"Version:";a:1:{s:11:"translation";s:18:"バージョン：";}s:118:"You can either create a new hard disk file or select one from the list or from another location using the folder icon.";a:1:{s:11:"translation";s:216:"新しいハードディスクファイルを作成するか、リストから選択するか、またはフォルダーアイコンを使用して別の場所からファイルを選択することができます。";}}}}}