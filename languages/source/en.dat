e";}s:52:"Take a snapshot of the current virtual machine state";a:1:{s:11:"translation";s:52:"Take a snapshot of the current virtual machine state";}s:11:"Taken at %1";a:1:{s:11:"translation";s:11:"Taken at %1";}s:11:"Taken on %1";a:1:{s:11:"translation";s:11:"Taken on %1";}s:6:"Taken:";a:1:{s:11:"translation";s:6:"Taken:";}s:71:"The current state differs from the state stored in the current snapshot";a:1:{s:11:"translation";s:71:"The current state differs from the state stored in the current snapshot";}s:74:"The current state is identical to the state stored in the current snapshot";a:1:{s:11:"translation";s:74:"The current state is identical to the state stored in the current snapshot";}s:87:"This can be a lengthy process, and the information in the snapshot cannot be recovered.";a:1:{s:11:"translation";s:87:"This can be a lengthy process, and the information in the snapshot cannot be recovered.";}s:57:"You are about to restore snapshot <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:57:"You are about to restore snapshot <nobr><b>%1</b></nobr>.";}s:102:"You can create a snapshot of the current state of the virtual machine first by checking the box below.";a:1:{s:11:"translation";s:102:"You can create a snapshot of the current state of the virtual machine first by checking the box below.";}s:7:"offline";a:1:{s:11:"translation";s:7:"offline";}s:6:"online";a:1:{s:11:"translation";s:6:"online";}}}s:7:"UIUsers";a:1:{s:8:"messages";a:16:{s:8:"Add User";a:1:{s:11:"translation";s:8:"Add User";}s:10:"Admin User";a:1:{s:11:"translation";s:10:"Admin User";}s:20:"Can administer users";a:1:{s:11:"translation";s:20:"Can administer users";}s:15:"Change Password";a:1:{s:11:"translation";s:15:"Change Password";}s:9:"Edit User";a:1:{s:11:"translation";s:9:"Edit User";}s:29:"Invalid username or password.";a:1:{s:11:"translation";s:29:"Invalid username or password.";}s:6:"Log in";a:1:{s:11:"translation";s:6:"Log in";}s:12:"New Password";a:1:{s:11:"translation";s:12:"New Password";