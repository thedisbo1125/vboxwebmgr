ion";a:1:{s:11:"translation";s:12:"硬件加速";}s:22:"BIOS Logo Display Time";a:1:{s:11:"translation";s:22:"BIOS徽标显示时间";}s:12:"Base Memory:";a:1:{s:11:"translation";s:15:"基本内存：";}s:11:"Boot Order:";a:1:{s:11:"translation";s:15:"启动顺序：";}s:8:"Chipset:";a:1:{s:11:"translation";s:12:"芯片组：";}s:7:"Default";a:1:{s:11:"translation";s:6:"默认";}s:22:"Disable host time sync";a:1:{s:11:"translation";s:24:"禁用主机时间同步";}s:30:"Enable EFI (special OSes only)";a:1:{s:11:"translation";s:40:"启用 EFI（仅限特定操作系统）";}s:15:"Enable I/O APIC";a:1:{s:11:"translation";s:15:"启用 I/O APIC";}s:18:"Enable Large Pages";a:1:{s:11:"translation";s:15:"启用大页面";}s:20:"Enable Nested Paging";a:1:{s:11:"translation";s:18:"启用嵌套分页";}s:24:"Enable Nested VT-x/AMD-V";a:1:{s:11:"translation";s:23:"启用嵌套 VT-x/AMD-V";}s:13:"Enable PAE/NX";a:1:{s:11:"translation";s:13:"启用 PAE/NX";}s:18:"Enable Page Fusion";a:1:{s:11:"translation";s:18:"启用页面融合";}s:29:"Enable VT-x VPID (Intel only)";a:1:{s:11:"translation";s:46:"启用 VT-x VPID（仅限英特尔处理器）";}s:34:"Enable VT-x unrestricted execution";a:1:{s:11:"translation";s:33:"启用 VT-x 无限制执行模式";}s:17:"Enable VT-x/AMD-V";a:1:{s:11:"translation";s:17:"启用 VT-x/AMD-V";}s:14:"Execution Cap:";a:1:{s:11:"translation";s:15:"执行上限：";}s:18:"Extended Features:";a:1:{s:11:"translation";s:13:"扩展特性:";}s:6:"Floppy";a:1:{s:11:"translation";s:6:"软驱";}s:33:"HPET (high precision event timer)";a:1:{s:11:"translation";s:34:"HPET（高精度事件计时器）";}s:9:"Hard Disk";a:1:{s:11:"translation";s:6:"硬盘";}s:26:"Hardware Clock in UTC Time";a:1:{s:11:"translation";s:48:"硬件时钟采用协调世界时（UTC）时间";}s:24:"Hardware Virtualization:";a:1:{s:11:"translation";s:13:"硬件虚拟:";}s:6:"HyperV";a:1:{s:11:"translation";s:6:"HyperV";}s:4:"ICH9";a:1:{s:11:"translation";s:4:"ICH9";}s:3:"KVM";a:1:{s:11:"translation";s:3:"KVM";}s:6:"Legacy";a:1:{s:11:"translation";s:6:"遗产";}s:2:"MB";a:1:{s:11:"translation";s:2:"MB";}s:7:"Minimal";a:1:{s:11:"translation";s:9:"最小的";}s:11:"Motherboard";a:1:{s:11:"translation";s:6:"母板";}s:7:"Network";a:1:{s:11:"translation";s:6:"网络";}s:4:"None";a:1:{s:11:"translation";s:3:"空";}s:7:"Optical";a:1:{s:11:"translation";s:9:"光学的";}s:5:"PIIX3";a:1:{s:11:"translation";s:5:"PIIX3";}s:55:"Page Fusion currently not supported by VirtualBox 7.2.x";a:1:{s:11:"translation";s:53:"VirtualBox 7.2.x 目前不支持页面融合功能。";}s:29:"Paravirtualization Interface:";a:1:{s:11:"translation";s:21:"半虚拟化接口：";}s:9:"Processor";a:1:{s:11:"translation";s:9:"处理器";}s:13:"Processor(s):";a:1:{s:11:"translation";s:12:"处理器：";}s:3:"TPM";a:1:{s:11:"translation";s:3:"TPM";}}}s:20:"UIMachineSettingsUSB";a:1:{s:8:"messages";a:12:{s:16:"Add Empty Filter";a:1:{s:11:"translation";s:27:"添加一个空的筛选器";}s:22:"Add Filter From Device";a:1:{s:11:"translation";s:33:"从设备列表中添加筛选器";}s:11:"Edit Filter";a:1:{s:11:"translation";s:15:"编辑筛选器";}s:21:"Enable USB Controller";a:1:{s:11:"translation";s:20:"启用 USB 控制器";}s:16:"Move Filter Down";a:1:{s:11:"translation";s:21:"向下移动筛选器";}s:14:"Move Filter Up";a:1:{s:11:"translation";s:21:"向上移动筛选器";}s:13:"New Filter %1";a:1:{s:11:"translation";s:15:"新过滤器 %1";}s:13:"Remove Filter";a:1:{s:11:"translation";s:15:"删除筛选器";}s:25:"USB 1.1 (OHCI) Controller";a:1:{s:11:"translation";s:24:"USB 1.1 (OHCI) 控制器";}s:25:"USB 2.0 (EHCI) Controller";a:1:{s:11:"translation";s:24:"USB 2.0 (EHCI) 控制器";}s:25:"USB 3.0 (xHCI) Controller";a:1:{s:11:"translation";s:24:"USB 3.0 (xHCI) 控制器";}s:18:"USB Device Filters";a:1:{s:11:"translation";s:18:"USB设备过滤器";}}}s:33:"UIMachineSettingsUSBFilterDetails";a:1:{s:8:"messages";a:13:{s:3:"Any";a:1:{s:11:"translation";s:6:"任何";}s:13:"Manufacturer:";a:1:{s:11:"translation";s:12:"制造商：";}s:5:"Name:";a:1:{s:11:"translation";s:7:"名称:";}s:2:"No";a:1:{s:11:"translation";s:3:"否";}s:5:"Port:";a:1:{s:11:"translation";s:9:"港口：";}s:11:"Product ID:";a:1:{s:11:"translation";s:15:"产品编号：";}s:8:"Product:";a:1:{s:11:"translation";s:9:"产品：";}s:7:"Remote:";a:1:{s:11:"translation";s:12:"偏僻的：";}s:9:"Revision:";a:1:{s:11:"translation";s:9:"修订：";}s:11:"Serial No.:";a:1:{s:11:"translation";s:12:"序列号：";}s:18:"USB Filter Details";a:1:{s:11:"translation";s:19:"USB 筛选器明细";}s:10:"Vendor ID:";a:1:{s:11:"translation";s:14:"供应商ID：";}s:3:"Yes";a:1:{s:11:"translation";s:3:"是";}}}s:15:"UIMessageCenter";a:1:{s:8:"messages";a:58:{s:111:"<b>Note:</b> this interface may be in use by one or more virtual network adapters belonging to one of your VMs.";a:1:{s:11:"translation";s:106:"<b>注意：</b>此接口可能正在被您的一台或多台虚拟机中的虚拟网络适配器使用。";}s:70:"<nobr>%1</nobr><br><nobr>%2 since %3</nobr><br><nobr>Session %4</nobr>";a:1:{s:11:"translation";s:76:"<nobr>%1</nobr><br><nobr>%2（自 %3 起）</nobr><br><nobr>会话 %4</nobr>";}s:75:"A file named <b>%1</b> already exists. Are you sure you want to replace it?";a:1:{s:11:"translation";s:56:"文件 <b>%1</b> 已存在。您确定要替换它吗？";}s:13:"ACPI Shutdown";a:1:{s:11:"translation";s:10:"ACPI关机";}s:179:"After it is removed, these adapters will no longer be usable until you correct their settings by either choosing a different interface name or a different adapter attachment type.";a:1:{s:11:"translation";s:147:"移除后，这些适配器将无法使用，直到您通过选择不同的接口名称或不同的适配器连接类型来更正其设置为止。";}s:83:"Are you sure you want to discard the saved state of the following virtual machines?";a:1:{s:11:"translation";s:54:"您确定要放弃以下虚拟机的保存状态吗？";}s:4:"Back";a:1:{s:11:"translation";s:6:"后退";}s:6:"Cancel";a:1:{s:11:"translation";s:6:"取消";}s:87:"Cannot create the machine folder <b>%1</b> in the parent folder <nobr><b>%2</b>.</nobr>";a:1:{s:11:"translation";s:95:"无法在父文件夹 <nobr><b>%2</b></nobr> 中创建机器文件夹 <nobr><b>%1</b>。</nobr>";}s:11:"Choose disk";a:1:{s:11:"translation";s:12:"选择磁盘";}s:20:"Choose existing disk";a:1:{s:11:"translation";s:18:"选择现有磁盘";}s:5:"Close";a:1:{s:11:"translation";s:6:"关闭";}s:8:"Continue";a:1:{s:11:"translation";s:6:"继续";}s:15:"Create new disk";a:1:{s:11:"translation";s:15:"创建新磁盘";}s:6:"Delete";a:1:{s:11:"translation";s:6:"删除";}s:16:"Delete all files";a:1:{s:11:"translation";s:18:"删除所有文件";}s:93:"Deleting this host-only network will remove the host-only interface this network is based on.";a:1:{s:11:"translation";s:78:"删除此仅主机网络将同时删除该网络所基于的仅主机接口。";}s:7:"Details";a:1:{s:11:"translation";s:6:"明细";}s:7:"Discard";a:1:{s:11:"translation";s:6:"清除";}s:63:"Do you really want to power off the following virtual machines?";a:1:{s:11:"translation";s:39:"您确定要关闭以下虚拟机吗？";}s:59:"Do you really want to reset the following virtual machines?";a:1:{s:11:"translation";s:39:"您确定要重置以下虚拟机吗？";}s:85:"Do you really want to send an ACPI shutdown signal to the following virtual machines?";a:1:{s:11:"translation";s:60:"您确定要向以下虚拟机发送 ACPI 关机信号吗？";}s:79:"Do you want to remove the (host-only network) interface <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:78:"您确定要删除（仅限主机网络）接口 <nobr><b>%1</b></nobr> 吗？";}s:61:"Do you want to remove the NAT network <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:59:"您确定要删除 NAT 网络 <nobr><b>%1</b> 吗？</nobr>";}s:124:"Doing this will also remove the files containing the machine's virtual hard disks if they are not in use by another machine.";a:1:{s:11:"translation";s:117:"这样做还会删除包含该虚拟机虚拟硬盘的文件，前提是这些文件没有被其他虚拟机使用。";}s:82:"Failed to send the ACPI Power Button press event to the virtual machine <b>%1</b>.";a:1:{s:11:"translation";s:54:"发送ACPI关闭信号给虚拟电脑 <b>%1</b>失败.";}s:122:"Failed to update Guest Additions. The Guest Additions installation image will be mounted to provide a manual installation.";a:1:{s:11:"translation";s:93:"更新增强功能失败。增强功能安装映像将被挂载，以便进行手动安装。";}s:7:"Go Back";a:1:{s:11:"translation";s:6:"回去";}s:230:"If this network is in use by one or more virtual machine network adapters these adapters will no longer be usable until you correct their settings by either choosing a different network name or a different adapter attachment type.";a:1:{s:11:"translation";s:210:"如果该网络正在被一个或多个虚拟机网络适配器使用，则在您更正其设置（例如选择不同的网络名称或不同的适配器连接类型）之前，这些适配器将无法使用。";}s:4:"Keep";a:1:{s:11:"translation";s:6:"保持";}s:12:"Keep changes";a:1:{s:11:"translation";s:12:"保留更改";}s:11:"Leave empty";a:1:{s:11:"translation";s:6:"留空";}s:4:"Next";a:1:{s:11:"translation";s:9:"下一个";}s:2:"No";a:1:{s:11:"translation";s:3:"否";}s:2:"OK";a:1:{s:11:"translation";s:6:"确定";}s:7:"Release";a:1:{s:11:"translation";s:6:"发布";}s:15:"Reload settings";a:1:{s:11:"translation";s:18:"重新载入设置";}s:6:"Remove";a:1:{s:11:"translation";s:6:"删除";}s:11:"Remove only";a:1:{s:11:"translation";s:12:"只是移除";}s:41:"Replacing it will overwrite its contents.";a:1:{s:11:"translation";s:42:"替换该文件将覆盖其原有内容。";}s:7:"Restore";a:1:{s:11:"translation";s:6:"恢复";}s:185:"The VM failed to boot. This is possibly caused by not having an operating system installed or a misconfigured boot order. Maybe picking a guest OS install DVD will resolve the situation";a:1:{s:11:"translation";s:180:"虚拟机启动失败。这可能是由于未安装操作系统或启动顺序配置错误造成的。尝试选择客户机操作系统的安装光盘或许可以解决此问题。";}s:62:"The machine settings were changed while you were editing them.";a:1:{s:11:"translation";s:51:"您在编辑机器设置时，设置已被更改。";}s:67:"This folder already exists and possibly belongs to another machine.";a:1:{s:11:"translation";s:63:"此文件夹已存在，并且可能属于另一台计算机。";}s:118:"This operation is equivalent to resetting or powering off the machine without doing a proper shutdown of the guest OS.";a:1:{s:11:"translation";s:96:"此操作相当于在未正确关闭客户操作系统的情况下重置或关闭机器电源。";}s:78:"This will cause any unsaved data in applications running inside it to be lost.";a:1:{s:11:"translation";s:78:"这将导致在其中运行的应用程序中所有未保存的数据丢失。";}s:96:"Would you like to choose a virtual CD/DVD disk to put in the drive or to leave it empty for now?";a:1:{s:11:"translation";s:94:"您想选择一张虚拟光盘/DVD光盘放入驱动器，还是暂时保持驱动器为空？";}s:96:"Would you like to choose a virtual floppy disk to put in the drive or to leave it empty for now?";a:1:{s:11:"translation";s:81:"您是希望选择一张虚拟软盘放入驱动器，还是暂时将其留空？";}s:95:"Would you like to create a new, empty file to hold the disk contents or select an existing one?";a:1:{s:11:"translation";s:90:"您想创建一个新的空文件来存储磁盘内容，还是选择一个现有文件？";}s:94:"Would you like to delete the files containing the virtual machine from your hard disk as well?";a:1:{s:11:"translation";s:60:"您是否也想从硬盘中删除包含虚拟机的文件？";}s:74:"Would you like to reload the changed settings or to keep your own changes?";a:1:{s:11:"translation";s:69:"您想重新加载已更改的设置还是保留您自己的更改？";}s:3:"Yes";a:1:{s:11:"translation";s:3:"是";}s:64:"You are about to add a new CD/DVD drive to controller <b>%1</b>.";a:1:{s:11:"translation";s:70:"您即将向控制器 <b>%1</b> 添加一个新的 CD/DVD 驱动器。";}s:64:"You are about to add a new floppy drive to controller <b>%1</b>.";a:1:{s:11:"translation";s:59:"您即将向控制器 <b>%1</b> 添加一个新的软驱。";}s:65:"You are about to add a virtual hard disk to controller <b>%1</b>.";a:1:{s:11:"translation";s:59:"您即将向控制器 <b>%1</b> 添加一个虚拟硬盘。";}s:262:"You are about to create a new virtual machine without a hard disk. You will not be able to install an operating system on the machine until you add one. In the mean time you will only be able to start the machine using a virtual optical disk or from the network.";a:1:{s:11:"translation";s:191:"你将新建一个没有虚拟硬盘的虚拟电脑。 只有添加了虚拟硬盘才能在虚拟电脑中安装操作系统。 目前你只能从虚拟光驱或网络上启动虚拟电脑。";}s:77:"You are about to remove the following virtual machines from the machine list:";a:1:{s:11:"translation";s:54:"您即将从虚拟机列表中移除以下虚拟机：";}s:43:"You currently have unsaved setting changes.";a:1:{s:11:"translation";s:45:"您目前有一些未保存的设置更改。";}}}s:16:"UIProgressDialog";a:1:{s:8:"messages";a:1:{s:6:"Cancel";a:1:{s:11:"translation";s:6:"取消";}}}s:17:"UISnapshotDetails";a:1:{s:8:"messages";a:41:{s:11:"%1 since %2";a:1:{s:11:"translation";s:25:"自 %2 以来增长了 %1";}s:10:"%n day ago";a:1:{s:11:"translation";s:9:"%n 天前";}s:11:"%n days ago";a:1:{s:11:"translation";s:9:"%n 天前";}s:11:"%n hour ago";a:1:{s:11:"translation";s:12:"%n 小时前";}s:12:"%n hours ago";a:1:{s:11:"translation";s:12:"%n 小时前";}s:13:"%n minute ago";a:1:{s:11:"translation";s:12:"%n 分钟前";}s:14:"%n minutes ago";a:1:{s:11:"translation";s:12:"%n 分钟前";}s:13:"%n second ago";a:1:{s:11:"translation";s:9:"%n 秒前";}s:14:"%n seconds ago";a:1:{s:11:"translation";s:9:"%n 秒前";}s:64:"Are you sure you want to delete the selected snapshot <b>%1</b>?";a:1:{s:11:"translation";s:50:"您确定要删除选定的快照 <b>%1</b> 吗？";}s:65:"Are you sure you want to restore snapshot <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:54:"您确定要恢复快照 <nobr><b>%1</b></nobr> 吗？";}s:45:"Automatically start the machine after restore";a:1:{s:11:"translation";s:30:"恢复后自动启动机器。";}s:46:"Create a snapshot of the current machine state";a:1:{s:11:"translation";s:50:"创建当前虚拟机状态的备份[系统快照]";}s:13:"Current State";a:1:{s:11:"translation";s:12:"当前状态";}s:23:"Current State (changed)";a:1:{s:11:"translation";s:27:"当前状态（已更改）";}s:15:"Delete Snapshot";a:1:{s:11:"translation";s:12:"删除备份";}s:212:"Deleting the snapshot will cause the state information saved in it to be lost, and storage data spread over several image files that VirtualBox has created together with the snapshot will be merged into one file.";a:1:{s:11:"translation";s:177:"删除快照会导致其中保存的状态信息丢失，并且 VirtualBox 与快照一起创建的分布在多个映像文件中的存储数据将被合并到一个文件中。";}s:12:"Description:";a:1:{s:11:"translation";s:9:"描述：";}s:18:"Details of %1 (%2)";a:1:{s:11:"translation";s:23:"%1 (%2) 的详细信息";}s:8:"Details:";a:1:{s:11:"translation";s:7:"明细:";}s:89:"If you do not do this the current state will be permanently lost. Do you wish to proceed?";a:1:{s:11:"translation";s:78:"如果您不这样做，当前状态将永久丢失。您确定要继续吗？";}s:5:"Name:";a:1:{s:11:"translation";s:7:"名称:";}s:25:"Power off virtual machine";a:1:{s:11:"translation";s:15:"关闭虚拟机";}s:24:"Power on virtual machine";a:1:{s:11:"translation";s:15:"启动虚拟机";}s:16:"Restore Snapshot";a:1:{s:11:"translation";s:12:"恢复备份";}s:12:"Show Details";a:1:{s:11:"translation";s:12:"显示详情";}s:11:"Snapshot %1";a:1:{s:11:"translation";s:9:"备份 %1";}s:20:"Snapshot Description";a:1:{s:11:"translation";s:12:"快照描述";}s:13:"Snapshot Name";a:1:{s:11:"translation";s:12:"快照名称";}s:32:"Take Snapshot of Virtual Machine";a:1:{s:11:"translation";s:12:"生成备份";}s:52:"Take a snapshot of the current virtual machine state";a:1:{s:11:"translation";s:50:"创建当前虚拟机状态的备份[系统快照]";}s:11:"Taken at %1";a:1:{s:11:"translation";s:12:"拍摄于 %1";}s:11:"Taken on %1";a:1:{s:11:"translation";s:12:"拍摄于 %1";}s:6:"Taken:";a:1:{s:11:"translation";s:12:"已拍摄：";}s:71:"The current state differs from the state stored in the current snapshot";a:1:{s:11:"translation";s:54:"当前状态与最近备份中保存的状态不一致";}s:74:"The current state is identical to the state stored in the current snapshot";a:1:{s:11:"translation";s:51:"当前状态与最近备份中保存的状态一致";}s:87:"This can be a lengthy process, and the information in the snapshot cannot be recovered.";a:1:{s:11:"translation";s:75:"这可能是一个漫长的过程，而且快照中的信息无法恢复。";}s:57:"You are about to restore snapshot <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:57:"You are about to restore snapshot <nobr><b>%1</b></nobr>.";}s:102:"You can create a snapshot of the current state of the virtual machine first by checking the box below.";a:1:{s:11:"translation";s:75:"您可以勾选下方复选框，先创建虚拟机当前状态的快照。";}s:7:"offline";a:1:{s:11:"translation";s:6:"离线";}s:6:"online";a:1:{s:11:"translation";s:9:"在线的";}}}s:7:"UIUsers";a:1:{s:8:"messages";a:16:{s:8:"Add User";a:1:{s:11:"translation";s:12:"添加用户";}s:10:"Admin User";a:1:{s:11:"translation";s:15:"管理员用户";}s:20:"Can administer users";a:1:{s:11:"translation";s:18:"可以管理用户";}s:15:"Change Password";a:1:{s:11:"translation";s:12:"更改密码";}s:9:"Edit User";a:1:{s:11:"translation";s:12:"编辑用户";}s:29:"Invalid username or password.";a:1:{s:11:"translation";s:27:"用户名或密码无效。";}s:6:"Log in";a:1:{s:11:"translation";s:6:"登录";}s:12:"New Password";a:1:{s:11:"translation";s:9:"新密码";}s:12:"Old Password";a:1:{s:11:"translation";s:9:"旧密码";}s:8:"Password";a:1:{s:11:"translation";s:6:"密码";}s:11:"Remove User";a:1:{s:11:"translation";s:12:"删除用户";}s:6:"Retype";a:1:{s:11:"translation";s:12:"重新输入";}s:41:"The password you have entered is invalid.";a:1:{s:11:"translation";s:27:"您输入的密码无效。";}s:44:"The passwords you have entered do not match.";a:1:{s:11:"translation";s:30:"您输入的密码不匹配。";}s:8:"Username";a:1:{s:11:"translation";s:9:"用户名";}s:5:"Users";a:1:{s:11:"translation";s:6:"用户";}}}s:11:"UIVMDesktop";a:1:{s:8:"messages";a:5:{s:7:"Console";a:1:{s:11:"translation";s:6:"安慰";}s:7:"Details";a:1:{s:11:"translation";s:6:"明细";}s:13:"Host Reources";a:1:{s:11:"translation";s:12:"主机资源";}s:10:"Loading...";a:1:{s:11:"translation";s:12:"加载中...";}s:9:"Snapshots";a:1:{s:11:"translation";s:6:"备份";}}}s:13:"UIVMLogViewer";a:1:{s:8:"messages";a:2:{s:26:"%1 - VirtualBox Log Viewer";a:1:{s:11:"translation";s:31:"%1 - VirtualBox 日志查看器";}s:100:"No log files found. Press the <b>Refresh</b> button to rescan the log folder <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:105:"未找到日志文件。请点击<b>刷新</b>按钮重新扫描日志文件夹 <nobr><b>%1</b></nobr>。";}}}s:17:"UIVMPreviewWindow";a:1:{s:8:"messages";a:1:{s:18:"Open in new window";a:1:{s:11:"translation";s:21:"在新窗口中打开";}}}s:21:"UIVirtualMediaManager";a:1:{s:8:"messages";a:61:{s:7:"Actions";a:1:{s:11:"translation";s:6:"行动";}s:11:"Actual Size";a:1:{s:11:"translation";s:18:"实际分配空间";}s:3:"Add";a:1:{s:11:"translation";s:6:"添加";}s:9:"Add iSCSI";a:1:{s:11:"translation";s:12:"添加 iSCSI";}s:53:"Are you sure you want to release the disk image file:";a:1:{s:11:"translation";s:42:"您确定要释放磁盘映像文件吗？";}s:91:"Are you sure you want to remove the %1 <nobr><b>%2</b></nobr> from the list of known media?";a:1:{s:11:"translation";s:75:"您确定要从已知媒体列表中移除 %1 <nobr><b>%2</b></nobr> 吗？";}s:12:"Attached to:";a:1:{s:11:"translation";s:10:"分配到:";}s:19:"Choose medium type:";a:1:{s:11:"translation";s:21:"选择媒体类型：";}s:7:"Copy...";a:1:{s:11:"translation";s:9:"复制...";}s:12:"Description:";a:1:{s:11:"translation";s:9:"描述：";}s:87:"Do you want to delete the storage unit of the virtual hard disk <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:75:"您确定要删除虚拟硬盘 <nobr><b>%1</b></nobr> 的存储单元吗？";}s:7:"Encoded";a:1:{s:11:"translation";s:9:"已编码";}s:12:"Floppy disks";a:1:{s:11:"translation";s:6:"软盘";}s:7:"Format:";a:1:{s:11:"translation";s:7:"格式:";}s:10:"Hard disks";a:1:{s:11:"translation";s:6:"硬盘";}s:79:"Hard drive has children, <b>Writethrough</b> and <b>Shareable</b> not available";a:1:{s:11:"translation";s:77:"硬盘包含子项，但<b>直写模式</b>和<b>共享模式</b>不可用。";}s:86:"Hard drive is attached to a VM, <b>Immutable</b> and <b>Multi-attach</b> not available";a:1:{s:11:"translation";s:86:"硬盘已连接到虚拟机，<b>不可变</b>和<b>多重挂载</b>功能不可用。";}s:53:"Hard drive is dynamic, <b>Shareable</b> not available";a:1:{s:11:"translation";s:46:"硬盘为动态磁盘，<b>无法共享</b>。";}s:128:"If you select <b>Delete</b> then the specified storage unit will be permanently deleted. This operation <b>cannot be undone</b>.";a:1:{s:11:"translation";s:106:"如果您选择“删除”，则指定的存储单元将被永久删除。此操作<b>无法撤销</b>。";}s:215:"If you select <b>Keep</b> then the hard disk will be only removed from the list of known hard disks, but the storage unit will be left untouched which makes it possible to add this hard disk to the list later again.";a:1:{s:11:"translation";s:177:"如果您选择“保留”，则硬盘只会从已知硬盘列表中移除，但存储单元本身不会被更改，这样以后您可以再次将该硬盘添加到列表中。";}s:9:"Immutable";a:1:{s:11:"translation";s:9:"不可变";}s:19:"Internal Networking";a:1:{s:11:"translation";s:12:"内部网络";}s:3:"LUN";a:1:{s:11:"translation";s:9:"星期一";}s:9:"Location:";a:1:{s:11:"translation";s:7:"位置:";}s:18:"Medium attributes:";a:1:{s:11:"translation";s:15:"媒体属性：";}s:99:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to copy medium.";a:1:{s:11:"translation";s:117:"该介质已连接到处于“运行”、“暂停”或“已保存”状态的虚拟机。无法复制该介质。";}s:102:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to release medium.";a:1:{s:11:"translation";s:123:"该介质已连接到处于“运行中”、“已暂停”或“已保存”状态的虚拟机。无法释放该介质。";}s:24:"Modify medium attributes";a:1:{s:11:"translation";s:18:"修改介质属性";}s:9:"Modify...";a:1:{s:11:"translation";s:9:"调整...";}s:12:"Multi-Attach";a:1:{s:11:"translation";s:12:"多重附件";}s:11:"MultiAttach";a:1:{s:11:"translation";s:12:"多重附件";}s:4:"Name";a:1:{s:11:"translation";s:6:"名称";}s:3:"New";a:1:{s:11:"translation";s:6:"新的";}s:6:"Normal";a:1:{s:11:"translation";s:9:"普通的";}s:113:"Note that the storage unit of this medium will not be deleted and that it will be possible to use it later again.";a:1:{s:11:"translation";s:87:"请注意，此介质的存储单元不会被删除，以后仍然可以再次使用。";}s:13:"Optical disks";a:1:{s:11:"translation";s:6:"光盘";}s:8:"Password";a:1:{s:11:"translation";s:6:"密码";}s:95:"Please choose one of the following modes and press <b>%2</b> to proceed or <b>%3</b> otherwise.";a:1:{s:11:"translation";s:81:"请选择以下模式之一，然后按 <b>%2</b> 继续，否则按 <b>%3</b>。";}s:4:"Port";a:1:{s:11:"translation";s:6:"港口";}s:8:"Readonly";a:1:{s:11:"translation";s:6:"只读";}s:7:"Refresh";a:1:{s:11:"translation";s:6:"刷新";}s:7:"Release";a:1:{s:11:"translation";s:6:"发布";}s:6:"Remove";a:1:{s:11:"translation";s:6:"删除";}s:12:"Rename File:";a:1:{s:11:"translation";s:18:"重命名文件：";}s:6:"Select";a:1:{s:11:"translation";s:6:"选择";}s:6:"Server";a:1:{s:11:"translation";s:9:"服务器";}s:9:"Shareable";a:1:{s:11:"translation";s:12:"可分享的";}s:4:"Size";a:1:{s:11:"translation";s:6:"大小";}s:16:"Storage details:";a:1:{s:11:"translation";s:16:"存储器明细:";}s:6:"Target";a:1:{s:11:"translation";s:6:"目标";}s:69:"This will detach it from the following virtual machine(s): <b>%2</b>.";a:1:{s:11:"translation";s:57:"这将使其与以下虚拟机断开连接：<b>%2</b>。";}s:5:"Type:";a:1:{s:11:"translation";s:7:"类型:";}s:5:"UUID:";a:1:{s:11:"translation";s:5:"UUID:";}s:8:"Username";a:1:{s:11:"translation";s:9:"用户名";}s:64:"VM hard drive is attached to is running, cannot modify disk type";a:1:{s:11:"translation";s:69:"虚拟机所连接的硬盘正在运行，无法修改磁盘类型。";}s:21:"Virtual Media Manager";a:1:{s:11:"translation";s:21:"虚拟介质管理器";}s:12:"Virtual Size";a:1:{s:11:"translation";s:18:"虚拟分配空间";}s:7:"Warning";a:1:{s:11:"translation";s:6:"警告";}s:8:"Warnings";a:1:{s:11:"translation";s:6:"警告";}s:12:"Writethrough";a:1:{s:11:"translation";s:6:"直写";}s:70:"You are about to change the settings of the disk image file <b>%1</b>.";a:1:{s:11:"translation";s:56:"您即将更改磁盘映像文件 <b>%1</b> 的设置。";}}}s:8:"UIWizard";a:1:{s:8:"messages";a:2:{s:11:"Expert Mode";a:1:{s:11:"translation";s:12:"专家模式";}s:11:"Guided Mode";a:1:{s:11:"translation";s:12:"引导模式";}}}s:15:"UIWizardCloneVM";a:1:{s:8:"messages";a:31:{s:8:"%1 Clone";a:1:{s:11:"translation";s:9:"%1 副本";}s:5:"Clone";a:1:{s:11:"translation";s:6:"复制";}s:13:"Clone Options";a:1:{s:11:"translation";s:12:"克隆选项";}s:21:"Clone Virtual Machine";a:1:{s:11:"translation";s:18:"复制虚拟电脑";}s:10:"Clone type";a:1:{s:11:"translation";s:12:"副本类型";}s:20:"Cloned Machine Name:";a:1:{s:11:"translation";s:21:"克隆机器名称：";}s:21:"Current machine state";a:1:{s:11:"translation";s:18:"当前机器状态";}s:28:"Current snapshot tree branch";a:1:{s:11:"translation";s:21:"当前快照树分支";}s:10:"Everything";a:1:{s:11:"translation";s:6:"一切";}s:10:"Full Clone";a:1:{s:11:"translation";s:12:"完整克隆";}s:51:"Generate new MAC addresses for all network adapters";a:1:{s:11:"translation";s:38:"为所有网卡重新生成 MAC 地址";}s:142:"If you choose <b>Current machine state</b>, the new machine will reflect the current state of the original machine and will have no snapshots.";a:1:{s:11:"translation";s:127:"如果您选择<b>当前机器状态</b>，则新机器将反映原始机器的当前状态，并且不会包含任何快照。";}s:246:"If you choose <b>Current snapshot tree branch</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the tree branch starting at the current state in the original machine.";a:1:{s:11:"translation";s:223:"如果您选择“<b>当前快照树分支</b>”，则新虚拟机将反映原始虚拟机的当前状态，并且将包含与原始虚拟机中从当前状态开始的所有快照树分支中的快照相匹配的快照。";}s:179:"If you choose <b>Everything</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the original machine.";a:1:{s:11:"translation";s:144:"如果您选择“全部”，新机器将反映原始机器的当前状态，并且会包含与原始机器中所有快照相匹配的快照。";}s:135:"If you choose <b>Full clone</b>, an exact copy (including all virtual hard disk files) of the original virtual machine will be created.";a:1:{s:11:"translation";s:127:"如果您选择<b>完整克隆</b>，系统将创建原始虚拟机的一个精确副本（包括所有虚拟硬盘文件）。";}s:279:"If you choose <b>Linked clone</b>, a new machine will be created, but the virtual hard disk files will be tied to the virtual hard disk files of original machine and you will not be able to move the new virtual machine to a different computer without moving the original as well.";a:1:{s:11:"translation";s:243:"如果您选择“链接克隆”，系统将创建一个新虚拟机，但其虚拟硬盘文件将与原始虚拟机的虚拟硬盘文件关联，因此，如果您不移动原始虚拟机，就无法将新虚拟机移动到其他计算机。";}s:136:"If you create a <b>Linked clone</b>, then a new snapshot will be created in the original virtual machine as part of the cloning process.";a:1:{s:11:"translation";s:118:"如果您创建的是<b>链接克隆</b>，那么在克隆过程中，原始虚拟机中会创建一个新的快照。";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:32:"包含所有网卡的 MAC 地址";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:34:"仅包含 NAT 网卡的 MAC 地址";}s:15:"Keep Disk Names";a:1:{s:11:"translation";s:18:"保留磁盘名称";}s:19:"Keep Hardware UUIDs";a:1:{s:11:"translation";s:17:"保留硬件 UUID";}s:25:"Linked Base for %1 and %2";a:1:{s:11:"translation";s:25:"%1 和 %2 的链接基础";}s:12:"Linked Clone";a:1:{s:11:"translation";s:12:"链接克隆";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:18:"MAC地址策略：";}s:16:"New machine name";a:1:{s:11:"translation";s:15:"新机器名称";}s:49:"Please choose a name for the new virtual machine.";a:1:{s:11:"translation";s:42:"请为新的虚拟机选择一个名称。";}s:51:"Please choose the type of clone you wish to create.";a:1:{s:11:"translation";s:42:"请选择您想要创建的克隆类型。";}s:81:"Please choose which parts of the snapshot tree should be cloned with the machine.";a:1:{s:11:"translation";s:66:"请选择应与虚拟机一起克隆的快照树的哪些部分。";}s:9:"Snapshots";a:1:{s:11:"translation";s:6:"备份";}s:57:"The new machine will be a clone of the machine <b>%1</b>.";a:1:{s:11:"translation";s:56:"这台新机器将是机器 <b>%1</b> 的克隆版本。";}s:9:"undefined";a:1:{s:11:"translation";s:12:"不明确的";}}}s:14:"UIWizardCopyVD";a:1:{s:8:"messages";a:19:{s:7:"%1_copy";a:1:{s:11:"translation";s:9:"%1_副本";}s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:192:"动态分配的硬盘文件只会随着内容的增加而占用物理硬盘空间（最多可达一个固定的最大容量），但当文件中的空间被释放后，它不会自动缩小。";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:121:"在某些系统上，创建<b>固定大小的</b>硬盘文件可能需要更长时间，但使用起来通常会更快。";}s:42:"Choose a virtual hard disk file to copy...";a:1:{s:11:"translation";s:39:"选择要复制的虚拟硬盘文件...";}s:43:"Choose a virtual hard drive file to copy...";a:1:{s:11:"translation";s:39:"选择要复制的虚拟硬盘文件...";}s:4:"Copy";a:1:{s:11:"translation";s:6:"复制";}s:22:"Copy Virtual Hard Disk";a:1:{s:11:"translation";s:18:"复制虚拟硬盘";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:12:"动态分配";}s:10:"Fixed size";a:1:{s:11:"translation";s:12:"固定尺寸";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:24:"虚拟硬盘文件类型";}s:17:"Hard disk to copy";a:1:{s:11:"translation";s:18:"要复制的硬盘";}s:23:"New hard disk to create";a:1:{s:11:"translation";s:18:"创建新的硬盘";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:156:"请选择您想要用于新建虚拟磁盘的文件类型。如果您不需要其他虚拟化软件使用它，您可以让此设置保持不更改状态。";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:127:"请选择新建虚拟硬盘文件是应该为其使用而分配(动态分配)，还是应该创建完全分配(固定分配)。";}s:193:"Please select the virtual hard disk file that you would like to copy if it is not already selected. You can either choose one from the list or use the folder icon beside the list to select one.";a:1:{s:11:"translation";s:183:"如果尚未选择虚拟硬盘文件，请选择您想要复制的虚拟硬盘文件。您可以从列表中选择一个，也可以使用列表旁边的文件夹图标进行选择。";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:135:"请在下面的框中键入新建虚拟硬盘文件的名称，或单击文件夹图标来选择创建文件要保存到的文件夹。";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:41:"将文件分割成小于 2GB 的文件。";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:24:"存储在物理硬盘上";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:266:"您还可以选择将硬盘文件分割成多个文件，每个文件最大不超过两千兆字节。如果您想将虚拟机存储在可移动 USB 设备或旧系统中，而这些设备或系统无法处理非常大的文件，那么这种方法就特别有用。";}}}s:17:"UIWizardExportApp";a:1:{s:8:"messages";a:34:{s:20:"Additional Settings:";a:1:{s:11:"translation";s:15:"附加设置：";}s:25:"Appliance Export Settings";a:1:{s:11:"translation";s:18:"设备导出设置";}s:18:"Appliance settings";a:1:{s:11:"translation";s:24:"虚拟电脑导入设置";}s:11:"Description";a:1:{s:11:"translation";s:6:"描述";}s:6:"Export";a:1:{s:11:"translation";s:6:"导出";}s:24:"Export Virtual Appliance";a:1:{s:11:"translation";s:18:"导出虚拟电脑";}s:5:"File:";a:1:{s:11:"translation";s:9:"文件：";}s:7:"Format:";a:1:{s:11:"translation";s:7:"格式:";}s:116:"If you use an <b>ova</b> extension, then all the files will be combined into one Open Virtualization Format Archive.";a:1:{s:11:"translation";s:114:"如果您使用 <b>ova</b> 扩展名，则所有文件将被合并到一个开放虚拟化格式存档文件中。";}s:77:"If you use an <b>ovf</b> extension, several files will be written separately.";a:1:{s:11:"translation";s:72:"如果您使用 <b>ovf</b> 扩展名，则会单独写入多个文件。";}s:23:"Include ISO image files";a:1:{s:11:"translation";s:23:"包含 ISO 镜像文件";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:32:"包含所有网卡的 MAC 地址";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:34:"仅包含 NAT 网卡的 MAC 地址";}s:7:"License";a:1:{s:11:"translation";s:6:"许可";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:18:"MAC地址策略：";}s:4:"Name";a:1:{s:11:"translation";s:6:"名称";}s:7:"OVF 0.9";a:1:{s:11:"translation";s:7:"OVF 0.9";}s:7:"OVF 1.0";a:1:{s:11:"translation";s:7:"OVF 1.0";}s:7:"OVF 2.0";a:1:{s:11:"translation";s:7:"OVF 2.0";}s:33:"Other extensions are not allowed.";a:1:{s:11:"translation";s:36:"不允许使用其他扩展程序。";}s:50:"Please choose a filename to export the OVF/OVA to.";a:1:{s:11:"translation";s:48:"请选择要导出 OVF/OVA 文件的文件名。";}s:186:"Please select the virtual machines that should be added to the appliance. You can select more than one. Please note that these machines have to be turned off before they can be exported.";a:1:{s:11:"translation";s:132:"请选择要添加到设备的虚拟机。您可以选择多个虚拟机。请注意，这些虚拟机必须先关闭才能导出。";}s:7:"Product";a:1:{s:11:"translation";s:6:"产品";}s:11:"Product-URL";a:1:{s:11:"translation";s:10:"产品 URL";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:18:"恢复为默认值";}s:33:"Select a directory to export into";a:1:{s:11:"translation";s:27:"选择要导出到的目录";}s:39:"Strip all network adapter MAC addresses";a:1:{s:11:"translation";s:41:"移除所有网络适配器的 MAC 地址";}s:140:"This is the descriptive information which will be added to the virtual appliance.  You can change it by double clicking on individual lines.";a:1:{s:11:"translation";s:72:"这是导出的虚拟电脑的描述信息。双击每行可以修改。";}s:6:"Vendor";a:1:{s:11:"translation";s:9:"供应商";}s:10:"Vendor-URL";a:1:{s:11:"translation";s:13:"供应商 URL";}s:7:"Version";a:1:{s:11:"translation";s:6:"版本";}s:26:"Virtual machines to export";a:1:{s:11:"translation";s:24:"要导出的虚拟电脑";}s:19:"Write Manifest file";a:1:{s:11:"translation";s:18:"编写清单文件";}s:9:"undefined";a:1:{s:11:"translation";s:12:"不明确的";}}}s:16:"UIWizardFirstRun";a:1:{s:8:"messages";a:6:{s:37:"Choose a virtual optical disk file...";a:1:{s:11:"translation";s:33:"选择一个虚拟光盘文件...";}s:127:"Please select a virtual optical disk file or a physical optical drive containing a disk to start your new virtual machine from.";a:1:{s:11:"translation";s:105:"请选择一个虚拟光盘文件或包含光盘的物理光驱，以便从中启动您的新虚拟机。";}s:20:"Select start-up disk";a:1:{s:11:"translation";s:15:"选择启动盘";}s:5:"Start";a:1:{s:11:"translation";s:6:"启动";}s:343:"The disk should be suitable for starting a computer from and should contain the operating system you wish to install on the virtual machine if you want to do that now. The disk will be ejected from the virtual drive automatically next time you switch the virtual machine off, but you can also do this yourself if needed using the Devices menu.";a:1:{s:11:"translation";s:294:"该磁盘应可用于启动计算机，并且如果您现在想安装操作系统，则该磁盘应包含您希望安装到虚拟机上的操作系统。下次关闭虚拟机时，该磁盘将自动从虚拟驱动器中弹出，但您也可以根据需要使用“设备”菜单手动弹出。";}s:172:"The disk should be suitable for starting a computer from. As this virtual machine has no hard drive you will not be able to install an operating system on it at the moment.";a:1:{s:11:"translation";s:132:"该光盘应该适合用于启动计算机。由于这台虚拟机没有硬盘，因此您目前无法在其上安装操作系统。";}}}s:17:"UIWizardImportApp";a:1:{s:8:"messages";a:35:{s:19:"Additional Options:";a:1:{s:11:"translation";s:15:"其他选项：";}s:18:"Appliance settings";a:1:{s:11:"translation";s:24:"虚拟电脑导入设置";}s:19:"Appliance to import";a:1:{s:11:"translation";s:24:"要导入的虚拟电脑";}s:3:"CPU";a:1:{s:11:"translation";s:14:"处理器(CPU)";}s:44:"Choose a virtual appliance file to import...";a:1:{s:11:"translation";s:21:"选择一个文件...";}s:3:"DVD";a:1:{s:11:"translation";s:6:"光驱";}s:11:"Description";a:1:{s:11:"translation";s:6:"描述";}s:6:"Floppy";a:1:{s:11:"translation";s:6:"软驱";}s:51:"Generate new MAC addresses for all network adapters";a:1:{s:11:"translation";s:38:"为所有网卡重新生成 MAC 地址";}s:13:"Guest OS Type";a:1:{s:11:"translation";s:36:"虚拟电脑上的操作系统类型";}s:6:"Import";a:1:{s:11:"translation";s:6:"导入";}s:25:"Import Hard Drives as VDI";a:1:{s:11:"translation";s:22:"将硬盘导入为 VDI";}s:24:"Import Virtual Appliance";a:1:{s:11:"translation";s:18:"导入虚拟电脑";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:32:"包含所有网卡的 MAC 地址";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:34:"仅包含 NAT 网卡的 MAC 地址";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:18:"MAC地址策略：";}s:4:"Name";a:1:{s:11:"translation";s:6:"名称";}s:15:"Network Adapter";a:1:{s:11:"translation";s:15:"网络控制器";}s:3:"RAM";a:1:{s:11:"translation";s:6:"内存";}s:49:"Reinitialize the MAC address of all network cards";a:1:{s:11:"translation";s:42:"重新初始化所有网卡的MAC地址。";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:18:"恢复为默认值";}s:29:"Select an appliance to import";a:1:{s:11:"translation";s:24:"选择要导入的设备";}s:10:"Sound Card";a:1:{s:11:"translation";s:6:"声卡";}s:24:"Storage Controller (IDE)";a:1:{s:11:"translation";s:19:"IDE 硬盘控制器";}s:25:"Storage Controller (PCIe)";a:1:{s:11:"translation";s:25:"存储控制器（PCIe）";}s:24:"Storage Controller (SAS)";a:1:{s:11:"translation";s:19:"SAS 硬盘控制器";}s:25:"Storage Controller (SATA)";a:1:{s:11:"translation";s:20:"SATA 硬盘控制器";}s:25:"Storage Controller (SCSI)";a:1:{s:11:"translation";s:20:"SCSI 硬盘控制器";}s:31:"Storage Controller (VirtioSCSI)";a:1:{s:11:"translation";s:26:"VirtioSCSI 硬盘控制器";}s:245:"These are the virtual machines contained in the appliance and the suggested settings of the imported VirtualBox machines. You can change many of the properties shown by double-clicking on the items and disable others using the check boxes below.";a:1:{s:11:"translation";s:156:"这是即将导入的虚拟电脑及建议的映射关系。您可以通过双击该项目来调整其设置，或使用下面的选择框来禁用它们。";}s:14:"USB Controller";a:1:{s:11:"translation";s:13:"USB 控制器";}s:18:"Virtual Disk Image";a:1:{s:11:"translation";s:12:"虚拟硬盘";}s:17:"Virtual System %1";a:1:{s:11:"translation";s:15:"虚拟系统 %1";}s:143:"VirtualBox currently supports importing appliances saved in the Open Virtualization Format (OVF). To continue, select the file to import below.";a:1:{s:11:"translation";s:138:"VirtualBox 目前支持导入以开放虚拟化格式 (OVF) 保存的虚拟机映像。要继续，请在下方选择要导入的文件。";}s:9:"Warnings:";a:1:{s:11:"translation";s:7:"警告:";}}}s:13:"UIWizardNewVD";a:1:{s:8:"messages";a:27:{s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:192:"动态分配的硬盘文件只会随着内容的增加而占用物理硬盘空间（最多可达一个固定的最大容量），但当文件中的空间被释放后，它不会自动缩小。";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:121:"在某些系统上，创建<b>固定大小的</b>硬盘文件可能需要更长时间，但使用起来通常会更快。";}s:51:"Choose a location for new virtual hard disk file...";a:1:{s:11:"translation";s:42:"选择虚拟硬盘文件保存的位置...";}s:52:"Choose a location for new virtual hard drive file...";a:1:{s:11:"translation";s:45:"选择新虚拟硬盘文件的存储位置...";}s:6:"Create";a:1:{s:11:"translation";s:6:"创建";}s:24:"Create Virtual Hard Disk";a:1:{s:11:"translation";s:18:"创建虚拟硬盘";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:12:"动态分配";}s:13:"File location";a:1:{s:11:"translation";s:12:"文件位置";}s:22:"File location and size";a:1:{s:11:"translation";s:21:"文件位置和大小";}s:9:"File size";a:1:{s:11:"translation";s:12:"文件大小";}s:10:"Fixed size";a:1:{s:11:"translation";s:12:"固定尺寸";}s:25:"HDD (Parallels Hard Disk)";a:1:{s:11:"translation";s:28:"硬盘（Parallels 硬盘）";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:24:"虚拟硬盘文件类型";}s:8:"Location";a:1:{s:11:"translation";s:6:"位置";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:156:"请选择您想要用于新建虚拟磁盘的文件类型。如果您不需要其他虚拟化软件使用它，您可以让此设置保持不更改状态。";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:127:"请选择新建虚拟硬盘文件是应该为其使用而分配(动态分配)，还是应该创建完全分配(固定分配)。";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:135:"请在下面的框中键入新建虚拟硬盘文件的名称，或单击文件夹图标来选择创建文件要保存到的文件夹。";}s:25:"QCOW (QEMU Copy-On-Write)";a:1:{s:11:"translation";s:27:"QCOW（QEMU 写时复制）";}s:24:"QED (QEMU enhanced disk)";a:1:{s:11:"translation";s:28:"QED（QEMU增强型磁盘）";}s:167:"Select the size of the virtual hard disk in megabytes. This size is the limit on the amount of file data that a virtual machine will be able to store on the hard disk.";a:1:{s:11:"translation";s:102:"选择虚拟硬盘的大小。此大小为虚拟硬盘文件在实际硬盘中能用的极限大小。";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:41:"将文件分割成小于 2GB 的文件。";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:24:"存储在物理硬盘上";}s:27:"VDI (VirtualBox Disk Image)";a:1:{s:11:"translation";s:32:"VDI（VirtualBox 磁盘映像）";}s:23:"VHD (Virtual Hard Disk)";a:1:{s:11:"translation";s:21:"VHD（虚拟硬盘）";}s:27:"VMDK (Virtual Machine Disk)";a:1:{s:11:"translation";s:25:"VMDK（虚拟机磁盘）";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:266:"您还可以选择将硬盘文件分割成多个文件，每个文件最大不超过两千兆字节。如果您想将虚拟机存储在可移动 USB 设备或旧系统中，而这些设备或系统无法处理非常大的文件，那么这种方法就特别有用。";}s:9:"undefined";a:1:{s:11:"translation";s:12:"不明确的";}}}s:13:"UIWizardNewVM";a:1:{s:8:"messages";a:18:{s:6:"Create";a:1:{s:11:"translation";s:6:"创建";}s:22:"Create Virtual Machine";a:1:{s:11:"translation";s:18:"新建虚拟电脑";}s:30:"Create a virtual hard disk now";a:1:{s:11:"translation";s:24:"立即创建虚拟硬盘";}s:30:"Do not add a virtual hard disk";a:1:{s:11:"translation";s:27:"请勿添加虚拟硬盘。";}s:9:"Hard disk";a:1:{s:11:"translation";s:12:"虚拟硬盘";}s:138:"If you need a more complex storage set-up you can skip this step and make the changes to the machine settings once the machine is created.";a:1:{s:11:"translation";s:111:"如果您需要更复杂的存储设置，可以跳过此步骤，并在创建虚拟机后修改机器设置。";}s:63:"If you wish you can add a virtual hard disk to the new machine.";a:1:{s:11:"translation";s:60:"如果您愿意，可以为新虚拟机添加虚拟硬盘。";}s:11:"Memory size";a:1:{s:11:"translation";s:12:"内存大小";}s:25:"Name and operating system";a:1:{s:11:"translation";s:21:"名称和操作系统";}s:5:"Name:";a:1:{s:11:"translation";s:7:"名称:";}s:210:"Please choose a descriptive name for the new virtual machine and select the type of operating system you intend to install on it. The name you choose will be used throughout VirtualBox to identify this machine.";a:1:{s:11:"translation";s:180:"请为新的虚拟机选择一个描述性的名称，并选择您打算在其上安装的操作系统类型。您选择的名称将在 VirtualBox 中用于标识这台虚拟机。";}s:86:"Select the amount of memory (RAM) in megabytes to be allocated to the virtual machine.";a:1:{s:11:"translation";s:75:"选择要分配给虚拟机的内存（RAM）大小，单位为兆字节。";}s:44:"The recommended memory size is <b>%1 MB</b>.";a:1:{s:11:"translation";s:40:"建议的内存大小为 <b>%1 MB</b>。";}s:51:"The recommended size of the hard disk is <b>%1</b>.";a:1:{s:11:"translation";s:37:"建议的硬盘容量为 <b>%1</b>。";}s:5:"Type:";a:1:{s:11:"translation";s:7:"类型:";}s:38:"Use an existing virtual hard disk file";a:1:{s:11:"translation";s:33:"使用现有的虚拟硬盘文件";}s:8:"Version:";a:1:{s:11:"translation";s:9:"版本：";}s:118:"You can either create a new hard disk file or select one from the list or from another location using the folder icon.";a:1:{s:11:"translation";s:135:"您可以创建新的硬盘文件，也可以从列表中选择一个，或者使用文件夹图标从其他位置选择一个文件。";}}}}}