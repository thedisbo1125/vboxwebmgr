:{s:11:"translation";s:5:"Havn:";}s:11:"Product ID:";a:1:{s:11:"translation";s:11:"Produkt-ID:";}s:8:"Product:";a:1:{s:11:"translation";s:8:"Produkt:";}s:7:"Remote:";a:1:{s:11:"translation";s:6:"Fjern:";}s:9:"Revision:";a:1:{s:11:"translation";s:9:"Revision:";}s:11:"Serial No.:";a:1:{s:11:"translation";s:12:"Serienummer:";}s:18:"USB Filter Details";a:1:{s:11:"translation";s:24:"Detaljer om USB-filteret";}s:10:"Vendor ID:";a:1:{s:11:"translation";s:15:"Leverandør-ID:";}s:3:"Yes";a:1:{s:11:"translation";s:2:"Ja";}}}s:15:"UIMessageCenter";a:1:{s:8:"messages";a:56:{s:111:"<b>Note:</b> this interface may be in use by one or more virtual network adapters belonging to one of your VMs.";a:1:{s:11:"translation";s:132:"<b>Bemærk:</b> Denne grænseflade kan være i brug af en eller flere virtuelle netværkskort, der tilhører en af ​​dine VM'er.";}s:70:"<nobr>%1</nobr><br><nobr>%2 since %3</nobr><br><nobr>Session %4</nobr>";a:1:{s:11:"translation";s:70:"<nobr>%1</nobr><br><nobr>%2 siden %3</nobr><br><nobr>Session %4</nobr>";}s:75:"A file named <b>%1</b> already exists. Are you sure you want to replace it?";a:1:{s:11:"translation";s:86:"En fil med navnet <b>%1</b> findes allerede. Er du sikker på, at du vil erstatte den?";}s:13:"ACPI Shutdown";a:1:{s:11:"translation";s:15:"ACPI-nedlukning";}s:179:"After it is removed, these adapters will no longer be usable until you correct their settings by either choosing a different interface name or a different adapter attachment type.";a:1:{s:11:"translation";s:189:"Når de er fjernet, vil disse adaptere ikke længere være brugbare, før du retter deres indstillinger ved enten at vælge et andet grænsefladenavn eller en anden adaptertilslutningstype.";}s:83:"Are you sure you want to discard the saved state of the following virtual machines?";a:1:{s:11:"translation";s:87:"Er du sikker på, at du vil slette den gemte tilstand for følgende virtuelle maskiner?";}s:4:"Back";a:1:{s:11:"translation";s:7:"Tilbage";}s:6:"Cancel";a:1:{s:11:"translation";s:8:"Annuller";}s:87:"Cannot create the machine folder <b>%1</b> in the parent folder <nobr><b>%2</b>.</nobr>";a:1:{s:11:"translation";s:87:"Kan ikke oprette maskinmappen <b>%1</b> i den overordnede mappe <nobr><b>%2</b>.</nobr>";}s:11:"Choose disk";a:1:{s:11:"translation";s:10:"Vælg disk";}s:20:"Choose existing disk";a:1:{s:11:"translation";s:23:"Vælg eksisterende disk";}s:5:"Close";a:1:{s:11:"translation";s:3:"Luk";}s:8:"Continue";a:1:{s:11:"translation";s:8:"Fortsæt";}s:15:"Create new disk";a:1:{s:11:"translation";s:13:"Opret ny disk";}s:6:"Delete";a:1:{s:11:"translation";s:4:"Slet";}s:16:"Delete all files";a:1:{s:11:"translation";s:15:"Slet alle filer";}s:93:"Deleting this host-only network will remove the host-only interface this network is based on.";a:1:{s:11:"translation";s:108:"Hvis du sletter dette host-only-netværk, fjernes den host-only-grænseflade, som netværket er baseret på.";}s:7:"Details";a:1:{s:11:"translation";s:8:"Detaljer";}s:7:"Discard";a:1:{s:11:"translation";s:7:"Kassér";}s:63:"Do you really want to power off the following virtual machines?";a:1:{s:11:"translation";s:56:"Vil du virkelig slukke for følgende virtuelle maskiner?";}s:59:"Do you really want to reset the following virtual machines?";a:1:{s:11:"translation";s:55:"Vil du virkelig nulstille følgende virtuelle maskiner?";}s:85:"Do you really want to send an ACPI shutdown signal to the following virtual machines?";a:1:{s:11:"translation";s:81:"Vil du virkelig sende et ACPI-nedlukningssignal til følgende virtuelle maskiner?";}s:79:"Do you want to remove the (host-only network) interface <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:72:"Vil du fjerne (kun værtsnetværk)-grænsefladen <nobr><b>%1</b>?</nobr>";}s:61:"Do you want to remove the NAT network <nobr><b>%1</b>?</nobr>";a:1:{s:11:"translation";s:52:"Vil du fjerne NAT-netværket <nobr><b>%1</b>?</nobr>";}s:124:"Doing this will also remove the files containing the machine's virtual hard disks if they are not in use by another machine.";a:1:{s:11:"translation";s:118:"Dette vil også fjerne filerne, der indeholder maskinens virtuelle harddiske, hvis de ikke bruges af en anden maskine.";}s:82:"Failed to send the ACPI Power Button press event to the virtual machine <b>%1</b>.";a:1:{s:11:"translation";s:93:"Kunne ikke sende hændelsen for tryk på ACPI-strømknap til den virtuelle maskine <b>%1</b>.";}s:122:"Failed to update Guest Additions. The Guest Additions installation image will be mounted to provide a manual installation.";a:1:{s:11:"translation";s:138:"Kunne ikke opdatere Guest Additions. Installationsbilledet af Guest Additions vil blive monteret for at muliggøre en manuel installation.";}s:7:"Go Back";a:1:{s:11:"translation";s:11:"Gå tilbage";}s:230:"If this network is in use by one or more virtual machine network adapters these adapters will no longer be usable until you correct their settings by either choosing a different network name or a different adapter attachment type.";a:1:{s:11:"translation";s:249:"Hvis dette netværk bruges af en eller flere netværkskort til virtuelle maskiner, vil disse adaptere ikke længere være brugbare, før du retter deres indstillinger ved enten at vælge et andet netværksnavn eller en anden adaptertilslutningstype.";}s:4:"Keep";a:1:{s:11:"translation";s:5:"Holde";}s:12:"Keep changes";a:1:{s:11:"translation";s:17:"Behold ændringer";}s:11:"Leave empty";a:1:{s:11:"translation";s:13:"Lad stå tomt";}s:4:"Next";a:1:{s:11:"translation";s:6:"Næste";}s:2:"No";a:1:{s:11:"translation";s:3:"Nej";}s:2:"OK";a:1:{s:11:"translation";s:2:"OK";}s:7:"Release";a:1:{s:11:"translation";s:8:"Frigøre";}s:15:"Reload settings";a:1:{s:11:"translation";s:24:"Genindlæs indstillinger";}s:6:"Remove";a:1:{s:11:"translation";s:5:"Fjern";}s:11:"Remove only";a:1:{s:11:"translation";s:9:"Fjern kun";}s:41:"Replacing it will overwrite its contents.";a:1:{s:11:"translation";s:48:"Hvis du erstatter den, overskrives dens indhold.";}s:7:"Restore";a:1:{s:11:"translation";s:7:"Genskab";}s:185:"The VM failed to boot. This is possibly caused by not having an operating system installed or a misconfigured boot order. Maybe picking a guest OS install DVD will resolve the situation";a:1:{s:11:"translation";s:223:"VM'en kunne ikke starte. Dette skyldes muligvis, at der ikke er installeret et operativsystem, eller at opstartsrækkefølgen er forkert konfigureret. Måske kan det løse problemet at vælge en gæste-OS-installations-dvd.";}s:62:"The machine settings were changed while you were editing them.";a:1:{s:11:"translation";s:59:"Maskinindstillingerne blev ændret, mens du redigerede dem.";}s:67:"This folder already exists and possibly belongs to another machine.";a:1:{s:11:"translation";s:67:"Denne mappe findes allerede og tilhører muligvis en anden maskine.";}s:118:"This operation is equivalent to resetting or powering off the machine without doing a proper shutdown of the guest OS.";a:1:{s:11:"translation";s:115:"Denne handling svarer til at nulstille eller slukke maskinen uden at udføre en korrekt nedlukning af gæste-OS'et.";}s:78:"This will cause any unsaved data in applications running inside it to be lost.";a:1:{s:11:"translation";s:86:"Dette vil medføre, at alle ikke-gemte data i programmer, der kører i den, går tabt.";}s:96:"Would you like to choose a virtual CD/DVD disk to put in the drive or to leave it empty for now?";a:1:{s:11:"translation";s:96:"Vil du vælge en virtuel cd/dvd-disk at sætte i drevet, eller vil du lade den være tom for nu?";}s:95:"Would you like to create a new, empty file to hold the disk contents or select an existing one?";a:1:{s:11:"translation";s:91:"Vil du oprette en ny, tom fil til at indeholde diskindholdet, eller vælge en eksisterende?";}s:94:"Would you like to delete the files containing the virtual machine from your hard disk as well?";a:1:{s:11:"translation";s:84:"Vil du også slette filerne, der indeholder den virtuelle maskine, fra din harddisk?";}s:74:"Would you like to reload the changed settings or to keep your own changes?";a:1:{s:11:"translation";s:88:"Vil du genindlæse de ændrede indstillinger, eller vil du beholde dine egne ændringer?";}s:3:"Yes";a:1:{s:11:"translation";s:2:"Ja";}s:64:"You are about to add a new CD/DVD drive to controller <b>%1</b>.";a:1:{s:11:"translation";s:68:"Du er ved at tilføje et nyt cd/dvd-drev til controlleren <b>%1</b>.";}s:65:"You are about to add a virtual hard disk to controller <b>%1</b>.";a:1:{s:11:"translation";s:69:"Du er ved at tilføje en virtuel harddisk til controlleren <b>%1</b>.";}s:262:"You are about to create a new virtual machine without a hard disk. You will not be able to install an operating system on the machine until you add one. In the mean time you will only be able to start the machine using a virtual optical disk or from the network.";a:1:{s:11:"translation";s:234:"Du er ved at oprette en ny virtuel maskine uden en harddisk. Du vil ikke kunne installere et styresystem på maskinen før du tilføjer en harddisk. Indtil da kan du kun starte maskinen med en virtuel optisk disk eller fra netværket.";}s:77:"You are about to remove the following virtual machines from the machine list:";a:1:{s:11:"translation";s:66:"Du er ved at fjerne følgende virtuelle maskiner fra maskinlisten:";}s:43:"You currently have unsaved setting changes.";a:1:{s:11:"translation";s:60:"Du har i øjeblikket ikke-gemte ændringer af indstillinger.";}}}s:16:"UIProgressDialog";a:1:{s:8:"messages";a:1:{s:6:"Cancel";a:1:{s:11:"translation";s:8:"Annuller";}}}s:17:"UISnapshotDetails";a:1:{s:8:"messages";a:39:{s:11:"%1 since %2";a:1:{s:11:"translation";s:11:"%1 siden %2";}s:10:"%n day ago";a:1:{s:11:"translation";s:16:"for %n dag siden";}s:11:"%n days ago";a:1:{s:11:"translation";s:17:"for %n dage siden";}s:11:"%n hour ago";a:1:{s:11:"translation";s:17:"for %n time siden";}s:12:"%n hours ago";a:1:{s:11:"translation";s:18:"for %n timer siden";}s:13:"%n minute ago";a:1:{s:11:"translation";s:18:"for %n minut siden";}s:14:"%n minutes ago";a:1:{s:11:"translation";s:21:"for %n minutter siden";}s:14:"%n seconds ago";a:1:{s:11:"translation";s:21:"for %n sekunder siden";}s:64:"Are you sure you want to delete the selected snapshot <b>%1</b>?";a:1:{s:11:"translation";s:65:"Er du sikker på, at du vil slette det valgte snapshot <b>%1</b>?";}s:65:"Are you sure you want to restore snapshot <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:72:"Er du sikker på, at du vil gendanne snapshottet <nobr><b>%1</b></nobr>?";}s:45:"Automatically start the machine after restore";a:1:{s:11:"translation";s:43:"Start maskinen automatisk efter gendannelse";}s:46:"Create a snapshot of the current machine state";a:1:{s:11:"translation";s:47:"Lav øjebliksbillede af den nuværende tilstand";}s:13:"Current State";a:1:{s:11:"translation";s:19:"Nuværende tilstand";}s:23:"Current State (changed)";a:1:{s:11:"translation";s:29:"Nuværende tilstand (ændret)";}s:15:"Delete Snapshot";a:1:{s:11:"translation";s:13:"Slet snapshot";}s:212:"Deleting the snapshot will cause the state information saved in it to be lost, and storage data spread over several image files that VirtualBox has created together with the snapshot will be merged into one file.";a:1:{s:11:"translation";s:211:"Sletning af snapshottet vil medføre tab af de gemte tilstandsoplysninger, og lagringsdata spredt over flere billedfiler, som VirtualBox har oprettet sammen med snapshottet, vil blive flettet sammen til én fil.";}s:12:"Description:";a:1:{s:11:"translation";s:12:"Beskrivelse:";}s:18:"Details of %1 (%2)";a:1:{s:11:"translation";s:19:"Detaljer om %1 (%2)";}s:8:"Details:";a:1:{s:11:"translation";s:9:"Detaljer:";}s:89:"If you do not do this the current state will be permanently lost. Do you wish to proceed?";a:1:{s:11:"translation";s:91:"Hvis du ikke gør dette, vil den nuværende tilstand gå permanent tabt. Vil du fortsætte?";}s:5:"Name:";a:1:{s:11:"translation";s:5:"Navn:";}s:24:"Power on virtual machine";a:1:{s:11:"translation";s:27:"Tænd den virtuelle maskine";}s:16:"Restore Snapshot";a:1:{s:11:"translation";s:15:"Gendan snapshot";}s:12:"Show Details";a:1:{s:11:"translation";s:12:"Vis detaljer";}s:11:"Snapshot %1";a:1:{s:11:"translation";s:19:"Øjebliksbillede %1";}s:20:"Snapshot Description";a:1:{s:11:"translation";s:31:"Beskrivelse af øjebliksbillede";}s:13:"Snapshot Name";a:1:{s:11:"translation";s:17:"Navn på snapshot";}s:32:"Take Snapshot of Virtual Machine";a:1:{s:11:"translation";s:39:"Tag øjebliksbillede af virtuel maskine";}s:52:"Take a snapshot of the current virtual machine state";a:1:{s:11:"translation";s:73:"Tag et øjebliksbillede af den aktuelle tilstand af den virtuelle maskine";}s:11:"Taken at %1";a:1:{s:11:"translation";s:12:"Taget ved %1";}s:11:"Taken on %1";a:1:{s:11:"translation";s:12:"Taget den %1";}s:6:"Taken:";a:1:{s:11:"translation";s:6:"Taget:";}s:71:"The current state differs from the state stored in the current snapshot";a:1:{s:11:"translation";s:83:"Den aktuelle tilstand afviger fra den tilstand, der er gemt i det aktuelle snapshot";}s:74:"The current state is identical to the state stored in the current snapshot";a:1:{s:11:"translation";s:87:"Den aktuelle tilstand er identisk med den tilstand, der er gemt i det aktuelle snapshot";}s:87:"This can be a lengthy process, and the information in the snapshot cannot be recovered.";a:1:{s:11:"translation";s:87:"Dette kan være en langvarig proces, og oplysningerne i snapshottet kan ikke gendannes.";}s:57:"You are about to restore snapshot <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:57:"Du er ved at gendanne snapshottet <nobr><b>%1</b></nobr>.";}s:102:"You can create a snapshot of the current state of the virtual machine first by checking the box below.";a:1:{s:11:"translation";s:117:"Du kan først oprette et øjebliksbillede af den virtuelle maskines aktuelle tilstand ved at markere feltet nedenfor.";}s:7:"offline";a:1:{s:11:"translation";s:7:"offline";}s:6:"online";a:1:{s:11:"translation";s:6:"online";}}}s:7:"UIUsers";a:1:{s:8:"messages";a:15:{s:8:"Add User";a:1:{s:11:"translation";s:14:"Tilføj bruger";}s:10:"Admin User";a:1:{s:11:"translation";s:12:"Admin-bruger";}s:20:"Can administer users";a:1:{s:11:"translation";s:24:"Kan administrere brugere";}s:15:"Change Password";a:1:{s:11:"translation";s:17:"Skift adgangskode";}s:9:"Edit User";a:1:{s:11:"translation";s:14:"Rediger bruger";}s:6:"Log in";a:1:{s:11:"translation";s:7:"Log ind";}s:12:"New Password";a:1:{s:11:"translation";s:14:"Ny adgangskode";}s:12:"Old Password";a:1:{s:11:"translation";s:18:"Gammel adgangskode";}s:8:"Password";a:1:{s:11:"translation";s:11:"Adgangskode";}s:11:"Remove User";a:1:{s:11:"translation";s:12:"Fjern bruger";}s:6:"Retype";a:1:{s:11:"translation";s:10:"Skriv igen";}s:41:"The password you have entered is invalid.";a:1:{s:11:"translation";s:38:"Den indtastede adgangskode er ugyldig.";}s:44:"The passwords you have entered do not match.";a:1:{s:11:"translation";s:48:"De indtastede adgangskoder stemmer ikke overens.";}s:8:"Username";a:1:{s:11:"translation";s:10:"Brugernavn";}s:5:"Users";a:1:{s:11:"translation";s:7:"Brugere";}}}s:11:"UIVMDesktop";a:1:{s:8:"messages";a:5:{s:7:"Console";a:1:{s:11:"translation";s:6:"Konsol";}s:7:"Details";a:1:{s:11:"translation";s:8:"Detaljer";}s:13:"Host Reources";a:1:{s:11:"translation";s:16:"Værtsressourcer";}s:11:"Loading ...";a:1:{s:11:"translation";s:13:"Indlæser ...";}s:9:"Snapshots";a:1:{s:11:"translation";s:17:"Øjebliksbilleder";}}}s:13:"UIVMLogViewer";a:1:{s:8:"messages";a:2:{s:26:"%1 - VirtualBox Log Viewer";a:1:{s:11:"translation";s:26:"%1 - VirtualBox Log Viewer";}s:100:"No log files found. Press the <b>Refresh</b> button to rescan the log folder <nobr><b>%1</b></nobr>.";a:1:{s:11:"translation";s:107:"Ingen logfiler fundet. Tryk på knappen <b>Opdater</b> for at scanne logmappen <nobr><b>%1</b></nobr> igen.";}}}s:17:"UIVMPreviewWindow";a:1:{s:8:"messages";a:1:{s:18:"Open in new window";a:1:{s:11:"translation";s:17:"Åbn i nyt vindue";}}}s:21:"UIVirtualMediaManager";a:1:{s:8:"messages";a:60:{s:7:"Actions";a:1:{s:11:"translation";s:10:"Handlinger";}s:11:"Actual Size";a:1:{s:11:"translation";s:15:"Reel størrelse";}s:3:"Add";a:1:{s:11:"translation";s:8:"Tilføje";}s:9:"Add iSCSI";a:1:{s:11:"translation";s:13:"Tilføj iSCSI";}s:53:"Are you sure you want to release the disk image file:";a:1:{s:11:"translation";s:49:"Er du sikker på, at du vil frigive diskbilledet:";}s:91:"Are you sure you want to remove the %1 <nobr><b>%2</b></nobr> from the list of known media?";a:1:{s:11:"translation";s:91:"Er du sikker på, at du vil fjerne %1 <nobr><b>%2</b></nobr> fra listen over kendte medier?";}s:12:"Attached to:";a:1:{s:11:"translation";s:15:"Vedhæftet til:";}s:19:"Choose medium type:";a:1:{s:11:"translation";s:17:"Vælg mellemtype:";}s:7:"Copy...";a:1:{s:11:"translation";s:7:"Kopi...";}s:12:"Description:";a:1:{s:11:"translation";s:12:"Beskrivelse:";}s:87:"Do you want to delete the storage unit of the virtual hard disk <nobr><b>%1</b></nobr>?";a:1:{s:11:"translation";s:77:"Vil du slette lagerenheden på den virtuelle harddisk <nobr><b>%1</b></nobr>?";}s:7:"Encoded";a:1:{s:11:"translation";s:5:"Kodet";}s:12:"Floppy disks";a:1:{s:11:"translation";s:9:"Disketter";}s:7:"Format:";a:1:{s:11:"translation";s:7:"Format:";}s:10:"Hard disks";a:1:{s:11:"translation";s:9:"Harddiske";}s:79:"Hard drive has children, <b>Writethrough</b> and <b>Shareable</b> not available";a:1:{s:11:"translation";s:99:"Harddisken har underordnede diske, <b>Gennemskrivning</b> og <b>Kan deles</b> er ikke tilgængelige";}s:86:"Hard drive is attached to a VM, <b>Immutable</b> and <b>Multi-attach</b> not available";a:1:{s:11:"translation";s:102:"Harddisken er tilsluttet en VM, <b>Uforanderlig</b> og <b>Multi-vedhæftning</b> er ikke tilgængelige";}s:53:"Hard drive is dynamic, <b>Shareable</b> not available";a:1:{s:11:"translation";s:56:"Harddisken er dynamisk, <b>Delelig</b> ikke tilgængelig";}s:128:"If you select <b>Delete</b> then the specified storage unit will be permanently deleted. This operation <b>cannot be undone</b>.";a:1:{s:11:"translation";s:112:"Hvis du vælger <b>Slet</b>, slettes den angivne lagerenhed permanent. Denne handling <b>kan ikke fortrydes</b>.";}s:215:"If you select <b>Keep</b> then the hard disk will be only removed from the list of known hard disks, but the storage unit will be left untouched which makes it possible to add this hard disk to the list later again.";a:1:{s:11:"translation";s:195:"Hvis du vælger <b>Behold</b>, fjernes harddisken kun fra listen over kendte harddiske, men lagerenheden forbliver uændret, hvilket gør det muligt at tilføje harddisken til listen senere igen.";}s:9:"Immutable";a:1:{s:11:"translation";s:12:"Uforanderlig";}s:19:"Internal Networking";a:1:{s:11:"translation";s:16:"Internt netværk";}s:3:"LUN";a:1:{s:11:"translation";s:3:"LUN";}s:9:"Location:";a:1:{s:11:"translation";s:12:"Beliggenhed:";}s:18:"Medium attributes:";a:1:{s:11:"translation";s:18:"Mediumattributter:";}s:102:"Medium is attached to a VM that is in state "Running", "Paused", or "Saved". Unable to release medium.";a:1:{s:11:"translation";s:107:"Mediet er knyttet til en VM, der er i tilstanden "Kører", "Pauset" eller "Gemt". Mediet kan ikke frigives.";}s:24:"Modify medium attributes";a:1:{s:11:"translation";s:24:"Rediger medieattributter";}s:9:"Modify...";a:1:{s:11:"translation";s:13:"Modificere...";}s:12:"Multi-Attach";a:1:{s:11:"translation";s:18:"Multi-vedhæftning";}s:11:"MultiAttach";a:1:{s:11:"translation";s:11:"Multiattach";}s:4:"Name";a:1:{s:11:"translation";s:4:"Navn";}s:3:"New";a:1:{s:11:"translation";s:2:"Ny";}s:6:"Normal";a:1:{s:11:"translation";s:6:"Normal";}s:113:"Note that the storage unit of this medium will not be deleted and that it will be possible to use it later again.";a:1:{s:11:"translation";s:119:"Bemærk at lagringsenheden på dette medie ikke vil blive slettet, og at det vil være muligt at bruge den senere igen.";}s:13:"Optical disks";a:1:{s:11:"translation";s:13:"Optiske diske";}s:8:"Password";a:1:{s:11:"translation";s:11:"Adgangskode";}s:95:"Please choose one of the following modes and press <b>%2</b> to proceed or <b>%3</b> otherwise.";a:1:{s:11:"translation";s:112:"Vælg venligst en af ​​følgende tilstande, og tryk på <b>%2</b> for at fortsætte, eller <b>%3</b> ellers.";}s:4:"Port";a:1:{s:11:"translation";s:4:"Havn";}s:8:"Readonly";a:1:{s:11:"translation";s:15:"Skrivebeskyttet";}s:7:"Refresh";a:1:{s:11:"translation";s:8:"Opfriske";}s:7:"Release";a:1:{s:11:"translation";s:8:"Frigøre";}s:6:"Remove";a:1:{s:11:"translation";s:5:"Fjern";}s:12:"Rename File:";a:1:{s:11:"translation";s:11:"Omdøb fil:";}s:6:"Select";a:1:{s:11:"translation";s:6:"Vælge";}s:6:"Server";a:1:{s:11:"translation";s:6:"Server";}s:9:"Shareable";a:1:{s:11:"translation";s:9:"Kan deles";}s:4:"Size";a:1:{s:11:"translation";s:10:"Størrelse";}s:16:"Storage details:";a:1:{s:11:"translation";s:20:"Opbevaringsdetaljer:";}s:6:"Target";a:1:{s:11:"translation";s:4:"Mål";}s:69:"This will detach it from the following virtual machine(s): <b>%2</b>.";a:1:{s:11:"translation";s:68:"Dette vil afbryde den fra følgende virtuelle maskine(r): <b>%2</b>.";}s:5:"Type:";a:1:{s:11:"translation";s:5:"Type:";}s:5:"UUID:";a:1:{s:11:"translation";s:5:"UUID:";}s:8:"Username";a:1:{s:11:"translation";s:10:"Brugernavn";}s:64:"VM hard drive is attached to is running, cannot modify disk type";a:1:{s:11:"translation";s:62:"VM-harddisken er tilsluttet kører, disktypen kan ikke ændres";}s:21:"Virtual Media Manager";a:1:{s:11:"translation";s:29:"Håndtering af virtuelt medie";}s:12:"Virtual Size";a:1:{s:11:"translation";s:18:"Virtuel størrelse";}s:7:"Warning";a:1:{s:11:"translation";s:8:"Advarsel";}s:8:"Warnings";a:1:{s:11:"translation";s:9:"Advarsler";}s:12:"Writethrough";a:1:{s:11:"translation";s:15:"Gennemskrivning";}s:70:"You are about to change the settings of the disk image file <b>%1</b>.";a:1:{s:11:"translation";s:66:"Du er ved at ændre indstillingerne for diskbilledfilen <b>%1</b>.";}}}s:8:"UIWizard";a:1:{s:8:"messages";a:2:{s:11:"Expert Mode";a:1:{s:11:"translation";s:15:"Eksperttilstand";}s:11:"Guided Mode";a:1:{s:11:"translation";s:15:"Guidet tilstand";}}}s:15:"UIWizardCloneVM";a:1:{s:8:"messages";a:31:{s:8:"%1 Clone";a:1:{s:11:"translation";s:7:"%1 Klon";}s:5:"Clone";a:1:{s:11:"translation";s:4:"Klon";}s:13:"Clone Options";a:1:{s:11:"translation";s:17:"Klonindstillinger";}s:21:"Clone Virtual Machine";a:1:{s:11:"translation";s:20:"Klon virtual maskine";}s:10:"Clone type";a:1:{s:11:"translation";s:12:"Kloningstype";}s:20:"Cloned Machine Name:";a:1:{s:11:"translation";s:24:"Navn på klonet maskine:";}s:21:"Current machine state";a:1:{s:11:"translation";s:21:"Aktuel maskintilstand";}s:28:"Current snapshot tree branch";a:1:{s:11:"translation";s:25:"Aktuelt snapshot-trægren";}s:10:"Everything";a:1:{s:11:"translation";s:3:"Alt";}s:10:"Full Clone";a:1:{s:11:"translation";s:9:"Fuld klon";}s:51:"Generate new MAC addresses for all network adapters";a:1:{s:11:"translation";s:47:"Generer nye MAC-adresser til alle netværkskort";}s:142:"If you choose <b>Current machine state</b>, the new machine will reflect the current state of the original machine and will have no snapshots.";a:1:{s:11:"translation";s:151:"Hvis du vælger <b>Aktuel maskintilstand</b>, vil den nye maskine afspejle den oprindelige maskines aktuelle tilstand og vil ikke have nogen snapshots.";}s:246:"If you choose <b>Current snapshot tree branch</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the tree branch starting at the current state in the original machine.";a:1:{s:11:"translation";s:238:"Hvis du vælger <b>Aktuel snapshot-trægren</b>, vil den nye maskine afspejle den oprindelige maskines aktuelle tilstand og have matchende snapshots for alle snapshots i trægrenen startende fra den oprindelige maskines aktuelle tilstand.";}s:179:"If you choose <b>Everything</b>, the new machine will reflect the current state of the original machine and will have matching snapshots for all snapshots in the original machine.";a:1:{s:11:"translation";s:173:"Hvis du vælger <b>Alt</b>, vil den nye maskine afspejle den oprindelige maskines aktuelle tilstand og have matchende snapshots for alle snapshots i den oprindelige maskine.";}s:135:"If you choose <b>Full clone</b>, an exact copy (including all virtual hard disk files) of the original virtual machine will be created.";a:1:{s:11:"translation";s:141:"Hvis du vælger <b>Fuld klon</b>, oprettes der en nøjagtig kopi (inklusive alle virtuelle harddiskfiler) af den originale virtuelle maskine.";}s:279:"If you choose <b>Linked clone</b>, a new machine will be created, but the virtual hard disk files will be tied to the virtual hard disk files of original machine and you will not be able to move the new virtual machine to a different computer without moving the original as well.";a:1:{s:11:"translation";s:294:"Hvis du vælger <b>Forbundet klon</b>, oprettes en ny maskine, men filerne på den virtuelle harddisk vil være knyttet til filerne på den oprindelige maskines virtuelle harddisk, og du vil ikke kunne flytte den nye virtuelle maskine til en anden computer uden også at flytte den oprindelige.";}s:136:"If you create a <b>Linked clone</b>, then a new snapshot will be created in the original virtual machine as part of the cloning process.";a:1:{s:11:"translation";s:137:"Hvis du opretter en <b>Linked klon</b>, oprettes der et nyt snapshot i den oprindelige virtuelle maskine som en del af kloningsprocessen.";}s:41:"Include all network adapter MAC addresses";a:1:{s:11:"translation";s:44:"Inkluder alle MAC-adresser på netværkskort";}s:46:"Include only NAT network adapter MAC addresses";a:1:{s:11:"translation";s:47:"Inkluder kun MAC-adresser for NAT-netværkskort";}s:15:"Keep Disk Names";a:1:{s:11:"translation";s:16:"Behold disknavne";}s:19:"Keep Hardware UUIDs";a:1:{s:11:"translation";s:23:"Behold hardware-UUID'er";}s:25:"Linked Base for %1 and %2";a:1:{s:11:"translation";s:27:"Forbundet base for %1 og %2";}s:12:"Linked Clone";a:1:{s:11:"translation";s:15:"Tilknyttet klon";}s:19:"MAC Address Policy:";a:1:{s:11:"translation";s:19:"MAC-adressepolitik:";}s:16:"New machine name";a:1:{s:11:"translation";s:14:"Nyt maskinnavn";}s:49:"Please choose a name for the new virtual machine.";a:1:{s:11:"translation";s:53:"Vælg venligst et navn til den nye virtuelle maskine.";}s:51:"Please choose the type of clone you wish to create.";a:1:{s:11:"translation";s:52:"Vælg venligst den type klon, du ønsker at oprette.";}s:81:"Please choose which parts of the snapshot tree should be cloned with the machine.";a:1:{s:11:"translation";s:76:"Vælg venligst hvilke dele af snapshot-træet, der skal klones med maskinen.";}s:9:"Snapshots";a:1:{s:11:"translation";s:17:"Øjebliksbilleder";}s:57:"The new machine will be a clone of the machine <b>%1</b>.";a:1:{s:11:"translation";s:56:"Den nye maskine vil være en klon af maskinen <b>%1</b>.";}s:9:"undefined";a:1:{s:11:"translation";s:10:"udefineret";}}}s:14:"UIWizardCopyVD";a:1:{s:8:"messages";a:19:{s:7:"%1_copy";a:1:{s:11:"translation";s:7:"%1_kopi";}s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:216:"En **dynamisk allokeret** harddiskfil bruger kun plads på din fysiske harddisk, når den fyldes op (op til en maksimal **fast størrelse**), selvom den ikke automatisk krymper igen, når der frigøres plads på den.";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:126:"En harddiskfil med <b>fast størrelse</b> kan tage længere tid at oprette på nogle systemer, men er ofte hurtigere at bruge.";}s:42:"Choose a virtual hard disk file to copy...";a:1:{s:11:"translation";s:50:"Vælg en virtuel harddiskfil, der skal kopieres...";}s:43:"Choose a virtual hard drive file to copy...";a:1:{s:11:"translation";s:50:"Vælg en virtuel harddiskfil, der skal kopieres...";}s:4:"Copy";a:1:{s:11:"translation";s:7:"Kopiér";}s:22:"Copy Virtual Hard Disk";a:1:{s:11:"translation";s:24:"Kopiér virtuel harddisk";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:18:"Dynamisk allokeret";}s:10:"Fixed size";a:1:{s:11:"translation";s:15:"Fast størrelse";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:15:"Harddiskfiltype";}s:17:"Hard disk to copy";a:1:{s:11:"translation";s:22:"Harddisk til kopiering";}s:23:"New hard disk to create";a:1:{s:11:"translation";s:22:"Ny harddisk at oprette";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:167:"Vælg typen af fil, som du vil bruge til den nye virtuelle disk. Skal disken ikke bruges med andre virtualiseringsprogrammer behøver du ikke ændre denne indstilling.";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:155:"Vælg om den nye virtuelle disk-fil allokeres i takt med at den bruges (dynamisk allokering) eller om al pladsen allokeres med det samme (fast størrelse).";}s:193:"Please select the virtual hard disk file that you would like to copy if it is not already selected. You can either choose one from the list or use the folder icon beside the list to select one.";a:1:{s:11:"translation";s:192:"Vælg venligst den virtuelle harddiskfil, du vil kopiere, hvis den ikke allerede er valgt. Du kan enten vælge en fra listen eller bruge mappeikonet ved siden af ​​listen til at vælge en.";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:143:"Indtast navnet på den nye virtuelle harddiskfil i feltet nedenfor, eller klik på mappeikonet for at vælge en anden mappe at oprette filen i.";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:33:"Opdel i filer på mindre end 2 GB";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:27:"Lagring på fysisk harddisk";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:264:"Du kan også vælge at <b>opdele</b> harddiskfilen i flere filer på op til to gigabyte hver. Dette er især nyttigt, hvis du ønsker at gemme den virtuelle maskine på flytbare USB-enheder eller gamle systemer, hvoraf nogle ikke kan håndtere særlig store filer.";}}}s:17:"UIWizardExportApp";a:1:{s:8:"messages";a:28:{s:25:"Appliance Export Settings";a:1:{s:11:"translation";s:36:"Indstillinger for eksport af apparat";}s:18:"Appliance settings";a:1:{s:11:"translation";s:35:"Indstillinger for prækonfiguration";}s:11:"Description";a:1:{s:11:"translation";s:11:"Beskrivelse";}s:6:"Export";a:1:{s:11:"translation";s:10:"Eksportere";}s:24:"Export Virtual Appliance";a:1:{s:11:"translation";s:36:"Eksportér virtuel prækonfiguration";}s:5:"File:";a:1:{s:11:"translation";s:4:"Fil:";}s:7:"Format:";a:1:{s:11:"translation";s:7:"Format:";}s:116:"If you use an <b>ova</b> extension, then all the files will be combined into one Open Virtualization Format Archive.";a:1:{s:11:"translation";s:100:"Hvis du bruger filtypen *ova*, vil alle filerne blive samlet i ét Open Virtualization Format-arkiv.";}s:77:"If you use an <b>ovf</b> extension, several files will be written separately.";a:1:{s:11:"translation";s:76:"Hvis du bruger filtypen `<b>ovf</b>`, vil flere filer blive skrevet separat.";}s:7:"License";a:1:{s:11:"translation";s:6:"Licens";}s:4:"Name";a:1:{s:11:"translation";s:4:"Navn";}s:7:"OVF 0.9";a:1:{s:11:"translation";s:7:"OVF 0,9";}s:7:"OVF 1.0";a:1:{s:11:"translation";s:7:"OVF 1.0";}s:7:"OVF 2.0";a:1:{s:11:"translation";s:7:"OVF 2.0";}s:33:"Other extensions are not allowed.";a:1:{s:11:"translation";s:33:"Andre udvidelser er ikke tilladt.";}s:50:"Please choose a filename to export the OVF/OVA to.";a:1:{s:11:"translation";s:52:"Vælg venligst et filnavn at eksportere OVF/OVA til.";}s:186:"Please select the virtual machines that should be added to the appliance. You can select more than one. Please note that these machines have to be turned off before they can be exported.";a:1:{s:11:"translation";s:169:"Vælg venligst de virtuelle maskiner, der skal føjes til enheden. Du kan vælge mere end én. Bemærk venligst, at disse maskiner skal slukkes, før de kan eksporteres.";}s:7:"Product";a:1:{s:11:"translation";s:7:"Produkt";}s:11:"Product-URL";a:1:{s:11:"translation";s:11:"Produkt-URL";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:28:"Gendan standardindstillinger";}s:33:"Select a directory to export into";a:1:{s:11:"translation";s:32:"Vælg en mappe at eksportere til";}s:140:"This is the descriptive information which will be added to the virtual appliance.  You can change it by double clicking on individual lines.";a:1:{s:11:"translation";s:119:"Disse beskrivelser vil blive tilføjet den virtuelle prækonfiguration. Du kan ændre dem ved at dobbeltklikke på dem.";}s:6:"Vendor";a:1:{s:11:"translation";s:11:"Leverandør";}s:10:"Vendor-URL";a:1:{s:11:"translation";s:15:"Leverandør-URL";}s:7:"Version";a:1:{s:11:"translation";s:7:"Version";}s:26:"Virtual machines to export";a:1:{s:11:"translation";s:30:"Virtuelle maskiner til eksport";}s:19:"Write Manifest file";a:1:{s:11:"translation";s:17:"Skriv manifestfil";}s:9:"undefined";a:1:{s:11:"translation";s:10:"udefineret";}}}s:16:"UIWizardFirstRun";a:1:{s:8:"messages";a:6:{s:37:"Choose a virtual optical disk file...";a:1:{s:11:"translation";s:34:"Vælg en virtuel optisk diskfil...";}s:127:"Please select a virtual optical disk file or a physical optical drive containing a disk to start your new virtual machine from.";a:1:{s:11:"translation";s:138:"Vælg venligst en virtuel optisk diskfil eller et fysisk optisk drev, der indeholder en disk, for at starte din nye virtuelle maskine fra.";}s:20:"Select start-up disk";a:1:{s:11:"translation";s:18:"Vælg opstartsdisk";}s:5:"Start";a:1:{s:11:"translation";s:6:"Starte";}s:343:"The disk should be suitable for starting a computer from and should contain the operating system you wish to install on the virtual machine if you want to do that now. The disk will be ejected from the virtual drive automatically next time you switch the virtual machine off, but you can also do this yourself if needed using the Devices menu.";a:1:{s:11:"translation";s:366:"Disken skal være egnet til at starte en computer fra og skal indeholde det operativsystem, du ønsker at installere på den virtuelle maskine, hvis du vil gøre det nu. Disken vil automatisk blive skubbet ud af det virtuelle drev næste gang du slukker den virtuelle maskine, men du kan også gøre dette selv, hvis det er nødvendigt, ved hjælp af menuen Enheder.";}s:172:"The disk should be suitable for starting a computer from. As this virtual machine has no hard drive you will not be able to install an operating system on it at the moment.";a:1:{s:11:"translation";s:173:"Disken skal være egnet til at starte en computer fra. Da denne virtuelle maskine ikke har en harddisk, vil du ikke kunne installere et operativsystem på den i øjeblikket.";}}}s:17:"UIWizardImportApp";a:1:{s:8:"messages";a:28:{s:18:"Appliance settings";a:1:{s:11:"translation";s:35:"Indstillinger for prækonfiguration";}s:19:"Appliance to import";a:1:{s:11:"translation";s:37:"Prækonfiguration som skal importeres";}s:3:"CPU";a:1:{s:11:"translation";s:3:"CPU";}s:44:"Choose a virtual appliance file to import...";a:1:{s:11:"translation";s:61:"Vælg en virtuel prækonfigurationsfil som skal importeres...";}s:3:"DVD";a:1:{s:11:"translation";s:3:"DVD";}s:6:"Floppy";a:1:{s:11:"translation";s:12:"Diskettedrev";}s:13:"Guest OS Type";a:1:{s:11:"translation";s:16:"Gæstens OS-type";}s:6:"Import";a:1:{s:11:"translation";s:9:"Importere";}s:24:"Import Virtual Appliance";a:1:{s:11:"translation";s:35:"Importér virtuel prækonfiguration";}s:4:"Name";a:1:{s:11:"translation";s:4:"Navn";}s:15:"Network Adapter";a:1:{s:11:"translation";s:13:"Netværkskort";}s:3:"RAM";a:1:{s:11:"translation";s:3:"RAM";}s:49:"Reinitialize the MAC address of all network cards";a:1:{s:11:"translation";s:50:"Geninitialiser MAC-adressen på alle netværkskort";}s:16:"Restore Defaults";a:1:{s:11:"translation";s:28:"Gendan standardindstillinger";}s:29:"Select an appliance to import";a:1:{s:11:"translation";s:35:"Vælg en enhed, der skal importeres";}s:10:"Sound Card";a:1:{s:11:"translation";s:7:"Lydkort";}s:24:"Storage Controller (IDE)";a:1:{s:11:"translation";s:21:"Lagerstyreenhed (IDE)";}s:25:"Storage Controller (PCIe)";a:1:{s:11:"translation";s:25:"Lagringscontroller (PCIe)";}s:24:"Storage Controller (SAS)";a:1:{s:11:"translation";s:21:"Lagerstyreenhed (SAS)";}s:25:"Storage Controller (SATA)";a:1:{s:11:"translation";s:22:"Lagerstyreenhed (SATA)";}s:25:"Storage Controller (SCSI)";a:1:{s:11:"translation";s:22:"Lagerstyreenhed (SCSI)";}s:31:"Storage Controller (VirtioSCSI)";a:1:{s:11:"translation";s:32:"Lagringscontroller (Virtio SCSI)";}s:245:"These are the virtual machines contained in the appliance and the suggested settings of the imported VirtualBox machines. You can change many of the properties shown by double-clicking on the items and disable others using the check boxes below.";a:1:{s:11:"translation";s:253:"Disse virtuelle maskiner og deres konfiguration er en del af prækonfigurationen og kan importeres til VirtualBox. Du kan ændre de fleste af de viste egenskaber ved at dobbeltklikke på værdierne og deaktivere andre ved hjælp af afkrydsningsfelterne.";}s:14:"USB Controller";a:1:{s:11:"translation";s:14:"USB-styreenhed";}s:18:"Virtual Disk Image";a:1:{s:11:"translation";s:19:"Virtuelt diskaftryk";}s:17:"Virtual System %1";a:1:{s:11:"translation";s:18:"Virtuelt system %1";}s:143:"VirtualBox currently supports importing appliances saved in the Open Virtualization Format (OVF). To continue, select the file to import below.";a:1:{s:11:"translation";s:172:"VirtualBox understøtter i øjeblikket import af apparater gemt i Open Virtualization Format (OVF). For at fortsætte skal du vælge den fil, der skal importeres, nedenfor.";}s:9:"Warnings:";a:1:{s:11:"translation";s:10:"Advarsler:";}}}s:13:"UIWizardNewVD";a:1:{s:8:"messages";a:27:{s:219:"A <b>dynamically allocated</b> hard disk file will only use space on your physical hard disk as it fills up (up to a maximum <b>fixed size</b>), although it will not shrink again automatically when space on it is freed.";a:1:{s:11:"translation";s:216:"En **dynamisk allokeret** harddiskfil bruger kun plads på din fysiske harddisk, når den fyldes op (op til en maksimal **fast størrelse**), selvom den ikke automatisk krymper igen, når der frigøres plads på den.";}s:104:"A <b>fixed size</b> hard disk file may take longer to create on some systems but is often faster to use.";a:1:{s:11:"translation";s:126:"En harddiskfil med <b>fast størrelse</b> kan tage længere tid at oprette på nogle systemer, men er ofte hurtigere at bruge.";}s:51:"Choose a location for new virtual hard disk file...";a:1:{s:11:"translation";s:54:"Vælg en placering til den nye virtuell harddiskfil...";}s:52:"Choose a location for new virtual hard drive file...";a:1:{s:11:"translation";s:54:"Vælg en placering til den nye virtuell harddiskfil...";}s:6:"Create";a:1:{s:11:"translation";s:5:"Skabe";}s:24:"Create Virtual Hard Disk";a:1:{s:11:"translation";s:22:"Opret virtuel harddisk";}s:21:"Dynamically allocated";a:1:{s:11:"translation";s:18:"Dynamisk allokeret";}s:13:"File location";a:1:{s:11:"translation";s:12:"Filplacering";}s:22:"File location and size";a:1:{s:11:"translation";s:26:"Filplacering og størrelse";}s:9:"File size";a:1:{s:11:"translation";s:13:"Filstørrelse";}s:10:"Fixed size";a:1:{s:11:"translation";s:15:"Fast størrelse";}s:25:"HDD (Parallels Hard Disk)";a:1:{s:11:"translation";s:23:"HDD (parallel harddisk)";}s:19:"Hard disk file type";a:1:{s:11:"translation";s:15:"Harddiskfiltype";}s:8:"Location";a:1:{s:11:"translation";s:11:"Beliggenhed";}s:190:"Please choose the type of file that you would like to use for the new virtual hard disk. If you do not need to use it with other virtualization software you can leave this setting unchanged.";a:1:{s:11:"translation";s:167:"Vælg typen af fil, som du vil bruge til den nye virtuelle disk. Skal disken ikke bruges med andre virtualiseringsprogrammer behøver du ikke ændre denne indstilling.";}s:163:"Please choose whether the new virtual hard disk file should grow as it is used (dynamically allocated) or if it should be created at its maximum size (fixed size).";a:1:{s:11:"translation";s:155:"Vælg om den nye virtuelle disk-fil allokeres i takt med at den bruges (dynamisk allokering) eller om al pladsen allokeres med det samme (fast størrelse).";}s:153:"Please type the name of the new virtual hard disk file into the box below or click on the folder icon to select a different folder to create the file in.";a:1:{s:11:"translation";s:143:"Indtast navnet på den nye virtuelle harddiskfil i feltet nedenfor, eller klik på mappeikonet for at vælge en anden mappe at oprette filen i.";}s:25:"QCOW (QEMU Copy-On-Write)";a:1:{s:11:"translation";s:25:"QCOW (QEMU Copy-On-Write)";}s:24:"QED (QEMU enhanced disk)";a:1:{s:11:"translation";s:25:"QED (QEMU-forbedret disk)";}s:167:"Select the size of the virtual hard disk in megabytes. This size is the limit on the amount of file data that a virtual machine will be able to store on the hard disk.";a:1:{s:11:"translation";s:165:"Vælg størrelsen på den virtuelle harddisk i megabyte. Denne størrelse er grænsen for mængden af ​​fildata, som en virtuel maskine kan gemme på harddisken.";}s:33:"Split into files of less than 2GB";a:1:{s:11:"translation";s:33:"Opdel i filer på mindre end 2 GB";}s:29:"Storage on physical hard disk";a:1:{s:11:"translation";s:27:"Lagring på fysisk harddisk";}s:27:"VDI (VirtualBox Disk Image)";a:1:{s:11:"translation";s:28:"VDI (VirtualBox-diskbillede)";}s:23:"VHD (Virtual Hard Disk)";a:1:{s:11:"translation";s:22:"VHD (virtuel harddisk)";}s:27:"VMDK (Virtual Machine Disk)";a:1:{s:11:"translation";s:25:"VMDK (Virtuel Maskindisk)";}s:252:"You can also choose to <b>split</b> the hard disk file into several files of up to two gigabytes each. This is mainly useful if you wish to store the virtual machine on removable USB devices or old systems, some of which cannot handle very large files.";a:1:{s:11:"translation";s:264:"Du kan også vælge at <b>opdele</b> harddiskfilen i flere filer på op til to gigabyte hver. Dette er især nyttigt, hvis du ønsker at gemme den virtuelle maskine på flytbare USB-enheder eller gamle systemer, hvoraf nogle ikke kan håndtere særlig store filer.";}s:9:"undefined";a:1:{s:11:"translation";s:10:"udefineret";}}}s:13:"UIWizardNewVM";a:1:{s:8:"messages";a:18:{s:6:"Create";a:1:{s:11:"translation";s:5:"Skabe";}s:22:"Create Virtual Machine";a:1:{s:11:"translation";s:21:"Opret virtuel maskine";}s:30:"Create a virtual hard disk now";a:1:{s:11:"translation";s:28:"Opret en virtuel harddisk nu";}s:30:"Do not add a virtual hard disk";a:1:{s:11:"translation";s:32:"Tilføj ikke en virtuel harddisk";}s:9:"Hard disk";a:1:{s:11:"translation";s:8:"Harddisk";}s:138:"If you need a more complex storage set-up you can skip this step and make the changes to the machine settings once the machine is created.";a:1:{s:11:"translation";s:165:"Hvis du har brug for en mere kompleks lagringsopsætning, kan du springe dette trin over og foretage ændringerne i maskinindstillingerne, når maskinen er oprettet.";}s:63:"If you wish you can add a virtual hard disk to the new machine.";a:1:{s:11:"translation";s:77:"Hvis du ønsker det, kan du tilføje en virtuel harddisk til den nye maskine.";}s:11:"Memory size";a:1:{s:11:"translation";s:21:"Hukommelsesstørrelse";}s:25:"Name and operating system";a:1:{s:11:"translation";s:22:"Navn og operativsystem";}s:5:"Name:";a:1:{s:11:"translation";s:5:"Navn:";}s:210:"Please choose a descriptive name for the new virtual machine and select the type of operating system you intend to install on it. The name you choose will be used throughout VirtualBox to identify this machine.";a:1:{s:11:"translation";s:202:"Vælg et beskrivende navn til den nye virtuelle maskine, og vælg den type operativsystem, du vil installere på den. Det valgte navn vil blive brugt i hele VirtualBox til at identificere denne maskine.";}s:86:"Select the amount of memory (RAM) in megabytes to be allocated to the virtual machine.";a:1:{s:11:"translation";s:98:"Vælg mængden af ​​hukommelse (RAM) i megabyte, der skal allokeres til den virtuelle maskine.";}s:44:"The recommended memory size is <b>%1 MB</b>.";a:1:{s:11:"translation";s:53:"Den anbefalede hukommelsesstørrelse er <b>%1 MB</b>.";}s:51:"The recommended size of the hard disk is <b>%1</b>.";a:1:{s:11:"translation";s:54:"Den anbefalede størrelse på harddisken er <b>%1</b>.";}s:5:"Type:";a:1:{s:11:"translation";s:5:"Type:";}s:38:"Use an existing virtual hard disk file";a:1:{s:11:"translation";s:40:"Brug en eksisterende virtuel harddiskfil";}s:8:"Version:";a:1:{s:11:"translation";s:8:"Version:";}s:118:"You can either create a new hard disk file or select one from the list or from another location using the folder icon.";a:1:{s:11:"translation";s:121:"Du kan enten oprette en ny harddiskfil eller vælge en fra listen eller fra en anden placering ved hjælp af mappeikonet.";}}}}}